---
import '@fontsource/league-spartan/400.css';
import '@fontsource/league-spartan/500.css';
import '@fontsource/league-spartan/700.css';
import '@fontsource/montserrat/400.css';
import '@fontsource/montserrat/500.css';
import '@fontsource/montserrat/600.css';
import '../styles/global.scss';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileNav from '../components/MobileNav.astro';
import { getImage } from 'astro:assets';
import ogPhoto from '../assets/gallery/locaux/deco-j-co-15.webp';
import heroMain from '../assets/gallery/cuisine/cuisine-avec-ziaad-29.webp';

interface Props {
	title: string;
	description?: string;
	preloadHeroImage?: boolean;
}

const { title, description = "Jeunesse & Co - L'accompagnement éducatif sur mesure", preloadHeroImage = false } = Astro.props;

// Précharge exactement la variante LCP générée dans Hero.astro.
const heroImage = preloadHeroImage ? await getImage({ src: heroMain, width: 620, height: 780, format: 'webp' }) : null;
const base = import.meta.env.BASE_URL;

// OpenGraph absolu par environnement (prod / preview) via Astro.site
const ogImage = await getImage({ src: ogPhoto, width: 1200, format: 'webp' });
const ogImageUrl = new URL(ogImage.src, Astro.site);
const ogUrl = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" href={`${base}assets/Favicon-32.png`} />
		<meta name="generator" content={Astro.generator} />
		{heroImage && <link rel="preload" as="image" href={heroImage.src} type="image/webp" fetchpriority="high" />}
		<title>{title}</title>
		
		<!-- OpenGraph / Telegram Preview -->
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:url" content={ogUrl} />
		<meta property="og:type" content="website" />
		<meta name="twitter:card" content="summary_large_image" />
	</head>
	<body>
		<Header />
		<MobileNav />
		<main>
			<slot />
		</main>
		<Footer />
		
		<script>
			// Defer scroll-triggered animations until after page load
			const initRevealAnimations = () => {
				import("gsap").then(({ gsap }) => {
					import("gsap/ScrollTrigger").then(({ ScrollTrigger }) => {
						gsap.registerPlugin(ScrollTrigger);
						
						// Force refresh for Safari compatibility
						ScrollTrigger.config({ ignoreMobileResize: true });
						
						gsap.set('.reveal', { opacity: 0, y: 30 });
						
						const reveals = document.querySelectorAll('.reveal');
						reveals.forEach((el) => {
							gsap.to(el, {
								scrollTrigger: {
									trigger: el,
									start: "top 90%",
									toggleActions: "play none none none"
								},
								y: 0,
								opacity: 1,
								duration: 1,
								ease: "power3.out",
								overwrite: true
							});
						});
						
						// Refresh ScrollTrigger after setup for Safari
						ScrollTrigger.refresh();
					});
				});
			};

			// Safari-compatible idle callback
			const scheduleInit = (callback) => {
				if ('requestIdleCallback' in window) {
					window.requestIdleCallback(callback);
				} else {
					setTimeout(callback, 1);
				}
			};

			if (document.readyState === 'complete') {
				scheduleInit(initRevealAnimations);
			} else {
				window.addEventListener('load', () => {
					scheduleInit(initRevealAnimations);
				});
			}
		</script>
	</body>
</html>
