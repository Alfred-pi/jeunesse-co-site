---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
const base = import.meta.env.BASE_URL;

const WEB3FORMS_KEY = "1cf130da-891f-440f-a9f5-b6798f537674";
---

<Layout title="Inscription Programme Impulsion | Jeunesse & Co">
  <section class="inscription">
    <div class="container">
      <div class="inscription__grid">
        <!-- Left side - Info -->
        <div class="inscription__info reveal">
          <a href={base} class="back-link">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M19 12H5M12 19l-7-7 7-7"/>
            </svg>
            Retour
          </a>
          
          <div class="info-content">
            <div class="label">Programme Impulsion</div>
            <h1>Rejoignez-nous<span class="accent">.</span></h1>
            <p class="description">
              Inscrivez-vous au Programme Impulsion et bénéficiez d'un accompagnement éducatif personnalisé adapté à vos besoins.
            </p>

            <div class="info-items">
              <div class="info-item">
                <div class="info-icon">
                  <Icon name="check" size="20" />
                </div>
                <span>Accompagnement sur mesure</span>
              </div>
              <div class="info-item">
                <div class="info-icon">
                  <Icon name="check" size="20" />
                </div>
                <span>Équipe pluridisciplinaire</span>
              </div>
              <div class="info-item">
                <div class="info-icon">
                  <Icon name="check" size="20" />
                </div>
                <span>Suivi personnalisé</span>
              </div>
            </div>

            <div class="contact-info">
              <p>Pour toute autre demande :</p>
              <a href="mailto:info@jeunesseandco.ch" class="contact-email">
                <Icon name="mail" size="18" />
                info@jeunesseandco.ch
              </a>
              <a href="tel:+41227311947" class="contact-phone">
                <Icon name="phone" size="18" />
                +41 (0)22 731 19 47
              </a>
            </div>
          </div>
        </div>

        <!-- Right side - Form -->
        <div class="inscription__form-wrapper reveal" style="transition-delay: 0.15s;">
          <form action="https://api.web3forms.com/submit" method="POST" class="inscription-form" id="inscription-form">
            <input type="hidden" name="access_key" value={WEB3FORMS_KEY} />
            <input type="hidden" name="subject" value="Nouvelle inscription - Programme Impulsion" />
            <input type="hidden" name="from_name" value="Jeunesse & Co - Site Web" />
            <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

            <h2>Formulaire d'inscription</h2>

            <div class="form-row">
              <div class="form-group">
                <label for="prenom">Prénom <span class="required">*</span></label>
                <input type="text" id="prenom" name="prenom" required placeholder="Jean" />
              </div>
              <div class="form-group">
                <label for="nom">Nom <span class="required">*</span></label>
                <input type="text" id="nom" name="nom" required placeholder="Dupont" />
              </div>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label for="email">Email <span class="required">*</span></label>
                <input type="email" id="email" name="email" required placeholder="jean.dupont@email.ch" />
              </div>
              <div class="form-group">
                <label for="telephone">Téléphone</label>
                <input type="tel" id="telephone" name="telephone" placeholder="+41 79 123 45 67" />
              </div>
            </div>

            <div class="form-group">
              <label for="provenance">D'où venez-vous ? <span class="required">*</span></label>
              <input type="text" id="provenance" name="provenance" required placeholder="Genève, Lausanne, etc." />
            </div>

            <div class="form-group">
              <label for="message">Message <span class="optional">(optionnel)</span></label>
              <textarea id="message" name="message" rows="4" placeholder="Décrivez brièvement votre situation ou vos attentes..."></textarea>
            </div>

            <button type="submit" class="btn-submit">
              <span>Envoyer ma demande</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </button>
          </form>

          <!-- Success State -->
          <div class="form-success" id="form-success">
            <div class="success-icon">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                <polyline points="22 4 12 14.01 9 11.01"/>
              </svg>
            </div>
            <h2>Demande envoyée !</h2>
            <p>Merci pour votre inscription. Notre équipe vous recontactera très prochainement.</p>
            <a href={base} class="btn-back">Retour à l'accueil</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style lang="scss">
  .inscription {
    min-height: 100vh;
    background: linear-gradient(135deg, var(--color-primary) 0%, #1a1a1a 100%);
    padding: 120px 0 80px;
    
    @media (max-width: 768px) {
      padding: 100px 0 60px;
    }
  }

  .inscription__grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 80px;
    align-items: start;
    
    @media (max-width: 1024px) {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }

  // LEFT SIDE - INFO
  .inscription__info {
    position: sticky;
    top: 120px;
    
    @media (max-width: 1024px) {
      position: relative;
      top: 0;
    }
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: rgba(255, 255, 255, 0.6);
    font-size: var(--fs-base);
    font-weight: 500;
    margin-bottom: 48px;
    transition: color 0.3s ease;
    text-decoration: none;

    &:hover {
      color: var(--color-accent);
    }
  }

  .info-content {
    .label {
      display: inline-block;
      padding: 8px 16px;
      background: rgba(255, 223, 92, 0.1);
      border: 1px solid var(--color-accent);
      border-radius: 100px;
      font-size: var(--fs-xs);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--color-accent);
      margin-bottom: 24px;
    }

    h1 {
      font-family: var(--font-headline);
      font-size: var(--fs-lg);
      font-weight: 700;
      color: var(--color-white);
      line-height: 1.1;
      margin-bottom: 20px;

      .accent {
        color: var(--color-accent);
      }
    }

    .description {
      font-size: var(--fs-base);
      line-height: 1.7;
      color: rgba(255, 255, 255, 0.7);
      margin-bottom: 40px;
    }
  }

  .info-items {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-bottom: 48px;
  }

  .info-item {
    display: flex;
    align-items: center;
    gap: 14px;
    color: rgba(255, 255, 255, 0.85);
    font-size: var(--fs-base);
    font-weight: 500;
  }

  .info-icon {
    width: 32px;
    height: 32px;
    background: rgba(255, 223, 92, 0.15);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-accent);
    flex-shrink: 0;
  }

  .contact-info {
    padding-top: 32px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);

    p {
      font-size: var(--fs-xs);
      color: rgba(255, 255, 255, 0.5);
      margin-bottom: 16px;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    a {
      display: flex;
      align-items: center;
      gap: 12px;
      color: var(--color-white);
      font-size: var(--fs-base);
      font-weight: 500;
      text-decoration: none;
      margin-bottom: 12px;
      transition: color 0.3s ease;

      &:hover {
        color: var(--color-accent);
      }
    }
  }

  // RIGHT SIDE - FORM
  .inscription__form-wrapper {
    background: var(--color-white);
    border-radius: 28px;
    padding: 48px;
    box-shadow: 0 25px 80px rgba(0, 0, 0, 0.25);
    
    @media (max-width: 768px) {
      padding: 32px 24px;
      border-radius: 24px;
    }
  }

  .inscription-form {
    h2 {
      font-family: var(--font-headline);
      font-size: var(--fs-md);
      font-weight: 700;
      color: var(--color-primary);
      margin-bottom: 32px;
    }
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    
    @media (max-width: 600px) {
      grid-template-columns: 1fr;
    }
  }

  .form-group {
    margin-bottom: 24px;
  }

  label {
    display: block;
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: 8px;
    text-transform: uppercase;
    letter-spacing: 0.03em;

    .required {
      color: #e53935;
    }

    .optional {
      font-weight: 400;
      color: var(--color-text-muted);
      text-transform: none;
    }
  }

  input, textarea {
    width: 100%;
    padding: 16px 18px;
    background: #f8f9fa;
    border: 2px solid transparent;
    border-radius: 14px;
    font-size: var(--fs-base);
    color: var(--color-primary);
    transition: all 0.3s ease;
    font-family: inherit;

    &::placeholder {
      color: #adb5bd;
    }

    &:hover {
      background: #f1f3f4;
    }

    &:focus {
      outline: none;
      background: var(--color-white);
      border-color: var(--color-accent);
      box-shadow: 0 0 0 4px rgba(255, 223, 92, 0.15);
    }
  }

  textarea {
    resize: vertical;
    min-height: 120px;
  }

  .btn-submit {
    width: 100%;
    padding: 18px 32px;
    margin-top: 8px;
    font-size: var(--fs-base);
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    border-radius: 14px;
    background: var(--color-primary);
    color: var(--color-white);
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;

    &:hover {
      background: #2a2a2a;
      transform: translateY(-2px);
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
    }

    &:active {
      transform: translateY(0);
    }

    &:disabled {
      opacity: 0.6;
      cursor: not-allowed;
      transform: none;
    }

    svg {
      transition: transform 0.3s ease;
    }

    &:hover svg {
      transform: translateX(4px);
    }
  }

  // SUCCESS STATE
  .form-success {
    display: none;
    text-align: center;
    padding: 40px 20px;

    &.visible {
      display: block;
    }
  }

  .success-icon {
    width: 80px;
    height: 80px;
    background: linear-gradient(135deg, #4ade80 0%, #22c55e 100%);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 24px;
    color: white;
  }

  .form-success h2 {
    font-family: var(--font-headline);
    font-size: var(--fs-md);
    font-weight: 700;
    color: var(--color-primary);
    margin-bottom: 12px;
  }

  .form-success p {
    font-size: var(--fs-base);
    color: var(--color-text-muted);
    margin-bottom: 32px;
    line-height: 1.6;
  }

  .btn-back {
    display: inline-flex;
    padding: 16px 32px;
    background: var(--color-primary);
    color: var(--color-white);
    font-size: var(--fs-base);
    font-weight: 700;
    border-radius: 14px;
    text-decoration: none;
    transition: all 0.3s ease;

    &:hover {
      background: #2a2a2a;
      transform: translateY(-2px);
    }
  }

  // Animations
  .reveal {
    opacity: 0;
    transform: translateY(30px);
    animation: revealUp 0.8s ease forwards;
  }

  @keyframes revealUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  const form = document.getElementById('inscription-form') as HTMLFormElement;
  const formSuccess = document.getElementById('form-success');

  if (form && formSuccess) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      const originalHTML = submitBtn.innerHTML;
      submitBtn.innerHTML = '<span>Envoi en cours...</span>';
      submitBtn.disabled = true;

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
        });

        if (response.ok) {
          form.style.display = 'none';
          formSuccess.classList.add('visible');
          window.scrollTo({ top: 0, behavior: 'smooth' });
        } else {
          throw new Error('Erreur serveur');
        }
      } catch (error) {
        alert('Une erreur est survenue. Veuillez réessayer ou nous contacter à info@jeunesseandco.ch');
        submitBtn.innerHTML = originalHTML;
        submitBtn.disabled = false;
      }
    });
  }
</script>
