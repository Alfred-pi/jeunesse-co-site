---
import Layout from '../layouts/Layout.astro';

// ⚠️ TEXTES D'EXEMPLE (placeholders) — à remplacer par les vrais témoignages
// fournis par le client (textes + photos). Structure prête : il suffit de
// modifier ce tableau. `photo` est optionnel : si absent, un avatar avec
// les initiales est affiché.
const temoignages = [
	{
		quote: "Avant, je ne voyais pas l'intérêt de retourner en cours. Ici, on m'a écouté sans me juger et on a construit un programme qui me ressemble. Aujourd'hui, j'ai repris une formation et je sais où je vais.",
		name: 'Léa',
		context: '17 ans — Programme Impulsion',
	},
	{
		quote: "Ce qui change tout, c'est qu'on n'est pas un dossier. Les éducateurs sont là tous les jours, même quand ça ne va pas. La boxe m'a appris à canaliser ce que j'avais en moi.",
		name: 'Mehdi',
		context: '16 ans — Ateliers sportifs',
	},
	{
		quote: "L'atelier vidéo m'a donné envie de me lever le matin. On a réalisé un clip de A à Z, et pour la première fois, j'étais fier de montrer quelque chose que j'avais fait.",
		name: 'Dylan',
		context: '18 ans — Ateliers audiovisuels',
	},
	{
		quote: "Notre fils était en rupture totale depuis des mois. L'équipe de Jeunesse & Co a su recréer le lien là où nous n'y arrivions plus. Nous avons retrouvé le dialogue à la maison.",
		name: 'Mme B.',
		context: 'Parent',
	},
	{
		quote: "En tant que partenaire institutionnel, nous apprécions la réactivité de l'équipe et la qualité du suivi. Les bilans sont précis, les objectifs co-construits avec le jeune.",
		name: 'C. Rossier',
		context: 'Partenaire réseau',
	},
	{
		quote: "Le projet d'entraide m'a fait découvrir que je pouvais être utile aux autres. On a organisé une collecte pour les sans-abri, c'est nous qui avons tout décidé et tout géré.",
		name: 'Sofia',
		context: "19 ans — Projet d'entraide",
	},
];

const initials = (name: string) =>
	name.split(/\s+/).map((p) => p[0]).join('').toUpperCase().slice(0, 2);
---
<Layout
	title="Témoignages | Jeunesse & Co"
	description="Ils ont vécu l'accompagnement Jeunesse & Co : les jeunes, leurs proches et nos partenaires témoignent."
>
	<section class="temoignages-header">
		<div class="container">
			<div class="header-content reveal">
				<span class="badge">Ils en parlent</span>
				<h1>Leurs <span class="highlight">mots</span>, leur parcours</h1>
				<p class="subtitle">Les jeunes, leurs proches et nos partenaires racontent l'accompagnement Jeunesse & Co.</p>
			</div>
		</div>
	</section>

	<section class="temoignages-section">
		<div class="container">
			<div class="temoignages-grid">
				{temoignages.map((t) => (
					<figure class="temoignage-card reveal">
						<svg class="quote-mark" width="32" height="32" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
							<path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
						</svg>
						<blockquote>{t.quote}</blockquote>
						<figcaption>
							<span class="avatar" aria-hidden="true">{initials(t.name)}</span>
							<span class="who">
								<span class="name">{t.name}</span>
								<span class="context">{t.context}</span>
							</span>
						</figcaption>
					</figure>
				))}
			</div>

			<div class="temoignages-cta reveal">
				<h2>Tu as vécu l'accompagnement Jeunesse&nbsp;&&nbsp;Co&nbsp;?</h2>
				<p>Ton expérience peut aider d'autres jeunes à franchir le pas. Écris-nous pour partager ton témoignage.</p>
				<a href="mailto:info@jeunesseandco.ch?subject=Mon témoignage" class="btn btn--filled">Partager mon témoignage</a>
			</div>
		</div>
	</section>
</Layout>

<style lang="scss">
	.temoignages-header {
		padding: 180px 0 100px;
		background-color: var(--color-primary);
		text-align: center;

		.badge {
			display: inline-block;
			padding: 8px 16px;
			border: 1px solid var(--color-accent);
			border-radius: 100px;
			font-size: 12px;
			text-transform: uppercase;
			letter-spacing: 0.1em;
			color: var(--color-accent);
			margin-bottom: 24px;
			background: rgba(255, 223, 92, 0.1);
			font-weight: 700;
		}

		h1 {
			font-size: clamp(42px, 6vw, 80px);
			margin-bottom: 24px;
			letter-spacing: -0.03em;
			color: var(--color-white);

			.highlight {
				font-family: var(--font-headline);
				font-style: italic;
				position: relative;

				&::after {
					content: '';
					position: absolute;
					bottom: 10px;
					left: -5%;
					width: 110%;
					height: 0.3em;
					background: var(--color-accent);
					opacity: 0.8;
					z-index: -1;
					transform: rotate(-2deg);
				}
			}
		}

		.subtitle {
			max-width: 560px;
			margin: 0 auto;
			color: rgba(255, 255, 255, 0.75);
			font-size: 18px;
			line-height: 1.6;
		}

		@media (max-width: 768px) {
			padding: 140px 0 64px;
		}
	}

	.temoignages-section {
		padding: 100px 0 140px;
		background-color: var(--color-bg);

		@media (max-width: 768px) {
			padding: 60px 0 80px;
		}
	}

	.temoignages-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 24px;

		@media (max-width: 1024px) {
			grid-template-columns: repeat(2, 1fr);
		}

		@media (max-width: 640px) {
			grid-template-columns: 1fr;
			gap: 16px;
		}
	}

	.temoignage-card {
		margin: 0;
		background: var(--color-white);
		border: 1px solid var(--color-border);
		border-radius: 24px;
		padding: 32px;
		display: flex;
		flex-direction: column;
		gap: 20px;
		transition: transform 0.4s var(--ease-out), box-shadow 0.4s var(--ease-out);

		&:hover {
			transform: translateY(-4px);
			box-shadow: 0 20px 60px rgba(0, 0, 0, 0.08);
		}

		.quote-mark {
			color: var(--color-accent);
			flex-shrink: 0;
		}

		blockquote {
			margin: 0;
			font-size: 16px;
			line-height: 1.7;
			color: var(--color-text);
			flex: 1;
		}

		figcaption {
			display: flex;
			align-items: center;
			gap: 14px;
			padding-top: 20px;
			border-top: 1px solid var(--color-border);
		}

		.avatar {
			width: 48px;
			height: 48px;
			border-radius: 50%;
			background: var(--color-accent);
			color: var(--color-primary);
			display: flex;
			align-items: center;
			justify-content: center;
			font-family: var(--font-headline);
			font-weight: 700;
			font-size: 16px;
			flex-shrink: 0;
		}

		.who {
			display: flex;
			flex-direction: column;
		}

		.name {
			font-weight: 700;
			color: var(--color-text);
		}

		.context {
			font-size: 13px;
			color: var(--color-text-muted);
			text-transform: uppercase;
			letter-spacing: 0.04em;
		}
	}

	.temoignages-cta {
		margin-top: 100px;
		text-align: center;
		background: var(--color-primary);
		border-radius: 32px;
		padding: clamp(48px, 8vw, 80px);

		h2 {
			color: var(--color-white);
			font-size: clamp(26px, 4vw, 40px);
			margin-bottom: 16px;
		}

		p {
			color: rgba(255, 255, 255, 0.75);
			max-width: 480px;
			margin: 0 auto 32px;
			line-height: 1.6;
		}

		@media (max-width: 768px) {
			margin-top: 60px;
			border-radius: 20px;
		}
	}
</style>
