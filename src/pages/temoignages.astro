---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';

// ⚠️ PLACEHOLDER — à remplacer par le vrai témoignage fourni par le client
// (texte + photo du jeune, et éventuellement une vidéo plus tard).
// La photo ci-dessous vient du reportage cuisine, en attendant le vrai portrait.
import photoTemoin from '../assets/gallery/cuisine/cuisine-avec-ziaad-14.webp';

const temoignage = {
	quote: "Avant, je ne voyais pas l'intérêt de retourner en cours. Ici, on m'a écouté sans me juger et on a construit un programme qui me ressemble. Les éducateurs sont là tous les jours, même quand ça ne va pas. Aujourd'hui, j'ai repris une formation et je sais où je vais.",
	name: 'Léa',
	context: '17 ans — Programme Impulsion',
	photoAlt: "Portrait d'une jeune accompagnée par Jeunesse & Co",
};
---
<Layout
	title="Témoignages | Jeunesse & Co"
	description="Ils ont vécu l'accompagnement Jeunesse & Co : les jeunes racontent leur parcours."
>
	<section class="temoignages-header">
		<div class="container">
			<div class="header-content reveal">
				<span class="badge">Ils en parlent</span>
				<h1>Leurs <span class="highlight">mots</span>, leur parcours</h1>
				<p class="subtitle">Les jeunes racontent l'accompagnement Jeunesse & Co, avec leurs mots à eux.</p>
			</div>
		</div>
	</section>

	<section class="temoignage-feature">
		<div class="container">
			<div class="feature-grid">
				<div class="feature-photo reveal">
					<div class="photo-frame">
						<Image
							src={photoTemoin}
							alt={temoignage.photoAlt}
							widths={[500, 800, 1100]}
							sizes="(max-width: 900px) 100vw, 45vw"
							loading="eager"
						/>
					</div>
					<div class="photo-shape" aria-hidden="true"></div>
				</div>

				<div class="feature-content reveal">
					<svg class="quote-mark" width="56" height="56" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
						<path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
					</svg>
					<blockquote>{temoignage.quote}</blockquote>
					<div class="feature-author">
						<span class="author-line" aria-hidden="true"></span>
						<div class="author-meta">
							<span class="name">{temoignage.name}</span>
							<span class="context">{temoignage.context}</span>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="temoignages-cta-section">
		<div class="container">
			<div class="temoignages-cta reveal">
				<h2>Tu as vécu l'accompagnement Jeunesse&nbsp;&&nbsp;Co&nbsp;?</h2>
				<p>Ton expérience peut aider d'autres jeunes à franchir le pas. Écris-nous pour partager ton témoignage.</p>
				<a href="mailto:info@jeunesseandco.ch?subject=Mon témoignage" class="btn btn--filled">Partager mon témoignage</a>
			</div>
		</div>
	</section>
</Layout>

<style lang="scss">
	.temoignages-header {
		padding: 180px 0 100px;
		background-color: var(--color-primary);
		text-align: center;

		.badge {
			display: inline-block;
			padding: 8px 16px;
			border: 1px solid var(--color-accent);
			border-radius: 100px;
			font-size: 12px;
			text-transform: uppercase;
			letter-spacing: 0.1em;
			color: var(--color-accent);
			margin-bottom: 24px;
			background: rgba(255, 223, 92, 0.1);
			font-weight: 700;
		}

		h1 {
			font-size: clamp(42px, 6vw, 80px);
			margin-bottom: 24px;
			letter-spacing: -0.03em;
			color: var(--color-white);

			.highlight {
				font-family: var(--font-headline);
				font-style: italic;
				position: relative;

				&::after {
					content: '';
					position: absolute;
					bottom: 10px;
					left: -5%;
					width: 110%;
					height: 0.3em;
					background: var(--color-accent);
					opacity: 0.8;
					z-index: -1;
					transform: rotate(-2deg);
				}
			}
		}

		.subtitle {
			max-width: 560px;
			margin: 0 auto;
			color: rgba(255, 255, 255, 0.75);
			font-size: 18px;
			line-height: 1.6;
		}

		@media (max-width: 768px) {
			padding: 140px 0 64px;
		}
	}

	.temoignage-feature {
		padding: 120px 0;
		background-color: var(--color-bg);

		@media (max-width: 768px) {
			padding: 64px 0;
		}
	}

	.feature-grid {
		display: grid;
		grid-template-columns: 5fr 6fr;
		gap: clamp(40px, 6vw, 96px);
		align-items: center;

		@media (max-width: 900px) {
			grid-template-columns: 1fr;
			gap: 48px;
		}
	}

	.feature-photo {
		position: relative;

		.photo-frame {
			position: relative;
			border-radius: 32px;
			overflow: hidden;
			aspect-ratio: 4 / 5;
			box-shadow: 0 30px 80px rgba(0, 0, 0, 0.15);
			z-index: 1;

			img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
			}

			@media (max-width: 480px) {
				border-radius: 20px;
			}
		}

		// Accent jaune décalé derrière la photo, comme les shapes du hero
		.photo-shape {
			position: absolute;
			width: 140px;
			height: 140px;
			background: var(--color-accent);
			border-radius: 28px;
			top: -28px;
			right: -28px;
			transform: rotate(10deg);
			z-index: 0;

			@media (max-width: 900px) {
				width: 96px;
				height: 96px;
				top: -18px;
				right: -8px;
			}
		}
	}

	.feature-content {
		.quote-mark {
			color: var(--color-accent);
			margin-bottom: 28px;
		}

		blockquote {
			margin: 0 0 40px;
			font-family: var(--font-headline);
			font-size: clamp(22px, 2.6vw, 32px);
			line-height: 1.45;
			font-weight: 500;
			letter-spacing: -0.01em;
			color: var(--color-text);
		}

		.feature-author {
			display: flex;
			align-items: center;
			gap: 20px;

			.author-line {
				width: 56px;
				height: 3px;
				background: var(--color-accent);
				border-radius: 2px;
				flex-shrink: 0;
			}

			.author-meta {
				display: flex;
				flex-direction: column;
			}

			.name {
				font-family: var(--font-headline);
				font-weight: 700;
				font-size: 20px;
				color: var(--color-text);
			}

			.context {
				font-size: 13px;
				color: var(--color-text-muted);
				text-transform: uppercase;
				letter-spacing: 0.05em;
				margin-top: 4px;
			}
		}
	}

	.temoignages-cta-section {
		padding: 0 0 140px;
		background-color: var(--color-bg);

		@media (max-width: 768px) {
			padding-bottom: 80px;
		}
	}

	.temoignages-cta {
		text-align: center;
		background: var(--color-primary);
		border-radius: 32px;
		padding: clamp(48px, 8vw, 80px);

		h2 {
			color: var(--color-white);
			font-size: clamp(26px, 4vw, 40px);
			margin-bottom: 16px;
		}

		p {
			color: rgba(255, 255, 255, 0.75);
			max-width: 480px;
			margin: 0 auto 32px;
			line-height: 1.6;
		}

		@media (max-width: 768px) {
			border-radius: 20px;
		}
	}
</style>
