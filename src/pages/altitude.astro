---
import Layout from '../layouts/Layout.astro';
import AltitudeProfile from '../components/altitude/AltitudeProfile.astro';
import { Image } from 'astro:assets';
import altitudeLogo from '../assets/altitude/altitude-logo.png';
import ziadPhoto from '../assets/altitude/ziad-maalem-himalaya.jpg';
import krishnaPhoto from '../assets/altitude/krishna-kumar-magar.jpg';
import everestPhoto from '../assets/altitude/ziad-everest-sommet.jpg';
import leninePhoto from '../assets/altitude/ziad-pic-lenine-sommet.jpg';
import kiliPhoto from '../assets/altitude/ziad-kilimandjaro-sommet.jpg';
import khumbuPhoto from '../assets/altitude/ziad-khumbu-icefall.jpg';
import ogAltitude from '../assets/altitude/og-altitude.jpg';
const base = import.meta.env.BASE_URL;

// Contenu tiré du dossier « ALTITUDE, programme de remobilisation » (Jeunesse&Co, octobre 2026).
const facts = [
  { n: '5', unit: 'jeunes', text: 'de 15 à 18 ans par cohorte, admis sur entretien.' },
  { n: '40 h', unit: 'par semaine', text: 'de préparation à Genève, jusqu’au départ.' },
  { n: '60', unit: 'jours', text: 'au Népal, dans la région du Kanchenjunga, au printemps 2027.' },
  { n: '3', unit: 'adultes', text: 'de Jeunesse&Co : un éducateur et un intervenant multimédia en continu, le directeur sur les deux dernières semaines.' },
  { n: '1', unit: 'projet', text: 'post-séjour défini avant le départ : stage, apprentissage ou école.' },
  { n: '6', unit: 'mois', text: 'd’accompagnement au minimum après le retour.' },
];

const notThis = [
  { title: 'Une punition ou une mise à l’écart.' },
  { title: 'Une récompense ou des vacances.' },
  { title: 'Un exploit sportif.', text: 'Les jeunes ne gravissent aucun sommet : le camp de base est un objectif symbolique, jamais une obligation.' },
  { title: 'Une réponse clé en main.', text: 'C’est un outil au service d’un projet que le jeune porte.' },
];

const temps = [
  {
    n: '01', name: 'Avant', verb: 'Se préparer', when: 'Jusqu’au départ · 40 h/sem.',
    items: ['Préparation physique', 'Construction du séjour', 'Projet post-séjour', 'Culture, santé, sécurité'],
    goal: 'Un groupe soudé, une condition physique validée, un projet post-séjour concret.',
  },
  {
    n: '02', name: 'Pendant', verb: 'Marcher', when: '60 jours au Népal',
    items: ['Trek progressif', 'Vie au camp de base', 'Vie de groupe', 'Carnet et film'],
    goal: 'Des expériences de réussite répétées, reconnues par le groupe et par les adultes.',
  },
  {
    n: '03', name: 'Après', verb: 'Concrétiser', when: '6 mois minimum',
    items: ['Entrée dans le projet', 'Suivi individuel', 'Liens école / employeur', 'Restitution publique'],
    goal: 'Un jeune inscrit dans une formation ou une activité, et soutenu dans les moments de fragilité.',
  },
];

const chantiers = [
  { title: 'Préparation physique', text: 'Endurance, renforcement, randonnées de difficulté croissante au Salève, dans le Jura puis dans les Préalpes. Elle se conclut par une sortie test de plusieurs jours en cabane, en altitude, avec le sac complet.' },
  { title: 'Construction collective du séjour', text: 'Avec l’agence partenaire, les jeunes travaillent l’itinéraire, établissent le budget, choisissent et entretiennent le matériel, organisent la logistique et écrivent les règles de vie du groupe.' },
  { title: 'Projet post-séjour', text: 'Bilan de compétences, recherche de places, stages d’observation, candidatures, entretiens. Objectif : une place confirmée ou des démarches avancées, en stage longue durée, en apprentissage ou en école.' },
  { title: 'Culture, santé et sécurité', text: 'Découverte du Népal, de sa langue et de ses usages. Premiers secours, altitude, hygiène, gestion de l’effort. Initiation à la prise de vue et au récit avec l’intervenant multimédia.' },
];

const week = [
  { h: 12, label: 'Préparation physique' },
  { h: 12, label: 'Projet post-séjour' },
  { h: 8, label: 'Construction du séjour' },
  { h: 4, label: 'Culture, santé, sécurité' },
  { h: 4, label: 'Bilans et entretiens' },
];

const departure = [
  'Assiduité régulière sur toute la durée de la préparation.',
  'Capacité physique validée lors de la sortie test en montagne.',
  'Projet post-séjour défini et engagé, avec une date d’entrée ou des démarches avancées.',
  'Aptitude médicale confirmée, vaccinations à jour.',
  'Respect du cadre et des règles de vie élaborées par le groupe.',
  'Documents en ordre : passeport, visa, autorisations de l’autorité compétente si une mesure est en cours.',
];

const campLife = [
  { title: 'Un rythme quotidien tenu.', text: 'Lever, tâches collectives, cuisine avec l’éducateur, courtes randonnées d’entretien autour du camp, temps de repos.' },
  { title: 'Le projet post-séjour.', text: 'Un temps individuel chaque semaine sur la suite. Le séjour sert à éprouver le projet, pas à l’oublier.' },
  { title: 'Le film.', text: 'Ateliers de prise de vue, d’interview et de montage avec Issa Dieng.' },
  { title: 'La rencontre.', text: 'Sherpas, cuisiniers, porteurs, cérémonie de la puja : une autre culture du travail et de l’effort.' },
  { title: 'La santé avant tout.', text: 'Contrôle quotidien de la saturation en oxygène. Un jeune qui présente des signes d’intolérance redescend, accompagné.' },
];

const trekDay = [
  { when: 'Réveil', text: 'Rangement, sac prêt, petit-déjeuner. Briefing du jour animé par un jeune avec le guide.' },
  { when: 'Marche', text: 'Cinq à sept heures, pauses régulières. Le rythme est celui du plus lent.' },
  { when: 'Après-midi', text: 'Repos, lessive, carnet de bord, temps de tournage ou de montage.' },
  { when: 'Soir', text: 'Repas, puis cercle du soir : ce qui a été difficile, ce que j’ai réussi, ce que j’ai vu chez les autres.' },
];

const roles = [
  { name: 'Guide du jour', text: 'Lit l’étape avec le guide népalais.' },
  { name: 'Intendant', text: 'Eau, en-cas, matériel.' },
  { name: 'Trésorier', text: 'Tient les dépenses dans les lodges.' },
  { name: 'Reporter', text: 'Images et carnet de bord.' },
  { name: 'Veilleur', text: 'Personne ne reste derrière.' },
];

const after = [
  { title: 'Semaine du retour', text: 'Temps de récupération encadré, bilan individuel, remise de la lettre écrite avant le départ.' },
  { title: 'Entrée dans le projet', text: 'Le stage, l’apprentissage ou l’école préparé avant le départ commence dès que possible, idéalement dans les semaines qui suivent le retour.' },
  { title: 'Suivi individuel', text: 'Rencontre hebdomadaire les trois premiers mois, puis adaptée à la situation.' },
  { title: 'Présence auprès de l’école ou de l’employeur', text: 'Rencontres tripartites, médiation en cas de difficulté, soutien dans les démarches administratives.' },
  { title: 'Le groupe reste une ressource', text: 'Rencontres mensuelles des cinq jeunes.' },
  { title: 'Restitution publique', text: 'Les jeunes présentent leur film aux familles, aux partenaires et aux autorités. Ils racontent eux-mêmes leur parcours.' },
];

const filmPoints = [
  { title: 'Voir d’où l’on vient.', text: 'Dans les moments de doute, revoir les images des premières semaines montre le chemin parcouru mieux que n’importe quel discours.' },
  { title: 'Mettre des mots.', text: 'Les interviews filmées obligent à formuler ce que l’on vit, ce que l’on ressent, ce que l’on veut.' },
  { title: 'Être reconnu.', text: 'La restitution publique place le jeune en position d’auteur de son histoire, devant sa famille et le réseau.' },
  { title: 'Un appui pour la suite.', text: 'Un extrait peut accompagner une candidature ou un entretien, si le jeune le souhaite.' },
];

const ascents = ['Everest', 'Pic Lénine', 'Lobuche East', 'Kilimandjaro', 'Cervin', 'Mont Blanc'];

// Photos publiées par Ziad sur sa page « Objectif Everest ».
const summits = [
  { src: everestPhoto, place: 'Everest', height: '8’849 m', caption: 'Ziad au sommet de l’Everest, en combinaison d’altitude et masque à oxygène, drapeau suisse en main', position: '50% 30%' },
  { src: leninePhoto, place: 'Pic Lénine', height: '7’134 m', caption: 'Ziad au sommet du pic Lénine, sous les drapeaux de prières', position: '50% 40%' },
  { src: kiliPhoto, place: 'Kilimandjaro', height: '5’895 m', caption: 'Ziad devant le panneau du sommet du Kilimandjaro, Uhuru Peak', position: '45% 50%' },
  { src: khumbuPhoto, place: 'Cascade du Khumbu', height: 'voie de l’Everest', caption: 'Ziad casqué, encordé dans la cascade de glace du Khumbu', position: '70% 50%' },
];

const shifts = [
  { title: 'Géographique', text: 'Sortir de son territoire.' },
  { title: 'De rôle', text: 'De jeune « suivi » à jeune acteur.' },
  { title: 'De méthode', text: 'Du discours vers l’expérience.' },
];

const nepal = [
  { title: 'L’altitude impose la progressivité.', text: 'On ne peut pas monter vite. Le corps fixe le rythme, et ce rythme n’est imposé par aucun adulte.' },
  { title: 'Un dépaysement complet, dans un cadre sûr.', text: 'Langue, culture, alimentation : les repères habituels tombent. Le jeune doit observer, demander, s’adapter.' },
  { title: 'La sobriété.', text: 'Lodges simples puis vie sous tente, réseau limité. La relation aux écrans et à la consommation se transforme d’elle-même.' },
  { title: 'La rencontre.', text: 'Guides, porteurs, familles qui tiennent les lodges : des personnes de son âge qui travaillent dur et accueillent avec générosité.' },
];

const studies = [
  { figure: '96 études', title: 'Éducation par l’aventure, méta-analyse', source: 'Hattie, Marsh, Neill & Richards, 1997, Review of Educational Research', url: 'https://eric.ed.gov/?id=EJ548328', text: 'Effets positifs sur le concept de soi, le sentiment de contrôle sur sa vie et le leadership. Plus importants lorsque le programme est plus long, ils se maintiennent au suivi.' },
  { figure: '11 études', title: 'Thérapie par la nature et délinquance juvénile', source: 'Beck & Wong, 2022, Criminal Justice and Behavior', url: 'https://journals.sagepub.com/doi/10.1177/00938548221078002', text: 'Effets importants et significatifs sur les comportements délinquants, rapportés par les jeunes et par leurs proches.' },
  { figure: '76 %', title: 'Marches éducatives de l’association Seuil', source: 'Évaluation Pro-Éthique, cohortes 2015-2016', url: 'https://oip.org/analyse/marcher-pour-se-remettre-sur-les-rails/', text: 'Parmi les jeunes qui ont marché plus de 60 jours, 76 % présentent une évolution positive un à deux ans après.' },
  { figure: '14 sur 25', title: 'Séjours de rupture et cheminement des adolescents', source: 'Moreau, 2014, étude pour l’ONPE', url: 'https://onpe.france-enfance-protegee.fr/wp-content/uploads/2024/01/aot2012.moreau_synthese.pdf', text: 'Situations aboutissant à une insertion scolaire ou professionnelle. Le retour et la continuité du suivi sont déterminants.' },
];

const conditions = [
  { c: 'L’adhésion du jeune', r: 'Entretien d’admission, démarche active du jeune, contrat d’engagement.' },
  { c: 'La durée et l’intensité', r: 'Plusieurs mois à 40 h par semaine, puis 60 jours au Népal.' },
  { c: 'Une relation de confiance avec un adulte fiable', r: 'Les mêmes adultes du premier jour de préparation à la fin de l’accompagnement.' },
  { c: 'La continuité au retour', r: 'Projet post-séjour engagé avant le départ, six mois d’accompagnement au minimum.' },
];

const safety = [
  {
    title: 'Santé et altitude',
    items: [
      'Bilan médical à l’admission et consultation de médecine des voyages.',
      'Progression inspirée des recommandations de la Wilderness Medical Society : au-dessus de 3’000 m, environ 400 m de gain moyen entre deux nuits, deux journées d’acclimatation.',
      'Contrôle quotidien des signes du mal aigu des montagnes et de la saturation en oxygène. En cas de symptômes : arrêt ou descente, sans discussion.',
      'Équipe et jeunes formés aux premiers secours pendant la préparation.',
    ],
  },
  {
    title: 'Le cadre de vie',
    items: [
      'Règles connues, co-construites et signées avant le départ.',
      'Alcool et stupéfiants interdits pendant toute la durée du séjour.',
      'En cas de mise en danger grave de soi ou d’autrui : retour anticipé accompagné, prévu au contrat et au budget. L’autorité et les représentants légaux sont informés sans délai.',
    ],
  },
  {
    title: 'Assurances et liaison',
    items: [
      'Assurance voyage couvrant rapatriement et secours héliporté jusqu’à 5’500 m.',
      'Communicateur satellite et téléphone local, point de situation hebdomadaire avec la direction.',
      'La direction de Jeunesse&Co, joignable jour et nuit depuis Genève pendant tout le séjour.',
      'Passeports, visas et permis de zone réglementée gérés en amont.',
    ],
  },
];

const admission = [
  { title: 'Orientation', text: 'Par l’autorité judiciaire, un service (SPMi, Hospice général, DIP…), la famille ou le réseau.' },
  { title: 'Rencontre de présentation', text: 'Le programme est présenté au jeune et à ses proches, sans rien cacher de ses exigences.' },
  { title: 'Temps de réflexion', text: 'C’est au jeune de reprendre contact s’il souhaite poursuivre.' },
  { title: 'Entretien d’admission', text: 'Avec l’éducateur référent et la direction. Le jeune explique avec ses mots pourquoi il veut s’engager.' },
  { title: 'Bilan médical', text: 'Aptitude à l’effort prolongé et à l’altitude, validée par un médecin.' },
  { title: 'Contrat d’engagement', text: 'Signé par le jeune, ses représentants légaux et Jeunesse&Co. L’autorité mandante en reçoit copie.' },
];

const calendar = [
  { when: 'Automne – hiver 2026', text: 'Présentation aux mandants, orientations, rencontres et entretiens d’admission.' },
  { when: 'Jusqu’au départ', text: 'Préparation intensive à 40 h par semaine. Sortie test en montagne. Bilan de départ.' },
  { when: 'Printemps 2027', text: 'Séjour de 60 jours au Népal, région du Kanchenjunga.' },
  { when: 'Retour + 6 mois', text: 'Entrée dans le projet, accompagnement individuel et collectif, restitution publique.' },
];

const check = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>`;
---

<Layout
  title="Programme Altitude | Jeunesse & Co"
  description="ALTITUDE, programme de remobilisation de Jeunesse&Co : plusieurs mois de préparation à Genève, 60 jours au Népal au pied du Kanchenjunga, six mois d’accompagnement au retour."
  ogImage={ogAltitude}
>
  <!-- HERO -->
  <section class="alt-hero">
    <div class="container alt-hero__grid">
      <h1 class="alt-hero__logo reveal">
        <Image src={altitudeLogo} alt="ALTITUDE, avant, pendant, après" widths={[560, 1137]} sizes="(max-width: 1024px) 88vw, 560px" loading="eager" fetchpriority="high" />
      </h1>
      <div class="alt-hero__text reveal">
        <span class="alt-pill">Nouveau programme de remobilisation</span>
        <p class="alt-hero__claim"><span>Construire un projet,</span> <span>le marcher,</span> <span>le faire tenir.</span></p>
        <p class="alt-hero__lead">Pour cinq jeunes de 15 à 18 ans : plusieurs mois de préparation à Genève, soixante jours au Népal au pied du Kanchenjunga, puis six mois d’accompagnement au retour.</p>
        <ul class="alt-hero__meta" aria-label="En un coup d’œil">
          <li>Népal</li>
          <li>Kanchenjunga, 8’586&nbsp;m</li>
          <li>Printemps 2027</li>
        </ul>
        <div class="alt-hero__actions">
          <a href="#orienter" class="alt-btn alt-btn--accent">
            Orienter un jeune
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="#en-bref" class="alt-btn alt-btn--ghost">Le programme en bref</a>
        </div>
      </div>
    </div>
  </section>

  <!-- EN BREF -->
  <section class="alt-brief" id="en-bref">
    <div class="container alt-split">
      <div class="alt-split__head reveal">
        <h2>Le programme <span class="alt-mark">en bref</span></h2>
        <p class="alt-lead">ALTITUDE est un programme intensif de remobilisation construit autour d’un projet collectif : un séjour de 60 jours au Népal, préparé pendant plusieurs mois à Genève et prolongé par un accompagnement au retour.</p>
        <p>Il s’adresse à des jeunes qui s’engagent volontairement et entièrement. Tout le parcours est filmé : chaque jeune repart avec la vidéo de son propre chemin.</p>
      </div>
      <dl class="alt-facts">
        {facts.map((f) => (
          <div class="alt-facts__row reveal">
            <dt><span class="alt-facts__n">{f.n}</span> <span class="alt-facts__unit">{f.unit}</span></dt>
            <dd>{f.text}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- POSITION -->
  <section class="alt-position">
    <div class="container">
      <div class="alt-position__grid">
        <div class="reveal">
          <span class="alt-kicker">Notre position</span>
          <h2>Ni rupture, <span class="alt-mark">ni parenthèse</span></h2>
          <p class="alt-lead">Les séjours dits « de rupture » ont montré leur intérêt. Ils ont aussi montré leur limite principale : ce qui se passe au retour.</p>
          <p>Le jeune vit une expérience forte, puis rentre dans le même quartier, retrouve les mêmes pairs et les mêmes habitudes, sans place qui l’attend. Les acquis s’effritent en quelques semaines. Le séjour devient un souvenir, pas un point d’appui.</p>
          <p>Nous ne cherchons pas à couper le jeune de son environnement, de sa famille ou de son réseau. Nous cherchons à l’aider à en sortir un temps pour y revenir autrement, avec une place à prendre.</p>
        </div>

        <figure class="alt-curve reveal">
          <div class="alt-curve__plot" aria-hidden="true">
            <span class="alt-curve__axis">Mobilisation du jeune</span>
            <svg viewBox="0 0 300 160" preserveAspectRatio="none">
              <line x1="100" y1="0" x2="100" y2="160" class="alt-curve__sep" vector-effect="non-scaling-stroke" />
              <line x1="200" y1="0" x2="200" y2="160" class="alt-curve__sep" vector-effect="non-scaling-stroke" />
              <path d="M0,146 L96,145 C118,144 126,44 150,40 C174,36 182,124 206,138 L300,142" class="alt-curve__classic" vector-effect="non-scaling-stroke" />
              <path d="M0,146 C40,142 70,118 100,96 C125,70 135,34 160,30 C186,26 194,60 210,62 C238,62 268,44 300,34" class="alt-curve__altitude" vector-effect="non-scaling-stroke" />
            </svg>
            <div class="alt-curve__phases"><span>Avant</span><span>Pendant</span><span>Après</span></div>
          </div>
          <figcaption>
            <ul class="alt-curve__legend">
              <li class="is-altitude">Programme ALTITUDE</li>
              <li class="is-classic">Séjour « de rupture » classique</li>
            </ul>
            <p>Schéma illustratif de l’intention du programme. Il ne représente pas des données mesurées.</p>
          </figcaption>
        </figure>
      </div>

      <div class="alt-not reveal">
        <h3>Ce que le programme <span>n’est pas</span></h3>
        <ul>
          {notThis.map((n) => (
            <li>
              <span class="alt-not__x" aria-hidden="true"></span>
              <p><strong>{n.title}</strong>{n.text && <> {n.text}</>}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- TROIS TEMPS -->
  <section class="alt-temps alt-dark">
    <div class="container">
      <div class="alt-section-head reveal">
        <span class="alt-kicker">Architecture</span>
        <h2>Un programme en <span class="alt-mark">trois temps</span></h2>
        <p class="alt-lead">Les trois temps forment un tout. Aucun n’a de sens sans les deux autres.</p>
      </div>

      <ol class="alt-temps__rope">
        {temps.map((t, i) => (
          <li class:list={['alt-temps__step reveal', { 'is-peak': i === 1 }]}>
            <span class="alt-temps__node" aria-hidden="true">{t.n}</span>
            <p class="alt-temps__when">{t.when}</p>
            <h3><span>{t.name}</span> {t.verb}</h3>
            <ul>
              {t.items.map((it) => <li>{it}</li>)}
            </ul>
            <p class="alt-temps__goal">{t.goal}</p>
          </li>
        ))}
      </ol>

      <p class="alt-temps__thread reveal">Le fil rouge est le même du début à la fin : le jeune agit, observe les effets de son action et ajuste. L’éducateur et l’intervenant multimédia qui le suivent pendant la préparation sont ceux qui partent avec lui et ceux qui l’accompagnent au retour. <strong>Il n’y a pas de passage de relais.</strong></p>

      <div class="alt-why reveal">
        <h3 class="alt-why__title">Pourquoi « ALTITUDE »</h3>
        <p class="alt-why__steps">
          <span>En montagne, on ne gagne pas de l’altitude d’un coup.</span>
          <span>On monte par paliers, on s’arrête pour s’acclimater, on repart.</span>
          <span>Le programme suit la même logique : préparer, progresser, consolider.</span>
          <span>Et une fois gagnée, <em>l’altitude se garde</em> : c’est tout l’objet de l’après.</span>
        </p>
      </div>
    </div>
  </section>

  <!-- TEMPS 1 : AVANT -->
  <section class="alt-avant">
    <div class="container">
      <div class="alt-section-head alt-section-head--left reveal">
        <span class="alt-kicker">Temps 1 · Avant</span>
        <h2>La préparation, <span class="alt-mark">40 h par semaine</span></h2>
        <p class="alt-lead">Jusqu’au départ, les cinq jeunes sont engagés à plein temps. La préparation n’est pas une salle d’attente : c’est déjà le programme.</p>
      </div>

      <ol class="alt-chantiers">
        {chantiers.map((c, i) => (
          <li class="reveal">
            <span class="alt-chantiers__n">0{i + 1}</span>
            <h3>{c.title}</h3>
            <p>{c.text}</p>
          </li>
        ))}
      </ol>

      <figure class="alt-week reveal">
        <figcaption><strong>Une semaine type de 40 heures</strong> <span>Répartition indicative</span></figcaption>
        <div class="alt-week__bar" role="img" aria-label="Environ 12 heures de préparation physique, 12 heures de projet post-séjour, 8 heures de construction du séjour, 4 heures de culture, santé et sécurité, 4 heures de bilans et d’entretiens individuels.">
          {week.map((w, i) => (
            <span class={`alt-week__seg alt-week__seg--${i + 1}`} style={`flex-grow:${w.h}`}>{w.h} h</span>
          ))}
        </div>
        <ul class="alt-week__legend" aria-hidden="true">
          {week.map((w, i) => (
            <li><span class={`alt-week__dot alt-week__seg--${i + 1}`}></span>{w.label}</li>
          ))}
        </ul>
      </figure>

      <div class="alt-departure reveal">
        <div class="alt-departure__head">
          <h3>Le départ <span class="alt-mark">se gagne</span></h3>
          <p>L’admission ouvre la préparation, elle ne garantit pas le départ. Un bilan réunit le jeune, ses représentants légaux et l’équipe pour vérifier six conditions.</p>
          <p class="alt-departure__note">Si une condition n’est pas remplie, le départ est reporté ou le jeune poursuit un accompagnement adapté au sein de Jeunesse&Co. Le projet post-séjour, lui, reste actif.</p>
        </div>
        <ul class="alt-checks">
          {departure.map((d) => (
            <li><span class="alt-checks__icon" set:html={check} />{d}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- TEMPS 2 : PENDANT -->
  <section class="alt-pendant alt-dark" id="sejour">
    <div class="container">
      <div class="alt-section-head alt-section-head--left reveal">
        <span class="alt-kicker">Temps 2 · Pendant</span>
        <h2>Deux mois <span class="alt-mark">au Népal</span></h2>
        <p class="alt-lead">Soixante jours dans l’Himalaya, au pied du Kanchenjunga (8’586&nbsp;m), troisième sommet du monde. Un cadre qui ne repose pas sur l’autorité des adultes, mais sur la réalité : pour avancer, il faut marcher ; pour se reposer, il faut être arrivé.</p>
      </div>

      <AltitudeProfile />

      <p class="alt-pendant__frame reveal">Le séjour s’inscrit dans une expédition organisée par l’agence népalaise <strong>Dream Peak Adventure</strong> et guidée par son cofondateur, Krishna Kumar Magar. Les jeunes vont jusqu’au camp de base, à 5’475&nbsp;m. <strong>Aucune ascension au-delà n’est prévue pour eux.</strong></p>

      <div class="alt-camp">
        <div class="alt-camp__life reveal">
          <h3>Six semaines au camp de base</h3>
          <p class="alt-camp__intro">Le camp de base est un village de tentes. Chaque jour compte : eau, repas, rangement, entretien du matériel. Les jeunes y vivent l’expédition de l’intérieur, avec ses règles, ses attentes et sa discipline.</p>
          <ul>
            {campLife.map((c) => <li><strong>{c.title}</strong> {c.text}</li>)}
          </ul>
        </div>
        <div class="alt-camp__day reveal">
          <h3>Une journée de trek</h3>
          <ol class="alt-day">
            {trekDay.map((d) => (
              <li><span class="alt-day__when">{d.when}</span><p>{d.text}</p></li>
            ))}
          </ol>
        </div>
      </div>

      <div class="alt-roles reveal">
        <div class="alt-roles__head">
          <h3>Des rôles tournants</h3>
          <p>Chaque jour, chaque jeune tient un rôle utile au groupe. Les rôles changent pour que chacun les exerce tous.</p>
        </div>
        <ul class="alt-roles__list">
          {roles.map((r) => (
            <li><strong>{r.name}</strong><span>{r.text}</span></li>
          ))}
        </ul>
      </div>

      <p class="alt-letter reveal">Avant le départ, chaque jeune écrit <span class="alt-mark">une lettre à lui-même</span>, remise au retour.</p>
    </div>
  </section>

  <!-- TEMPS 3 : APRÈS -->
  <section class="alt-apres">
    <div class="container alt-apres__grid">
      <div class="alt-apres__intro reveal">
        <span class="alt-kicker">Temps 3 · Après</span>
        <h2>Concrétiser <span class="alt-mark">et faire tenir</span></h2>
        <p class="alt-lead">Le retour est le moment le plus fragile. C’est aussi celui que la plupart des séjours laissent de côté. Pour ALTITUDE, c’est là que tout se joue.</p>
        <p>Au retour, le jeune retrouve son environnement : le quartier, les pairs, les habitudes, parfois les conflits. L’énergie du séjour retombe. Ce creux est prévisible. Il a été anticipé pendant la préparation : chaque jeune a identifié ses situations à risque et ses personnes ressources.</p>
        <blockquote class="alt-quote">La cordée ne se défait pas à l’aéroport.</blockquote>
      </div>
      <div class="reveal">
        <h3 class="alt-apres__title">L’accompagnement, six mois au minimum</h3>
        <ol class="alt-rail">
          {after.map((a) => (
            <li><h4>{a.title}</h4><p>{a.text}</p></li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- FILM -->
  <section class="alt-film alt-dark">
    <div class="container alt-film__grid">
      <div class="alt-film__intro reveal">
        <span class="alt-kicker">Documenter</span>
        <h2>Un film pour <span class="alt-mark">garder la trace</span></h2>
        <p class="alt-lead">Issa Dieng, vidéaste et intervenant de Jeunesse&Co, accompagne le groupe du premier jour de la préparation jusqu’à la restitution. Il filme le processus, pas l’exploit.</p>
        <p>Les jeunes ne sont pas seulement filmés : ils filment, interviewent, choisissent les images et participent au montage. Chaque jeune repart avec la vidéo de son propre parcours, et le groupe avec un film commun.</p>
        <p class="alt-film__rights">Droit à l’image : consentement écrit du jeune et de ses représentants légaux avant tout tournage. Le jeune valide le montage qui le concerne et peut retirer son accord à tout moment. Aucune diffusion hors du cercle défini sans accord exprès.</p>
      </div>
      <div class="alt-film__points reveal">
        <h3>Un outil éducatif, pas seulement un souvenir</h3>
        <ul>
          {filmPoints.map((f) => <li><strong>{f.title}</strong> {f.text}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- ÉQUIPE -->
  <section class="alt-team" id="equipe">
    <div class="container">
      <div class="alt-section-head alt-section-head--left reveal">
        <span class="alt-kicker">L’équipe sur le terrain</span>
        <h2>Les adultes qui partent <span class="alt-mark">sont ceux qui restent</span></h2>
        <p class="alt-lead">Trois personnes accompagnent les jeunes au Népal, du premier au dernier jour. Ziad et Krishna ont un point commun : tous deux ont découvert la montagne vers 15 ans, l’âge des jeunes à qui s’adresse ALTITUDE.</p>
      </div>

      <article class="alt-ziad">
        <figure class="alt-ziad__photo reveal">
          <Image src={ziadPhoto} alt="Ziad Maalem, sac au dos, souriant, devant les sommets enneigés de l’Himalaya" widths={[400, 576]} sizes="(max-width: 768px) 90vw, 440px" />
        </figure>
        <div class="alt-ziad__body reveal">
          <p class="alt-ziad__role">Éducateur référent du programme</p>
          <h3>Ziad Maalem</h3>
          <p class="alt-ziad__job">Éducateur social, alpiniste et cuisinier</p>

          <p>Entre 15 et 18 ans, Ziad a vécu en foyer. C’est là qu’un éducateur l’a emmené pour la première fois en montagne. Ce qu’il y a trouvé dépassait le sport : un endroit où relever des défis, apprendre à persévérer et découvrir qu’il en était capable. Il y a aussi rencontré un adulte qui posait un cadre, encourageait sans imposer et lui faisait confiance. Cette rencontre a changé la direction de sa vie et l’a conduit à devenir éducateur, pour transmettre à son tour ce qu’il avait reçu.</p>

          <blockquote class="alt-ziad__quote">« La montagne m’a permis de découvrir mes capacités et d’envisager mon avenir autrement. Aujourd’hui, je m’appuie sur cette expérience pour aider les jeunes à découvrir les leurs, à gagner en autonomie et à construire leur propre chemin. »</blockquote>

          <p>Il est l’éducateur référent des cinq jeunes, de la préparation à Genève jusqu’au suivi au retour. Sur le terrain, son expérience de l’altitude sert directement la sécurité du groupe. Cuisinier, il associe les jeunes aux repas et à la vie du camp.</p>

          <div class="alt-ziad__summits">
            <p>Ses ascensions</p>
            <ul>{ascents.map((a) => <li>{a}</li>)}</ul>
          </div>
        </div>
      </article>

      <div class="alt-summits">
        <ul>
          {summits.map((p) => (
            <li class="reveal">
              <figure>
                <Image src={p.src} alt={p.caption} widths={[360, 720]} sizes="(max-width: 768px) 45vw, 300px" style={`object-position:${p.position}`} />
                <figcaption><strong>{p.place}</strong> {p.height}</figcaption>
              </figure>
            </li>
          ))}
        </ul>
        <p class="alt-summits__credit">Photos : Ziad Maalem, page « Objectif Everest ».</p>
      </div>

      <ul class="alt-crew">
        <li class="reveal">
          <img src={`${base}assets/intervenants/issa_dieng.jpeg`} alt="" width="96" height="96" loading="lazy" class="alt-crew__avatar alt-crew__avatar--issa" />
          <div>
            <h3>Issa Dieng</h3>
            <p class="alt-crew__role">Vidéaste et photographe, fondateur de Pacific Images</p>
            <p>Il suit le groupe de la préparation à la restitution et renforce l’encadrement pendant tout le séjour. Il ne filme pas des exploits : il filme un chemin.</p>
          </div>
        </li>
        <li class="reveal">
          <Image src={krishnaPhoto} alt="" width={96} height={96} densities={[1, 2]} class="alt-crew__avatar" />
          <div>
            <h3>Krishna Kumar Magar</h3>
            <p class="alt-crew__role">Guide du séjour, cofondateur de Dream Peak Adventure</p>
            <p>Né dans le Solukhumbu, il découvre le trekking à 15 ans. Accompagnateur international en montagne certifié UIMLA, il parle couramment français : les jeunes échangent directement avec lui.</p>
          </div>
        </li>
        <li class="reveal">
          <span class="alt-crew__avatar alt-crew__avatar--initials" aria-hidden="true">HD</span>
          <div>
            <h3>Hacene Debbah</h3>
            <p class="alt-crew__role">Directeur et fondateur de Jeunesse&Co</p>
            <p>Présent sur place pendant les deux dernières semaines du séjour et pour le retour. Toute l’équipe redescend et rentre en Suisse avec le groupe.</p>
          </div>
        </li>
      </ul>
    </div>
  </section>

  <!-- FONDEMENTS -->
  <section class="alt-roots alt-dark">
    <div class="container">
      <div class="alt-section-head alt-section-head--left reveal">
        <span class="alt-kicker">Fondements éducatifs</span>
        <h2>Agir plutôt <span class="alt-mark">que discourir</span></h2>
        <p class="alt-lead">Les jeunes que nous accompagnons cumulent souvent les difficultés : déscolarisation, conflits familiaux, perte de repères, défiance envers les institutions, faible estime de soi. ALTITUDE vise un triple déplacement.</p>
      </div>

      <ol class="alt-shifts reveal">
        {shifts.map((s) => <li><strong>{s.title}</strong><span>{s.text}</span></li>)}
      </ol>

      <blockquote class="alt-bigquote reveal">
        <p>« Il ne s’agit pas de transformer le jeune, mais de lui permettre de faire l’expérience, concrète et répétée, <span>qu’il est capable d’agir autrement.</span> »</p>
      </blockquote>

      <div class="alt-nepal reveal">
        <h3>Pourquoi le Népal</h3>
        <ul>
          {nepal.map((n) => <li><strong>{n.title}</strong> {n.text}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- RECHERCHE -->
  <section class="alt-research">
    <div class="container">
      <div class="alt-section-head alt-section-head--left reveal">
        <span class="alt-kicker">Ce que dit la recherche</span>
        <h2>Des effets <span class="alt-mark">documentés</span></h2>
        <p class="alt-lead">Les programmes éducatifs fondés sur l’aventure et la marche sont évalués depuis plus de trente ans. Leurs résultats sont encourageants, à certaines conditions.</p>
      </div>

      <ul class="alt-studies">
        {studies.map((s) => (
          <li class="reveal">
            <span class="alt-studies__figure">{s.figure}</span>
            <div>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
              <a href={s.url} target="_blank" rel="noopener">{s.source}<span class="sr-only"> (nouvel onglet)</span></a>
            </div>
          </li>
        ))}
      </ul>

      <div class="alt-conditions reveal">
        <h3>Quatre conditions de réussite, quatre réponses</h3>
        <table>
          <thead>
            <tr><th scope="col">Condition de réussite</th><th scope="col">Réponse d’ALTITUDE</th></tr>
          </thead>
          <tbody>
            {conditions.map((c) => <tr><th scope="row">{c.c}</th><td>{c.r}</td></tr>)}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- SÉCURITÉ -->
  <section class="alt-safety">
    <div class="container">
      <div class="alt-section-head alt-section-head--left reveal">
        <span class="alt-kicker">Cadre et sécurité</span>
        <h2>La santé passe <span class="alt-mark">avant l’objectif</span></h2>
        <p class="alt-lead">Les jeunes ne sont jamais sans encadrement adulte. L’équipe de Jeunesse&Co et le personnel de l’agence se relaient auprès d’eux pendant tout le séjour.</p>
      </div>
      <div class="alt-safety__grid">
        {safety.map((s) => (
          <div class="alt-safety__col reveal">
            <h3>{s.title}</h3>
            <ul>{s.items.map((it) => <li>{it}</li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ADMISSION + CALENDRIER -->
  <section class="alt-admission alt-dark">
    <div class="container">
      <div class="alt-section-head alt-section-head--left reveal">
        <span class="alt-kicker">Admission</span>
        <h2>Un engagement <span class="alt-mark">choisi</span></h2>
        <p class="alt-lead">Une décision judiciaire peut ouvrir la porte du programme. Elle ne peut pas remplacer l’adhésion du jeune. C’est pourquoi l’admission repose sur un entretien et sur une démarche active du jeune, avec ses représentants légaux associés à chaque étape.</p>
      </div>

      <ol class="alt-steps">
        {admission.map((a, i) => (
          <li class="reveal">
            <span class="alt-steps__n">{i + 1}</span>
            <h3>{a.title}</h3>
            <p>{a.text}</p>
          </li>
        ))}
      </ol>

      <div class="alt-calendar reveal">
        <h3>Calendrier</h3>
        <ol>
          {calendar.map((c) => (
            <li><span class="alt-calendar__when">{c.when}</span><p>{c.text}</p></li>
          ))}
        </ol>
        <p class="alt-calendar__note">Les dates précises seront communiquées dès la constitution du groupe et la validation de l’itinéraire.</p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="alt-cta" id="orienter">
    <div class="container alt-cta__grid">
      <div class="reveal">
        <h2>Orienter un jeune vers ALTITUDE</h2>
        <p class="alt-cta__lead">Autorités, services, familles : la direction de Jeunesse&Co est votre interlocutrice pour toute question, pour une rencontre ou pour présenter le programme à un jeune et à sa famille.</p>
        <p class="alt-cta__ambition">Notre ambition est simple : qu’à la fin du programme, chaque jeune soit engagé dans une formation ou une activité, et qu’il sache, pour l’avoir vécu, qu’il est capable de tenir.</p>
      </div>
      <div class="alt-cta__contact reveal">
        <a class="alt-cta__link" href="mailto:info@jeunesseandco.ch?subject=Programme%20ALTITUDE">
          <span>Écrire</span>
          info@jeunesseandco.ch
        </a>
        <a class="alt-cta__link" href="tel:+41227311947">
          <span>Appeler</span>
          +41 (0)22 731 19 47
        </a>
        <p class="alt-cta__sign">Hacene Debbah, directeur et fondateur<br />Jeunesse&Co · Quai du Seujet 14 · 1201 Genève</p>
      </div>
    </div>
  </section>
</Layout>

