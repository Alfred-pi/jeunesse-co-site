---
import Layout from '../layouts/Layout.astro';
import AltitudeHero from '../components/altitude/AltitudeHero.astro';
import AltitudeCurve from '../components/altitude/AltitudeCurve.astro';
import AltitudeProfile from '../components/altitude/AltitudeProfile.astro';
import AltitudeAfter from '../components/altitude/AltitudeAfter.astro';
import AltitudeEvidence from '../components/altitude/AltitudeEvidence.astro';
import AltitudeWeek from '../components/altitude/AltitudeWeek.astro';
import AltitudeAdmission from '../components/altitude/AltitudeAdmission.astro';
import AltitudeCalendar from '../components/altitude/AltitudeCalendar.astro';
import AltitudeCta from '../components/altitude/AltitudeCta.astro';
import '../styles/altitude.scss';
import { Image } from 'astro:assets';
import altitudeLogo from '../assets/altitude/altitude-logo.png';
import ziadPhoto from '../assets/altitude/ziad-maalem-himalaya.jpg';
import krishnaPhoto from '../assets/altitude/krishna-kumar-magar.jpg';
import everestPhoto from '../assets/altitude/ziad-everest-sommet.jpg';
import leninePhoto from '../assets/altitude/ziad-pic-lenine-sommet.jpg';
import kiliPhoto from '../assets/altitude/ziad-kilimandjaro-sommet.jpg';
import khumbuPhoto from '../assets/altitude/ziad-khumbu-icefall.jpg';
import ogAltitude from '../assets/altitude/og-altitude.jpg';
const base = import.meta.env.BASE_URL;

// Contenu tiré du dossier « ALTITUDE, programme de remobilisation » (Jeunesse&Co, octobre 2026).

// Icônes au trait (24×24), dessinées à l'entrée dans l'écran (voir src/scripts/altitude-motion.ts).
const icons = {
  mountain: '<path d="m3 20 6.5-11 3.5 6 2.5-4L21 20z"/><path d="m7.6 12.2 1.9-1.2 1.6 1.4"/>',
  map: '<path d="M9 4 3 6.5v13.5l6-2.5 6 2.5 6-2.5V4l-6 2.5z"/><path d="M9 4v13.5"/><path d="M15 6.5V20"/>',
  briefcase: '<rect x="2.5" y="7" width="19" height="13" rx="2"/><path d="M8.5 7V5a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v2"/><path d="M2.5 13h19"/>',
  firstaid: '<rect x="3" y="3" width="18" height="18" rx="4"/><path d="M12 8v8"/><path d="M8 12h8"/>',
  sunrise: '<path d="M12 3v6"/><path d="m9 6 3-3 3 3"/><path d="M4.9 11.9 6.3 13.3"/><path d="M19.1 11.9 17.7 13.3"/><path d="M2 18h20"/><path d="M16 18a4 4 0 0 0-8 0"/>',
  route: '<circle cx="6" cy="19" r="2.5"/><path d="M8.5 19H17a3.5 3.5 0 0 0 0-7H7a3.5 3.5 0 0 1 0-7h8.5"/><circle cx="18" cy="5" r="2.5"/>',
  camera: '<path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3z"/><circle cx="12" cy="13" r="3.5"/>',
  fire: '<path d="M12 3c.5 3 4 4.5 4 9a4 4 0 0 1-8 0c0-2 1-3 2-4 0 1.5.8 2.5 2 2.5 0-3-1-5 0-7.5z"/><path d="M5 21h14"/>',
  stethoscope: '<path d="M5 3H4a1 1 0 0 0-1 1v5a5 5 0 0 0 10 0V4a1 1 0 0 0-1-1h-1"/><path d="M8 14v1a6 6 0 0 0 12 0v-3"/><circle cx="20" cy="10" r="2"/>',
  stairs: '<path d="M3 20h4v-4h4v-4h4V8h4V4h2"/>',
  pulse: '<path d="M2 12h4l3-8 4 16 3-8h6"/>',
  shield: '<path d="M12 21s8-3.8 8-10V5l-8-3-8 3v6c0 6.2 8 10 8 10z"/><path d="m8.5 11.5 2.5 2.5 4.5-4.5"/>',
  signal: '<path d="M5 19a10 10 0 0 1 0-14"/><path d="M8.5 15.5a5 5 0 0 1 0-7"/><circle cx="12" cy="12" r="1.5"/><path d="M15.5 8.5a5 5 0 0 1 0 7"/><path d="M19 5a10 10 0 0 1 0 14"/>',
  rules: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="m9 15 2 2 4-4"/>',
};

const facts = [
  { n: 5, unit: 'jeunes', text: 'de 15 à 18 ans, admis sur entretien' },
  { n: 40, unit: 'heures', text: 'par semaine de préparation à Genève' },
  { n: 60, unit: 'jours', text: 'au Népal, au printemps 2027' },
  { n: 3, unit: 'adultes', text: 'de Jeunesse&Co, du premier au dernier jour' },
  { n: 1, unit: 'projet', text: 'défini avant le départ : stage, apprentissage ou école' },
  { n: 6, unit: 'mois', text: 'd’accompagnement au minimum après le retour' },
];

const notThis = ['Une punition', 'Des vacances', 'Un exploit sportif', 'Une réponse clé en main'];

const temps = [
  { n: '01', name: 'Avant', verb: 'Se préparer', when: 'Jusqu’au départ · 40 h/sem.', items: ['Préparation physique', 'Construction du séjour', 'Projet post-séjour', 'Culture, santé, sécurité'] },
  { n: '02', name: 'Pendant', verb: 'Marcher', when: '60 jours au Népal', items: ['Trek progressif', 'Vie au camp de base', 'Vie de groupe', 'Carnet et film'] },
  { n: '03', name: 'Après', verb: 'Concrétiser', when: '6 mois minimum', items: ['Entrée dans le projet', 'Suivi individuel', 'Liens école / employeur', 'Restitution publique'] },
];

// Pourquoi « ALTITUDE » : une phrase par palier.
const climb = [
  'En montagne, on ne gagne pas de l’altitude d’un coup.',
  'On monte par paliers, on s’arrête pour s’acclimater, on repart.',
  'Le programme suit la même logique&nbsp;: préparer, progresser, consolider.',
  'Une fois gagnée, <em>l’altitude se garde</em>&nbsp;: c’est tout l’objet de l’après.',
];

const chantiers = [
  { icon: icons.mountain, title: 'Préparation physique', text: 'Salève, Jura puis Préalpes, jusqu’à une sortie test de plusieurs jours en cabane, sac complet.' },
  { icon: icons.map, title: 'Construire le séjour', text: 'Itinéraire, budget, matériel, logistique et règles de vie : les jeunes le préparent eux-mêmes.' },
  { icon: icons.briefcase, title: 'Projet post-séjour', text: 'Stages d’observation, candidatures, entretiens : une place confirmée avant le départ.' },
  { icon: icons.firstaid, title: 'Culture, santé, sécurité', text: 'Le Népal et ses usages, premiers secours, altitude, gestion de l’effort, prise de vue.' },
];

const nepal = ['L’altitude impose la progressivité', 'Un dépaysement complet, dans un cadre sûr', 'La sobriété, loin des écrans', 'La rencontre d’une autre culture de l’effort'];

const trekDay = [
  { icon: icons.sunrise, when: 'Réveil', text: 'Sac prêt, briefing du jour animé par un jeune avec le guide.' },
  { icon: icons.route, when: 'Marche', text: 'Cinq à sept heures. Le rythme est celui du plus lent.' },
  { icon: icons.camera, when: 'Après-midi', text: 'Repos, carnet de bord, tournage et montage.' },
  { icon: icons.fire, when: 'Soir', text: 'Cercle du soir : ce qui a été difficile, ce que j’ai réussi.' },
];

const roles = [
  { name: 'Guide du jour', text: 'Lit l’étape avec le guide népalais' },
  { name: 'Intendant', text: 'Eau, en-cas, matériel' },
  { name: 'Trésorier', text: 'Les dépenses dans les lodges' },
  { name: 'Reporter', text: 'Images et carnet de bord' },
  { name: 'Veilleur', text: 'Personne ne reste derrière' },
];

const ascents = ['Everest', 'Pic Lénine', 'Lobuche East', 'Kilimandjaro', 'Cervin', 'Mont Blanc'];

// Photos publiées par Ziad sur sa page « Objectif Everest ».
const summits = [
  { src: everestPhoto, place: 'Everest', height: '8’849 m', caption: 'Ziad au sommet de l’Everest, en combinaison d’altitude et masque à oxygène, drapeau suisse en main', position: '50% 30%' },
  { src: leninePhoto, place: 'Pic Lénine', height: '7’134 m', caption: 'Ziad au sommet du pic Lénine, sous les drapeaux de prières', position: '50% 40%' },
  { src: kiliPhoto, place: 'Kilimandjaro', height: '5’895 m', caption: 'Ziad devant le panneau du sommet du Kilimandjaro, Uhuru Peak', position: '45% 50%' },
  { src: khumbuPhoto, place: 'Cascade du Khumbu', height: 'voie de l’Everest', caption: 'Ziad casqué, encordé dans la cascade de glace du Khumbu', position: '70% 50%' },
];

const shifts = [
  { title: 'Géographique', text: 'Sortir de son territoire' },
  { title: 'De rôle', text: 'De jeune « suivi » à jeune acteur' },
  { title: 'De méthode', text: 'Du discours vers l’expérience' },
];

const safety = [
  { icon: icons.stethoscope, title: 'Bilan médical', text: 'À l’admission, avec consultation de médecine des voyages.' },
  { icon: icons.stairs, title: 'Progression par paliers', text: 'Au-dessus de 3’000\u00a0m, environ 400\u00a0m de gain entre deux nuits, deux journées d’acclimatation.' },
  { icon: icons.pulse, title: 'Contrôle quotidien', text: 'Saturation en oxygène et signes du mal des montagnes. Symptômes : descente, sans discussion.' },
  { icon: icons.shield, title: 'Assurance', text: 'Rapatriement et secours héliporté jusqu’à 5’500\u00a0m.' },
  { icon: icons.signal, title: 'Liaison permanente', text: 'Communicateur satellite. La direction joignable jour et nuit depuis Genève.' },
  { icon: icons.rules, title: 'Un cadre signé', text: 'Règles co-construites. Alcool et stupéfiants interdits pendant tout le séjour.' },
];

const svgIcon = (body: string) => `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${body}</svg>`;
---

<Layout
  title="Programme Altitude | Jeunesse & Co"
  description="ALTITUDE, programme de remobilisation de Jeunesse&Co : plusieurs mois de préparation à Genève, 60 jours au Népal au pied du Kanchenjunga, six mois d’accompagnement au retour."
  ogImage={ogAltitude}
>
  <AltitudeHero />

  <!-- EN BREF -->
  <section class="alt-brief" id="en-bref">
    <div class="container alt-brief__grid">
      <figure class="alt-brief__logo reveal">
        <Image src={altitudeLogo} alt="Logo du programme ALTITUDE : un sentier en pointillés monte vers un sommet sous le soleil" widths={[480, 960]} sizes="(max-width: 1024px) 80vw, 440px" />
        <figcaption>Construire un projet, le marcher, le faire tenir.</figcaption>
      </figure>
      <div>
        <div class="alt-head reveal">
          <span class="alt-kicker">En bref</span>
          <h2>Un projet collectif, <span class="alt-mark">pas une parenthèse</span></h2>
          <p class="alt-lead">Un programme intensif de remobilisation : plusieurs mois de préparation à Genève, un séjour de 60 jours au Népal, puis un accompagnement au retour. Tout le parcours est filmé : chaque jeune repart avec la vidéo de son propre chemin.</p>
        </div>
        <dl class="alt-facts" data-stagger>
          {facts.map((f) => (
            <div class="alt-facts__item">
              <dt><span class="alt-facts__n" data-count={f.n}>{f.n}</span><span class="alt-facts__unit">{f.unit}</span></dt>
              <dd>{f.text}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <!-- POSITION -->
  <section class="alt-position alt-dark">
    <div class="container">
      <div class="alt-head alt-head--split reveal">
        <div>
          <span class="alt-kicker">Notre position</span>
          <h2>Ni rupture, <span class="alt-mark">ni parenthèse</span></h2>
        </div>
        <p class="alt-lead">Les séjours « de rupture » ont montré leur intérêt et leur limite : ce qui se passe au retour. Avec ALTITUDE, le séjour est le milieu d’un parcours qui commence avant et se poursuit après.</p>
      </div>

      <AltitudeCurve />

      <div class="alt-not">
        <p class="alt-not__title reveal">Ce que le programme n’est pas</p>
        <ul data-strike>
          {notThis.map((n) => <li><span>{n}</span><i aria-hidden="true"></i></li>)}
        </ul>
        <p class="alt-not__note reveal">Les jeunes ne gravissent aucun sommet : le camp de base est un objectif symbolique, jamais une obligation.</p>
      </div>
    </div>
  </section>

  <!-- TROIS TEMPS -->
  <section class="alt-temps">
    <div class="container">
      <div class="alt-head alt-head--center reveal">
        <span class="alt-kicker">Architecture</span>
        <h2>Un programme en <span class="alt-mark">trois temps</span></h2>
        <p class="alt-lead">Les adultes qui préparent le jeune sont ceux qui partent avec lui et ceux qui l’accompagnent au retour. Il n’y a pas de passage de relais.</p>
      </div>

      <div class="alt-temps__rope">
        <span class="alt-temps__line" aria-hidden="true" data-grow-line></span>
        <ol>
          {temps.map((t, i) => (
            <li class:list={['alt-temps__step', { 'is-peak': i === 1 }]} data-stagger>
              <span class="alt-temps__node" aria-hidden="true">{t.n}</span>
              <p class="alt-temps__when">{t.when}</p>
              <h3><span>{t.name}</span> {t.verb}</h3>
              <ul>{t.items.map((it) => <li>{it}</li>)}</ul>
            </li>
          ))}
        </ol>
      </div>

      <div class="alt-why">
        <h3 class="alt-why__title reveal">Pourquoi « ALTITUDE »</h3>
        <!-- Escalier : les phrases montent par paliers, un sentier les relie jusqu'au drapeau. -->
        <div class="alt-climb" data-climb>
          {climb.map((c, i) => (
            <p class="alt-climb__text" style={`--k:${i + 1}`} data-climb-text>
              <b aria-hidden="true">{`0${i + 1}`}</b>
              <span set:html={c} />
            </p>
          ))}
          {climb.map((_, i) => (
            <span class="alt-climb__block" style={`--k:${i + 1}`} aria-hidden="true" data-climb-block>
              <b>{`0${i + 1}`}</b>
            </span>
          ))}
          <span class="alt-climb__track" aria-hidden="true" data-climb-track>
            {climb.map((_, i) => (
              <>
                <i class="alt-climb__seg alt-climb__seg--rise" style={`--k:${i + 1}`} data-climb-seg></i>
                <i class="alt-climb__seg alt-climb__seg--tread" style={`--k:${i + 1}`} data-climb-seg></i>
              </>
            ))}
            <span class="alt-climb__walker" data-climb-walker></span>
            <svg class="alt-climb__flag" viewBox="0 0 30 44" data-climb-flag>
              <path d="M3 44V3" stroke="#1A1A1A" stroke-width="3" stroke-linecap="round" />
              <path d="M4.5 3 28 10 4.5 17z" fill="#FFDF5C" stroke="#1A1A1A" stroke-width="1.5" stroke-linejoin="round" />
            </svg>
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- TEMPS 1 : AVANT -->
  <section class="alt-avant">
    <div class="container">
      <div class="alt-head alt-head--split reveal">
        <div>
          <span class="alt-kicker">Temps 1 · Avant</span>
          <h2>La préparation, <span class="alt-mark">40 h par semaine</span></h2>
        </div>
        <p class="alt-lead">Jusqu’au départ, les cinq jeunes sont engagés à plein temps. La préparation n’est pas une salle d’attente : c’est déjà le programme.</p>
      </div>

      <ul class="alt-tiles" data-stagger>
        {chantiers.map((c) => (
          <li>
            <span class="alt-tiles__icon" data-draw set:html={svgIcon(c.icon)} />
            <h3>{c.title}</h3>
            <p>{c.text}</p>
          </li>
        ))}
      </ul>

      <AltitudeWeek />
    </div>
  </section>

  <!-- TEMPS 2 : PENDANT -->
  <section class="alt-pendant alt-dark" id="sejour">
    <div class="container">
      <div class="alt-head alt-head--split reveal">
        <div>
          <span class="alt-kicker">Temps 2 · Pendant</span>
          <h2>Deux mois <span class="alt-mark">au Népal</span></h2>
        </div>
        <p class="alt-lead">Soixante jours au pied du Kanchenjunga, troisième sommet du monde. Pour avancer, il faut marcher ; pour se reposer, il faut être arrivé. Expédition organisée par l’agence népalaise Dream Peak Adventure.</p>
      </div>

      <ul class="alt-chips" data-stagger aria-label="Pourquoi le Népal">
        {nepal.map((n) => <li>{n}</li>)}
      </ul>

      <AltitudeProfile />

      <div class="alt-day">
        <h3 class="reveal">Une journée de trek</h3>
        <ol data-stagger>
          {trekDay.map((d) => (
            <li>
              <span class="alt-day__icon" data-draw set:html={svgIcon(d.icon)} />
              <strong>{d.when}</strong>
              <p>{d.text}</p>
            </li>
          ))}
        </ol>
      </div>

      <div class="alt-roles">
        <div class="alt-roles__head reveal">
          <h3>Des rôles tournants</h3>
          <p>Chaque jour, chaque jeune tient un rôle utile au groupe. Les rôles changent pour que chacun les exerce tous.</p>
        </div>
        <ul class="alt-roles__list" data-stagger>
          {roles.map((r, i) => <li><span class="alt-roles__n">0{i + 1}</span><strong>{r.name}</strong><span>{r.text}</span></li>)}
        </ul>
      </div>

      <p class="alt-letter reveal">Avant le départ, chaque jeune écrit <span class="alt-mark">une lettre à lui-même</span>, remise au retour.</p>
    </div>
  </section>

  <!-- TEMPS 3 : APRÈS -->
  <section class="alt-apres">
    <div class="container">
      <div class="alt-head alt-head--split reveal">
        <div>
          <span class="alt-kicker">Temps 3 · Après</span>
          <h2>Concrétiser <span class="alt-mark">et faire tenir</span></h2>
        </div>
        <p class="alt-lead">Le retour est le moment le plus fragile, celui que la plupart des séjours laissent de côté. Pour ALTITUDE, c’est là que tout se joue : chaque jeune a préparé la suite avant de partir.</p>
      </div>

      <AltitudeAfter />

      <blockquote class="alt-quote reveal">La cordée ne se défait pas <span>à l’aéroport.</span></blockquote>
    </div>
  </section>

  <!-- ÉQUIPE -->
  <section class="alt-team" id="equipe">
    <div class="container">
      <div class="alt-head reveal">
        <span class="alt-kicker">L’équipe sur le terrain</span>
        <h2>Les adultes qui partent <span class="alt-mark">sont ceux qui restent</span></h2>
      </div>

      <article class="alt-ziad">
        <figure class="alt-ziad__photo reveal">
          <Image src={ziadPhoto} alt="Ziad Maalem, sac au dos, souriant, devant les sommets enneigés de l’Himalaya" widths={[400, 576]} sizes="(max-width: 768px) 90vw, 440px" />
        </figure>
        <div class="alt-ziad__body" data-stagger>
          <p class="alt-ziad__role">Éducateur référent du programme</p>
          <h3>Ziad Maalem</h3>
          <p class="alt-ziad__job">Éducateur social, alpiniste et cuisinier</p>
          <p>Entre 15 et 18 ans, Ziad a vécu en foyer. C’est là qu’un éducateur l’a emmené pour la première fois en montagne. Il y a trouvé un endroit où relever des défis, et un adulte qui posait un cadre et lui faisait confiance. Cette rencontre l’a conduit à devenir éducateur, pour transmettre à son tour ce qu’il avait reçu.</p>
          <blockquote class="alt-ziad__quote">« La montagne m’a permis de découvrir mes capacités et d’envisager mon avenir autrement. »</blockquote>
          <p>Il accompagne les cinq jeunes de la préparation à Genève jusqu’au suivi au retour. Sur le terrain, son expérience de l’altitude sert la sécurité du groupe ; cuisinier, il associe les jeunes aux repas et à la vie du camp.</p>
          <ul class="alt-ziad__summits" aria-label="Ses ascensions">{ascents.map((a) => <li>{a}</li>)}</ul>
        </div>
      </article>

      <div class="alt-summits">
        <ul data-stagger>
          {summits.map((p) => (
            <li>
              <figure>
                <div class="alt-summits__frame">
                  <Image src={p.src} alt={p.caption} widths={[360, 720]} sizes="(max-width: 768px) 45vw, 300px" style={`object-position:${p.position}`} />
                </div>
                <figcaption><strong>{p.place}</strong> {p.height}</figcaption>
              </figure>
            </li>
          ))}
        </ul>
        <p class="alt-summits__credit">Photos : Ziad Maalem, page « Objectif Everest ».</p>
      </div>

      <ul class="alt-crew" data-stagger>
        <li>
          <img src={`${base}assets/intervenants/issa_dieng.jpeg`} alt="" width="96" height="96" loading="lazy" class="alt-crew__avatar alt-crew__avatar--issa" />
          <div>
            <h3>Issa Dieng</h3>
            <p class="alt-crew__role">Vidéaste, fondateur de Pacific Images</p>
            <p>Il filme le processus, pas l’exploit. Les jeunes filment, interviewent et montent avec lui : chacun repart avec le film de son parcours, présenté en public au retour.</p>
          </div>
        </li>
        <li>
          <Image src={krishnaPhoto} alt="" width={96} height={96} densities={[1, 2]} class="alt-crew__avatar" />
          <div>
            <h3>Krishna Kumar Magar</h3>
            <p class="alt-crew__role">Guide, cofondateur de Dream Peak Adventure</p>
            <p>Accompagnateur international en montagne certifié UIMLA. Il parle français : les jeunes échangent directement avec lui.</p>
          </div>
        </li>
        <li>
          <span class="alt-crew__avatar alt-crew__avatar--initials" aria-hidden="true">HD</span>
          <div>
            <h3>Hacene Debbah</h3>
            <p class="alt-crew__role">Directeur et fondateur de Jeunesse&Co</p>
            <p>Sur place les deux dernières semaines et pour le retour. Toute l’équipe rentre en Suisse avec le groupe.</p>
          </div>
        </li>
      </ul>
    </div>
  </section>

  <!-- FONDEMENTS + RECHERCHE -->
  <section class="alt-roots alt-dark">
    <div class="container">
      <div class="alt-head alt-head--split reveal">
        <div>
          <span class="alt-kicker">Fondements</span>
          <h2>Agir plutôt <span class="alt-mark">que discourir</span></h2>
        </div>
        <ol class="alt-shifts" data-stagger aria-label="Un triple déplacement">
          {shifts.map((s) => <li><strong>{s.title}</strong><span>{s.text}</span></li>)}
        </ol>
      </div>

      <blockquote class="alt-bigquote reveal">
        <p>« Il ne s’agit pas de transformer le jeune, mais de lui permettre de faire l’expérience, concrète et répétée, <span>qu’il est capable d’agir autrement.</span> »</p>
      </blockquote>

      <h3 class="alt-roots__sub reveal">Ce que dit la recherche</h3>
      <AltitudeEvidence />
    </div>
  </section>

  <!-- SÉCURITÉ -->
  <section class="alt-safety">
    <div class="container">
