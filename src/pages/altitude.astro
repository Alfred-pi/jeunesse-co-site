    letter-spacing: 0.12em;
    color: var(--color-text-muted);
  }

  // ---------- Position ----------
  .alt-position {
    background: var(--color-surface);
  }

  .alt-position__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 96px;
    align-items: center;

    > div { max-width: 600px; }

    @media (max-width: 1024px) {
      grid-template-columns: 1fr;
      gap: 56px;
    }
  }

  .alt-curve {
    margin: 0;
    background: var(--color-primary);
    border-radius: 28px;
    padding: 40px 40px 32px;
    color: var(--color-white);

    @media (max-width: 560px) {
      padding: 28px 20px 24px;
      border-radius: 20px;
    }

    figcaption p {
      font-size: var(--fs-xs);
      color: rgba(255, 255, 255, 0.5);
      margin-top: 12px;
    }
  }

  .alt-curve__plot {
    position: relative;
    height: clamp(200px, 22vw, 280px);
    padding-left: 28px;
    margin-bottom: 48px;

    svg {
      width: 100%;
      height: 100%;
      overflow: visible;
    }
  }

  .alt-curve__axis {
    position: absolute;
    left: 0;
    top: 50%;
    transform: translate(-50%, -50%) rotate(-90deg) translateY(10px);
    transform-origin: center;
    white-space: nowrap;
    font-size: var(--fs-xs);
    color: rgba(255, 255, 255, 0.45);
    letter-spacing: 0.04em;
    margin-left: 4px;
  }

  .alt-curve__sep { stroke: rgba(255, 255, 255, 0.1); stroke-width: 1; }
  .alt-curve__classic { fill: none; stroke: rgba(255, 255, 255, 0.45); stroke-width: 2; stroke-dasharray: 6 6; }
  .alt-curve__altitude { fill: none; stroke: var(--color-accent); stroke-width: 3; stroke-linecap: round; }

  .alt-curve__phases {
    position: absolute;
    left: 28px;
    right: 0;
    bottom: -32px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    text-align: center;
    font-size: var(--fs-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: rgba(255, 255, 255, 0.6);
  }

  .alt-curve__legend {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    font-size: var(--fs-xs);
    color: rgba(255, 255, 255, 0.85);

    li {
      display: inline-flex;
      align-items: center;
      gap: 10px;

      &::before {
        content: '';
        width: 24px;
        height: 0;
        border-top: 3px solid var(--color-accent);
      }

      &.is-classic::before { border-top: 2px dashed rgba(255, 255, 255, 0.55); }
    }
  }

  .alt-not {
    margin-top: 112px;
    padding-top: 48px;
    border-top: 1px solid var(--color-border);
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: 48px;

    @media (max-width: 1024px) {
      grid-template-columns: 1fr;
      gap: 32px;
      margin-top: 80px;
    }

    h3 {
      font-size: var(--fs-md);

      span { color: var(--color-text-muted); }
    }

    ul {
      list-style: none;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 32px 48px;

      @media (max-width: 640px) { grid-template-columns: 1fr; gap: 24px; }
    }

    li {
      display: flex;
      gap: 16px;
      align-items: flex-start;
    }

    p {
      color: var(--color-text-muted);

      strong {
        display: block;
        color: var(--color-text);
        font-size: var(--fs-base);
        margin-bottom: 4px;
      }
    }
  }

  .alt-not__x {
    flex: 0 0 auto;
    position: relative;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--color-primary);
    margin-top: -2px;

    &::before,
    &::after {
      content: '';
      position: absolute;
      left: 50%;
      top: 50%;
      width: 12px;
      height: 2px;
      background: var(--color-accent);
      transform: translate(-50%, -50%) rotate(45deg);
    }

    &::after { transform: translate(-50%, -50%) rotate(-45deg); }
  }

  // ---------- Trois temps ----------
  .alt-temps__rope {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    position: relative;
    counter-reset: none;

    &::before {
      content: '';
      position: absolute;
      top: 28px;
      left: 0;
      right: 0;
      border-top: 2px dashed rgba(255, 223, 92, 0.5);
    }

    @media (max-width: 900px) {
      grid-template-columns: 1fr;

      &::before {
        top: 0;
        bottom: 0;
        left: 27px;
        right: auto;
        border-top: 0;
        border-left: 2px dashed rgba(255, 223, 92, 0.5);
      }
    }
  }

  .alt-temps__step {
    position: relative;
    padding: 0 40px 0 0;

    @media (max-width: 900px) {
      padding: 0 0 48px 80px;
    }

    h3 {
      font-size: var(--fs-lg);
      line-height: 1;
      margin: 8px 0 24px;

      span {
        display: block;
        font-size: var(--fs-xs);
        font-family: var(--font-body);
        text-transform: uppercase;
        letter-spacing: 0.14em;
        color: var(--color-accent);
        margin-bottom: 12px;
      }
    }

    ul {
      list-style: none;
      margin-bottom: 24px;

      li {
        padding: 12px 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        color: rgba(255, 255, 255, 0.85);
        font-size: var(--fs-base);
      }
    }

    &.is-peak .alt-temps__node {
      background: var(--color-accent);
      color: var(--color-primary);
      transform: scale(1.15);
    }
  }

  .alt-temps__node {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--color-primary);
    border: 2px solid var(--color-accent);
    color: var(--color-accent);
    font-family: var(--font-headline);
    font-weight: 700;
    font-size: var(--fs-base);
    margin-bottom: 32px;

    @media (max-width: 900px) {
      position: absolute;
      left: 0;
      top: 0;
      margin: 0;
    }
  }

  .alt-temps__when {
    font-size: var(--fs-xs) !important;
    color: rgba(255, 255, 255, 0.55) !important;
    letter-spacing: 0.04em;
  }

  .alt-temps__goal {
    font-size: var(--fs-base);
    color: rgba(255, 255, 255, 0.65) !important;
  }

  .alt-temps__thread {
    max-width: 820px;
    margin: 72px 0 0;
    font-size: var(--fs-md);
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.82) !important;

    strong { color: var(--color-accent) !important; }
  }

  .alt-why {
    margin-top: 112px;
    padding-top: 56px;
    border-top: 1px solid rgba(255, 255, 255, 0.12);

    @media (max-width: 768px) { margin-top: 72px; }
  }

  .alt-why__title {
    font-size: var(--fs-xs);
    font-family: var(--font-body);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-accent) !important;
    margin-bottom: 32px;
  }

  // Les phrases montent par paliers, de gauche à droite, comme le programme.
  .alt-why__steps {
    --rise: 72px;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    align-items: start;
    font-family: var(--font-headline);
    font-weight: 700;
    font-size: clamp(19px, 1.75vw, 26px);
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--color-white) !important;

    span {
      position: relative;
      display: block;
      padding: 24px 32px 0 0;
      border-top: 2px solid rgba(255, 223, 92, 0.55);

      // contremarche : relie le palier au précédent
      & + span::before {
        content: '';
        position: absolute;
        left: -2px;
        top: -2px;
        height: calc(var(--rise) + 2px);
        border-left: 2px solid rgba(255, 223, 92, 0.55);
      }

      &:nth-child(1) { margin-top: calc(var(--rise) * 3); color: rgba(255, 255, 255, 0.5); }
      &:nth-child(2) { margin-top: calc(var(--rise) * 2); color: rgba(255, 255, 255, 0.65); }
      &:nth-child(3) { margin-top: var(--rise); color: rgba(255, 255, 255, 0.82); }
      &:nth-child(4) { border-top-color: var(--color-accent); }
    }

    em {
      font-style: normal;
      color: var(--color-accent);
    }

    @media (max-width: 900px) {
      grid-template-columns: 1fr;
      gap: 0;

      span {
        margin-top: 0 !important;
        padding: 16px 0 24px 0;

        &:nth-child(2) { margin-left: 8%; }
        &:nth-child(3) { margin-left: 16%; }
        &:nth-child(4) { margin-left: 24%; }
        & + span::before { display: none; }
      }
    }
  }

  // ---------- Avant ----------
  .alt-avant { background: var(--color-bg); }

  .alt-chantiers {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 56px 80px;

    @media (max-width: 768px) { grid-template-columns: 1fr; gap: 40px; }

    li {
      border-top: 2px solid var(--color-text);
      padding-top: 24px;
    }

    h3 { font-size: var(--fs-md); margin-bottom: 12px; }
    p { color: var(--color-text-muted); max-width: 52ch; }
  }

  .alt-chantiers__n {
    display: block;
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--color-text-muted);
    margin-bottom: 16px;
  }

  .alt-week {
    margin: 104px 0 0;

    @media (max-width: 768px) { margin-top: 72px; }

    figcaption {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: 8px;
      margin-bottom: 16px;
      font-size: var(--fs-base);

      span { color: var(--color-text-muted); font-size: var(--fs-xs); }
    }
  }

  .alt-week__bar {
    display: flex;
    height: 72px;
    border-radius: 16px;
    overflow: hidden;
    gap: 3px;
    background: var(--color-bg);

    @media (max-width: 560px) { height: 56px; border-radius: 12px; }
  }

  .alt-week__seg {
    flex-basis: 0;
    display: flex;
    align-items: center;
    padding: 0 16px;
    font-family: var(--font-headline);
    font-weight: 700;
    font-size: var(--fs-md);
    white-space: nowrap;
    min-width: 0;

    @media (max-width: 560px) {
      padding: 0 8px;
      font-size: var(--fs-xs);
      justify-content: center;
    }

    &--1 { background: var(--color-accent); color: var(--color-primary); }
    &--2 { background: var(--color-primary); color: var(--color-white); }
    &--3 { background: #4A4740; color: var(--color-white); }
    &--4 { background: #B8B0A3; color: var(--color-primary); }
    &--5 { background: #DDD6CA; color: var(--color-primary); }
  }

  .alt-week__legend {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 12px 32px;
    margin-top: 20px;
    font-size: var(--fs-xs);
    color: var(--color-text);

    li { display: inline-flex; align-items: center; gap: 10px; }
  }

  .alt-week__dot {
    width: 12px;
    height: 12px;
    border-radius: 4px;
    padding: 0;
  }

  .alt-departure {
    margin-top: 104px;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 80px;
    padding: 56px;
    border-radius: 28px;
    background: var(--color-surface);

    @media (max-width: 1024px) {
      grid-template-columns: 1fr;
      gap: 32px;
      padding: 40px 28px;
      margin-top: 72px;
    }

    h3 { font-size: var(--fs-lg); }
  }

  .alt-departure__note {
    margin-top: 16px;
    font-size: var(--fs-base);
    color: var(--color-text-muted);
  }

  .alt-checks {
    list-style: none;

    li {
      display: flex;
      gap: 16px;
      align-items: flex-start;
      padding: 16px 0;
      border-bottom: 1px solid var(--color-border);
      font-size: var(--fs-base);
      line-height: 1.5;

      &:first-child { padding-top: 0; }
      &:last-child { border-bottom: 0; }
    }
  }

  .alt-checks__icon {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--color-accent);
    color: var(--color-primary);
  }

  // ---------- Pendant ----------
  .alt-pendant__frame {
    max-width: 820px;
    margin: 72px 0 0;
    font-size: var(--fs-md);
    line-height: 1.5;
  }

  .alt-camp {
    margin-top: 104px;
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 96px;

    @media (max-width: 1024px) {
      grid-template-columns: 1fr;
      gap: 64px;
      margin-top: 80px;
    }

    h3 { font-size: var(--fs-lg); }
  }

  .alt-camp__intro { margin-bottom: 24px; }

  .alt-camp__life ul {
    list-style: none;

    li {
      padding: 16px 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      color: rgba(255, 255, 255, 0.72);
      font-size: var(--fs-base);
      line-height: 1.55;
    }
  }

  .alt-day {
    list-style: none;
    position: relative;
    padding-left: 28px;

    &::before {
      content: '';
      position: absolute;
      left: 5px;
      top: 8px;
      bottom: 8px;
      border-left: 2px solid rgba(255, 223, 92, 0.35);
    }

    li {
      position: relative;
      padding-bottom: 28px;

      &:last-child { padding-bottom: 0; }

      &::before {
        content: '';
        position: absolute;
        left: -28px;
        top: 6px;
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background: var(--color-accent);
      }
    }
  }

  .alt-day__when {
    display: block;
    font-family: var(--font-headline);
    font-weight: 700;
    font-size: var(--fs-md);
    color: var(--color-white);
    margin-bottom: 6px;
  }

  .alt-roles {
    margin-top: 104px;

    @media (max-width: 768px) { margin-top: 72px; }
  }

  .alt-roles__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px 48px;
    margin-bottom: 32px;

    h3 { font-size: var(--fs-lg); margin: 0; }
    p { max-width: 46ch; }
  }

  .alt-roles__list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 24px;
    overflow: hidden;

    @media (max-width: 1024px) { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    @media (max-width: 480px) { grid-template-columns: 1fr; }

    li {
      padding: 28px 24px;
      border-right: 1px solid rgba(255, 255, 255, 0.14);
      display: flex;
      flex-direction: column;
      gap: 8px;

      &:last-child { border-right: 0; }

      @media (max-width: 1024px) {
        border-bottom: 1px solid rgba(255, 255, 255, 0.14);

        &:nth-child(2n) { border-right: 0; }
      }

      @media (max-width: 480px) { border-right: 0; }
    }

    strong {
      font-family: var(--font-headline);
      font-size: var(--fs-md);
      color: var(--color-accent);
    }

    span {
      font-size: var(--fs-base);
      line-height: 1.5;
      color: rgba(255, 255, 255, 0.72);
    }
  }

  .alt-letter {
    margin-top: 96px;
    text-align: center !important;
    font-family: var(--font-headline);
    font-weight: 700;
    font-size: var(--fs-lg);
    line-height: 1.15;
    color: var(--color-white) !important;
    max-width: 30ch;
    margin-left: auto;
    margin-right: auto;
    text-wrap: balance;
  }

  // ---------- Après ----------
  .alt-apres { background: var(--color-bg); }

  .alt-apres__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 96px;
    align-items: start;

    @media (max-width: 1024px) { grid-template-columns: 1fr; gap: 56px; }
  }

  .alt-apres__intro {
    position: sticky;
    top: 140px;

    @media (max-width: 1024px) { position: static; }
  }

  .alt-quote {
    margin-top: 48px;
    padding: 32px 36px;
    border-radius: 24px;
    background: var(--color-accent);
    font-family: var(--font-headline);
    font-weight: 700;
    font-size: var(--fs-md);
    line-height: 1.2;
    color: var(--color-primary);
  }

  .alt-apres__title {
    font-size: var(--fs-md);
    margin-bottom: 32px;
  }

  .alt-rail {
    list-style: none;
    counter-reset: rail;

    li {
      counter-increment: rail;
      position: relative;
      padding: 0 0 36px 64px;

      &::before {
        content: counter(rail, decimal-leading-zero);
        position: absolute;
        left: 0;
        top: 0;
        width: 40px;
        height: 40px;
        display: grid;
        place-items: center;
        border-radius: 50%;
        border: 1.5px solid var(--color-text);
        font-size: var(--fs-xs);
        font-weight: 700;
        background: var(--color-bg);
        z-index: 1;
      }

      &::after {
        content: '';
        position: absolute;
        left: 20px;
        top: 40px;
        bottom: 0;
        border-left: 1.5px solid var(--color-border);
      }

      &:last-child {
        padding-bottom: 0;

        &::after { display: none; }
      }
    }

    h4 {
      font-family: var(--font-headline);
      font-size: var(--fs-md);
      margin: 6px 0 8px;
      line-height: 1.2;
    }

    p { color: var(--color-text-muted); }
  }

  // ---------- Film ----------
  .alt-film__grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 96px;
    align-items: start;

    @media (max-width: 1024px) { grid-template-columns: 1fr; gap: 56px; }
  }

  .alt-film__rights {
    margin-top: 32px;
    padding-top: 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    font-size: var(--fs-xs);
    color: rgba(255, 255, 255, 0.55) !important;
    line-height: 1.6;
  }

  .alt-film__points {
    padding: 40px;
    border-radius: 28px;
    border: 1px solid rgba(255, 255, 255, 0.14);

    @media (max-width: 560px) { padding: 28px 24px; }

    h3 { font-size: var(--fs-md); margin-bottom: 16px; }

    ul { list-style: none; }

    li {
      padding: 16px 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      font-size: var(--fs-base);
      line-height: 1.55;
      color: rgba(255, 255, 255, 0.72);

      &:last-child { border-bottom: 0; padding-bottom: 0; }

      strong { color: var(--color-accent); }
    }
  }

  // ---------- Équipe ----------
  .alt-team { background: var(--color-surface); }

  .alt-ziad {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 80px;
    align-items: start;

    @media (max-width: 1024px) { grid-template-columns: 1fr; gap: 40px; }
  }

  .alt-ziad__photo {
    margin: 0;
    position: sticky;
    top: 120px;
    border-radius: 28px;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: var(--color-border);

    :global(img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: 50% 42%;
      display: block;
    }

    @media (max-width: 1024px) {
      position: static;
      max-width: 520px;
    }
  }

  .alt-ziad__role {
    display: inline-block;
    padding: 6px 14px;
    border-radius: 100px;
    background: var(--color-primary);
    color: var(--color-accent) !important;
    font-size: var(--fs-xs) !important;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 20px !important;
  }

  .alt-ziad__body {
    h3 {
      font-size: var(--fs-xl);
      line-height: 0.95;
      letter-spacing: -0.03em;
      margin-bottom: 12px;
    }

    > p { max-width: 62ch; }
  }

  .alt-ziad__job {
    font-size: var(--fs-md) !important;
    color: var(--color-text-muted) !important;
    margin-bottom: 32px !important;
  }

  .alt-ziad__quote {
    margin: 32px 0;
    padding-left: 0;
    font-family: var(--font-headline);
    font-weight: 500;
    font-size: var(--fs-md);
    line-height: 1.35;
    color: var(--color-text);
    max-width: 40ch;
  }

  .alt-ziad__summits {
    margin-top: 40px;
    padding-top: 24px;
    border-top: 1px solid var(--color-border);

    p {
      font-size: var(--fs-xs);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--color-text-muted);
      margin-bottom: 16px;
    }

    ul {
      list-style: none;
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    li {
      padding: 8px 16px;
