<script>
  // Animations d'entrée communes à la page (les visuels ont leurs propres scripts).
  // Les états cachés ne sont posés qu'ici : sans JS ou avec reduced-motion, tout reste visible.
  const initMotion = async () => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const { gsap } = await import('gsap');
    const { ScrollTrigger } = await import('gsap/ScrollTrigger');
    const { prepareIcon, popDrawIcon } = await import('../scripts/altitude-motion');
    gsap.registerPlugin(ScrollTrigger);
    // Les mesures (compteurs, escalier) se font avec les polices définitives.
    await document.fonts.ready;

    const onEnter = (el: Element, play: () => void, start = 'top 82%') =>
      ScrollTrigger.create({ trigger: el, start, once: true, onEnter: play });

    document.querySelectorAll<HTMLElement>('[data-stagger]').forEach((group) => {
      const items = Array.from(group.children);
      gsap.set(items, { opacity: 0, y: 32 });
      onEnter(group, () => gsap.to(items, { opacity: 1, y: 0, duration: 0.9, ease: 'power3.out', stagger: 0.09 }));
    });

    // Icônes : la pastille rebondit puis le trait se dessine, juste après l'arrivée de sa carte.
    // Même déclencheur que la liste qui la porte, décalé de la position de la carte dans la liste.
    document.querySelectorAll<HTMLElement>('[data-draw]').forEach((icon) => {
      const strokes = prepareIcon(gsap, icon);
      const group = icon.closest<HTMLElement>('[data-stagger]');
      const card = group ? Array.from(group.children).find((c) => c.contains(icon)) : null;
      const index = card && group ? Array.from(group.children).indexOf(card) : 0;
      onEnter(group ?? icon, () => popDrawIcon(gsap, icon, strokes, 0.3 + index * 0.09));
    });

    // Chiffres clés de « En bref » seulement : le 76 % de la recherche a son propre compteur.
    document.querySelectorAll<HTMLElement>('.alt-facts [data-count]').forEach((el) => {
      const end = Number(el.dataset.count);
      const counter = { v: 0 };
      // Largeur de la valeur finale figée (en em, elle suit la taille fluide) : l'unité voisine ne bouge pas
      // pendant le comptage. League Spartan n'a pas de chiffres tabulaires, d'où la mesure.
      const fs = parseFloat(getComputedStyle(el).fontSize);
      el.style.display = 'inline-block';
      el.style.whiteSpace = 'nowrap';
      el.style.width = `${(el.getBoundingClientRect().width / fs).toFixed(3)}em`;
      el.textContent = '0';
      onEnter(el, () => gsap.to(counter, {
        v: end, duration: 1.6, ease: 'power2.out', delay: 0.2,
        onUpdate: () => { el.textContent = String(Math.round(counter.v)); },
      }));
    });

    document.querySelectorAll<HTMLElement>('[data-grow]').forEach((bar) => {
      const segs = Array.from(bar.children);
      gsap.set(segs, { scaleX: 0, transformOrigin: 'left center' });
      onEnter(bar, () => gsap.to(segs, { scaleX: 1, duration: 0.9, ease: 'expo.out', stagger: 0.12 }));
    });

    // Fil qui relie les étapes : horizontal sur grand écran, vertical sur mobile.
    document.querySelectorAll<HTMLElement>('[data-grow-line]').forEach((line) => {
      const vertical = line.offsetHeight > line.offsetWidth;
      gsap.set(line, vertical ? { scaleY: 0, transformOrigin: 'center top' } : { scaleX: 0, transformOrigin: 'left center' });
      onEnter(line.parentElement!, () => gsap.to(line, { scaleX: 1, scaleY: 1, duration: 1.8, ease: 'power2.inOut' }), 'top 75%');
    });

    // Escalier : les marches poussent, puis le marcheur suit le sentier ; chaque phrase apparaît à son palier.
    document.querySelectorAll<HTMLElement>('[data-climb]').forEach((climb) => {
      const blocks = climb.querySelectorAll('[data-climb-block]');
      const texts = Array.from(climb.querySelectorAll<HTMLElement>('[data-climb-text]'));
      const track = climb.querySelector<HTMLElement>('[data-climb-track]');
      if (!track) return;
      const segs = Array.from(track.querySelectorAll<HTMLElement>('[data-climb-seg]'));
      const walker = track.querySelector<HTMLElement>('[data-climb-walker]')!;
      const flag = track.querySelector('[data-climb-flag]');

      // Sommets du sentier en px, origine en bas à gauche de la piste. Recalculés à chaque image :
      // le marcheur reste collé aux pointillés même si la fenêtre change de taille.
      const points = () => {
        const cs = getComputedStyle(climb);
        const inset = parseFloat(cs.getPropertyValue('--inset'));
        const end = parseFloat(cs.getPropertyValue('--tread-end'));
        const w = track.clientWidth;
        const r = track.clientHeight / 4;
        const pts: [number, number][] = [[inset, 0]];
        for (let k = 1; k <= 4; k++) {
          pts.push([((k - 1) * w) / 4 + inset, k * r - inset]);
          pts.push([k === 4 ? w - end : (k * w) / 4 + inset, k * r - inset]);
        }
        return { pts, home: [w - end, 4 * r - inset] };
      };

      const walk = { d: 0 };
      let shown = 0;
      const draw = () => {
        const { pts, home } = points();
        const lens = pts.slice(1).map((p, i) => Math.hypot(p[0] - pts[i][0], p[1] - pts[i][1]));
        let rest = walk.d * lens.reduce((a, b) => a + b, 0);
        let pos = pts[0];
        lens.forEach((len, i) => {
          const f = Math.min(Math.max(rest / len, 0), 1);
          // Découpe plutôt qu'échelle : les pointillés gardent leur forme pendant le tracé.
          const hidden = `${((1 - f) * 100).toFixed(2)}%`;
          segs[i].style.clipPath = i % 2 ? `inset(-2px ${hidden} -2px 0)` : `inset(${hidden} -2px 0 -2px)`;
          if (rest >= 0) pos = [pts[i][0] + (pts[i + 1][0] - pts[i][0]) * f, pts[i][1] + (pts[i + 1][1] - pts[i][1]) * f];
          // Montée de la marche k terminée : sa phrase se pose.
          if (i % 2 === 0 && f >= 1 && shown <= i / 2) {
            gsap.to(texts[shown], { opacity: 1, y: 0, duration: 0.7, ease: 'power3.out' });
            shown++;
          }
          rest -= len;
        });
        walker.style.transform = `translate(${pos[0] - home[0]}px, ${home[1] - pos[1]}px)`;
      };

      gsap.set(blocks, { scaleY: 0 });
      gsap.set(texts, { opacity: 0, y: 20 });
      gsap.set(walker, { opacity: 0 });
      gsap.set(flag, { scale: 0 });
      draw();

      onEnter(climb, () => gsap.timeline()
        .to(blocks, { scaleY: 1, duration: 0.9, ease: 'power3.out', stagger: 0.12 })
        .to(walker, { opacity: 1, duration: 0.3 }, 0.55)
        .to(walk, {
          d: 1, duration: 3.4, ease: 'power1.inOut', onUpdate: draw,
          onComplete: () => {
            // Retour aux positions CSS finales : rien ne bouge ensuite au redimensionnement.
            segs.forEach((seg) => { seg.style.clipPath = ''; });
            walker.style.transform = '';
          },
        }, 0.7)
        .to(flag, { scale: 1, duration: 0.6, ease: 'back.out(2.2)' }, '-=0.2'), 'top 72%');
    });

    document.querySelectorAll<HTMLElement>('[data-strike]').forEach((list) => {
      const words = list.querySelectorAll('span');
      const lines = list.querySelectorAll('i');
      gsap.set(words, { opacity: 0, y: 24 });
      gsap.set(lines, { scaleX: 0, transformOrigin: 'left center' });
      onEnter(list, () => gsap.timeline()
        .to(words, { opacity: 1, y: 0, duration: 0.7, ease: 'power3.out', stagger: 0.12 })
        .to(lines, { scaleX: 1, duration: 0.5, ease: 'power2.inOut', stagger: 0.16 }, '-=0.2'));
    });
  };

  if (document.readyState === 'complete') initMotion();
  else window.addEventListener('load', initMotion, { once: true });
</script>

