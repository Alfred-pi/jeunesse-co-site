      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 40px;

      @media (max-width: 1024px) { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      @media (max-width: 480px) { grid-template-columns: 1fr; gap: 32px; }
    }

    strong {
      display: block;
      margin: 20px 0 8px;
      font-family: var(--font-headline);
      font-size: var(--fs-md);
      color: #F2F0EB;
    }
  }

  .alt-day__icon {
    display: grid;
    place-items: center;
    width: 72px;
