  }

  // ---------- Escalier « Pourquoi ALTITUDE » ----------
  // Une seule cellule de grille : phrases, marches et sentier s'y superposent.
  // Chaque phrase se pose sur sa marche (k × hauteur de marche), le sentier court dans la roche.
  .alt-climb {
    --rise: 72px;
    --inset: 18px;
    --tread-end: 40px;
    --dot: 6px;
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));

    @media (max-width: 900px) {
      --rise: 48px;
      --inset: 12px;
      --tread-end: 30px;
      --dot: 5px;
    }
  }

  .alt-climb__text {
    grid-row: 1;
    grid-column: var(--k);
    align-self: end;
    margin: 0 0 calc(var(--k) * var(--rise) + 24px);
    padding: 0 28px 0 var(--inset);
    font-family: var(--font-headline);
    font-weight: 700;
    font-size: clamp(19px, 1.7vw, 25px);
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--color-text) !important;

    b { display: none; }

    :global(em) {
      font-style: normal;
      background-image: linear-gradient(transparent 50%, rgba(255, 223, 92, 0.95) 50%, rgba(255, 223, 92, 0.95) 92%, transparent 92%);
      -webkit-box-decoration-break: clone;
      box-decoration-break: clone;
    }

    // Mobile : l'escalier passe en tête, les phrases en liste numérotée dessous.
    @media (max-width: 900px) {
      grid-row: calc(var(--k) + 1);
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: 44px minmax(0, 1fr);
      align-items: baseline;
      margin: 0;
      padding: 18px 0;
      border-bottom: 1px solid var(--color-border);
      font-size: 19px;

      &:nth-child(1) { margin-top: 24px; }

      b {
        display: block;
        font-size: var(--fs-base);
        color: var(--color-text-muted);
      }
    }
  }

  // Marches : teintes de nuit du logo, plus sombres à mesure qu'on monte, facette d'ombre à droite.
  .alt-climb__block {
    grid-row: 1;
    grid-column: var(--k);
    align-self: end;
    position: relative;
    height: calc(var(--k) * var(--rise));
    background:
      linear-gradient(104deg, transparent 0 62%, rgba(0, 0, 0, 0.22) 62%),
      var(--tone);
    transform-origin: 50% 100%;

    &:nth-of-type(1) { --tone: #52514E; }
    &:nth-of-type(2) { --tone: #3B3934; }
    &:nth-of-type(3) { --tone: #2F2D27; }
    &:nth-of-type(4) { --tone: #1B1B1A; }

    b {
      position: absolute;
      right: 14px;
      bottom: 10px;
      font-family: var(--font-headline);
      font-weight: 700;
      font-size: clamp(22px, 2.4vw, 34px);
      line-height: 1;
      color: rgba(242, 240, 235, 0.42);

      @media (max-width: 900px) {
        right: 8px;
        bottom: 6px;
        font-size: 16px;
      }
    }
  }

  // Sentier : pointillés jaunes, montée puis replat sur chaque marche, en retrait du bord.
  .alt-climb__track {
    grid-row: 1;
    grid-column: 1 / -1;
    align-self: end;
    position: relative;
    height: calc(4 * var(--rise));
    pointer-events: none;
  }

  .alt-climb__seg {
    position: absolute;
    --col: calc((var(--k) - 1) * 25%);

    &--rise {
      left: calc(var(--col) + var(--inset) - var(--dot) / 2);
      bottom: calc((var(--k) - 1) * 25% - var(--inset));
      width: var(--dot);
      height: 25%;
      background: radial-gradient(circle, var(--color-accent) 0 calc(var(--dot) / 2 - 0.5px), transparent calc(var(--dot) / 2)) 50% 100% / var(--dot) calc(var(--dot) * 2) repeat-y;

      // première montée : part du sol (le JS réécrit l'attribut style, d'où un sélecteur de position)
      &:first-child { bottom: 0; height: calc(25% - var(--inset)); }
    }

    &--tread {
      left: calc(var(--col) + var(--inset));
      bottom: calc(var(--k) * 25% - var(--inset) - var(--dot) / 2);
      width: 25%;
      height: var(--dot);
      background: radial-gradient(circle, var(--color-accent) 0 calc(var(--dot) / 2 - 0.5px), transparent calc(var(--dot) / 2)) 0 50% / calc(var(--dot) * 2) var(--dot) repeat-x;

      // dernier replat : s'arrête au pied du drapeau
      &:nth-child(8) { width: calc(25% - var(--inset) - var(--tread-end)); }
    }
  }

  // Le marcheur termine sa montée au pied du drapeau (position finale en CSS, sans JS).
  .alt-climb__walker {
    position: absolute;
    left: calc(100% - var(--tread-end));
    bottom: calc(100% - var(--inset));
    width: 18px;
    height: 18px;
    margin: 0 0 -9px -9px;
    border-radius: 50%;
    background: var(--color-accent);
    border: 3px solid #111;
    box-shadow: 0 0 0 5px rgba(255, 223, 92, 0.25), 0 0 22px 4px rgba(255, 223, 92, 0.45);
    z-index: 1;

    @media (max-width: 900px) {
      width: 14px;
      height: 14px;
      margin: 0 0 -7px -7px;
      border-width: 2px;
    }
  }

  .alt-climb__flag {
    position: absolute;
    right: 14px;
    bottom: 100%;
