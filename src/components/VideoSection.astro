---
import VideoPlayer from './VideoPlayer.astro';
const base = import.meta.env.BASE_URL;
---
<section class="video-section" id="video">
  <div class="container">
    <div class="video-wrapper">
      <VideoPlayer src="assets/teaser.mp4" poster="assets/teaser-poster.webp" label="Teaser Jeunesse & Co" />
    </div>

    <!-- CTA Button below video -->
    <div class="video-cta">
      <a href={`${base}impulsion`} class="btn btn--filled btn--cta">
        <span>Découvrir le Programme Impulsion</span>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </div>
</section>

<style lang="scss">
  .video-section {
    background: var(--color-primary);
    padding: 0 0 100px 0;
    position: relative;

    @media (max-width: 768px) {
      padding: 0 0 60px 0;
    }
  }

  .video-wrapper {
    max-width: 1100px;
    margin: 0 auto;
  }

  .video-cta {
    display: flex;
    justify-content: center;
    margin-top: 32px;

    @media (max-width: 768px) {
      margin-top: 24px;
    }
  }

  .btn--cta {
    padding: 18px 36px;
    font-size: 16px;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    border-radius: 100px;
    font-weight: 700;
    background: var(--color-accent);
    color: var(--color-primary);
    transition: all 0.3s ease;
    box-shadow: 0 8px 30px rgba(255, 223, 92, 0.25);

    &:hover {
      transform: translateY(-3px);
      box-shadow: 0 12px 40px rgba(255, 223, 92, 0.35);
    }

    svg {
      transition: transform 0.3s ease;
    }

    &:hover svg {
      transform: translateX(4px);
    }

    @media (max-width: 480px) {
      padding: 16px 28px;
      font-size: 14px;
    }
  }
</style>
