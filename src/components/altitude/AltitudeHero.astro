---
// Hero du programme ALTITUDE : paysage himalayen dans le style du logo
// (facettes plates, calottes de neige, soleil et arc jaunes, sentier en pointillés).
// Le sentier s'arrête au camp de base : les jeunes ne gravissent aucun sommet.

// Repère du dessin : 1440 × 480, sol à y = 492 (légèrement sous le cadre).
const W = 1440;
const H = 480;
const BASE = 492;

type Peak = { x: number; y: number; lw: number; rw: number; snow?: number };

const pt = (x: number, y: number) => `${x.toFixed(1)},${y.toFixed(1)}`;

// Point situé à la fraction t entre le sommet et un point du pied, u allant du pied gauche (0) au pied droit (1).
const onFace = (p: Peak, u: number, t: number) => {
  const footX = p.x - p.lw + u * (p.lw + p.rw);
  return pt(p.x + t * (footX - p.x), p.y + t * (BASE - p.y));
};

const shapes = (p: Peak) => {
  const ridgeU = (p.lw + p.rw * 0.16) / (p.lw + p.rw);
  const body = `M${pt(p.x, p.y)} L${pt(p.x - p.lw, BASE)} L${pt(p.x + p.rw, BASE)} Z`;
  const shade = `M${pt(p.x, p.y)} L${pt(p.x + p.rw * 0.16, BASE)} L${pt(p.x + p.rw, BASE)} Z`;
  if (!p.snow) return { body, shade };
  const t = p.snow;
  const snow = `M${pt(p.x, p.y)} L${onFace(p, 0, t)} L${onFace(p, 0.18, t * 0.66)} L${onFace(p, 0.34, t * 1.04)} L${onFace(p, ridgeU - 0.06, t * 0.62)} L${onFace(p, 0.72, t * 0.98)} L${onFace(p, 0.88, t * 0.68)} L${onFace(p, 1, t * 0.92)} Z`;
  const snowShade = `M${pt(p.x, p.y)} L${onFace(p, ridgeU, t * 0.7)} L${onFace(p, 0.72, t * 0.98)} L${onFace(p, 0.88, t * 0.68)} L${onFace(p, 1, t * 0.92)} Z`;
  return { body, shade, snow, snowShade };
};

// Couches, de la plus lointaine à la plus proche. Le tiers gauche reste bas pour laisser respirer le texte.
const layers = [
  {
    name: 'far',
    speed: 50,
    rise: 300,
    fill: '#3F3D38',
    shade: '#33322E',
    snowOpacity: 0.42,
    peaks: [
      { x: 70, y: 338, lw: 150, rw: 140 },
      { x: 250, y: 318, lw: 150, rw: 150 },
      { x: 450, y: 312, lw: 170, rw: 160 },
      { x: 640, y: 248, lw: 170, rw: 150, snow: 0.3 },
      { x: 790, y: 272, lw: 140, rw: 150, snow: 0.28 },
      { x: 1180, y: 236, lw: 150, rw: 130, snow: 0.3 },
      { x: 1300, y: 196, lw: 160, rw: 170, snow: 0.34 },
      { x: 1430, y: 250, lw: 140, rw: 160, snow: 0.3 },
    ] as Peak[],
  },
  {
    name: 'main',
    speed: 0,
    rise: 360,
    fill: '#4A4842',
    shade: '#2A2925',
    snowOpacity: 1,
    peaks: [
      { x: 1180, y: 232, lw: 150, rw: 170, snow: 0.32 },
      { x: 1010, y: 150, lw: 330, rw: 300, snow: 0.36 },
      { x: 1318, y: 282, lw: 150, rw: 170, snow: 0.26 },
    ] as Peak[],
  },
  {
    name: 'mid',
    speed: 0,
    rise: 160,
    fill: '#2F2D27',
    shade: '#242320',
    snowOpacity: 1,
    peaks: [
      { x: 150, y: 402, lw: 210, rw: 190 },
      { x: 390, y: 384, lw: 190, rw: 210 },
      { x: 640, y: 392, lw: 180, rw: 170 },
      { x: 1250, y: 356, lw: 200, rw: 210 },
      { x: 1440, y: 382, lw: 160, rw: 160 },
    ] as Peak[],
  },
  {
    name: 'near',
    speed: 0,
    rise: 150,
    fill: '#1B1B1A',
    shade: '#151514',
    snowOpacity: 1,
    peaks: [
      { x: 10, y: 438, lw: 230, rw: 230 },
      { x: 270, y: 456, lw: 210, rw: 220 },
      { x: 530, y: 444, lw: 220, rw: 200 },
      { x: 790, y: 454, lw: 210, rw: 230 },
      { x: 1070, y: 438, lw: 250, rw: 220 },
      { x: 1350, y: 448, lw: 220, rw: 230 },
    ] as Peak[],
  },
].map((layer) => ({ ...layer, shapes: layer.peaks.map(shapes) }));

const SUN = { x: 1010, y: 196, r: 98, arc: 140 };
const CAMP = { x: 902, y: 304 };

// Sentier : des contreforts en bas à gauche jusqu'au camp de base, avec deux lacets.
// Courbes de Bézier (C puis S), échantillonnées au build en points espacés de 13 unités :
// chaque point est un petit élément HTML qui rebondit à l'intro sans redessiner les montagnes.
type P = [number, number];
const trailStart: P = [330, 492];
const trailCurves: { c1?: P; c2: P; to: P }[] = [
  { c1: [362, 474], c2: [392, 462], to: [430, 458] },
  { c2: [508, 452], to: [548, 440] },
  { c2: [620, 414], to: [664, 404] },
  { c2: [736, 392], to: [770, 378] },
  { c2: [836, 366], to: [812, 350] },
  { c2: [842, 332], to: [872, 326] },
  { c2: [896, 314], to: [CAMP.x, CAMP.y] },
];
const cubic = (a: number, b: number, c: number, d: number, t: number) =>
  (1 - t) ** 3 * a + 3 * (1 - t) ** 2 * t * b + 3 * (1 - t) * t ** 2 * c + t ** 3 * d;
const trailLine: P[] = [trailStart];
{
  let from = trailStart;
  let prevC2 = trailStart;
  for (const seg of trailCurves) {
    // S : premier point de contrôle = reflet du précédent par rapport au point de départ.
    const c1: P = seg.c1 ?? [2 * from[0] - prevC2[0], 2 * from[1] - prevC2[1]];
    for (let i = 1; i <= 60; i++) {
      const t = i / 60;
      trailLine.push([cubic(from[0], c1[0], seg.c2[0], seg.to[0], t), cubic(from[1], c1[1], seg.c2[1], seg.to[1], t)]);
    }
    prevC2 = seg.c2;
    from = seg.to;
  }
}
const DOT_GAP = 13;
const trailDots: P[] = [];
{
  let walked = 0;
  let next = 0;
  for (let i = 1; i < trailLine.length; i++) {
    const [x0, y0] = trailLine[i - 1];
    const [x1, y1] = trailLine[i];
    const len = Math.hypot(x1 - x0, y1 - y0);
    while (next <= walked + len) {
      const f = (next - walked) / len;
      const dot: P = [x0 + (x1 - x0) * f, y0 + (y1 - y0) * f];
      // Les points sous le bord du cadre ne se verraient pas.
      if (dot[1] <= H - 2) trailDots.push(dot);
      next += DOT_GAP;
    }
    walked += len;
  }
}
const pctX = (x: number) => `${((x / W) * 100).toFixed(3)}%`;
const pctY = (y: number) => `${((y / H) * 100).toFixed(3)}%`;

// Camp de base : tente et drapeau dans une petite boîte de 64 × 44 unités, ancrée au camp.
const CAMP_BOX = { x: CAMP.x - 26, y: CAMP.y - 40, w: 64, h: 44 };

const letters = 'ALTITUDE'.split('');
---

<section class="hero" data-hero>
  <script is:inline>
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.documentElement.classList.add('hero-intro');
      setTimeout(function () { document.documentElement.classList.remove('hero-intro'); }, 4000);
    }
  </script>

  <div class="hero__land" aria-hidden="true">
    <div class="hero__art" data-hero-art>
      <!-- Un SVG par plan : chaque plan bouge en bloc (calque composité), sans redessiner les autres. -->
      <svg class="hero__svg hero__sun" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMax slice" focusable="false" data-hero-sun data-para="140">
        <defs>
          <radialGradient id="heroSunGlow" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#F8D541" stop-opacity="0.22" />
            <stop offset="100%" stop-color="#F8D541" stop-opacity="0" />
          </radialGradient>
        </defs>
        <circle cx={SUN.x} cy={SUN.y} r={SUN.r * 2.6} fill="url(#heroSunGlow)" />
        <circle cx={SUN.x} cy={SUN.y} r={SUN.r} fill="#F8D541" />
        <circle cx={SUN.x} cy={SUN.y} r={SUN.arc} fill="none" stroke="#F8D541" stroke-width="3" pathLength="1" stroke-dasharray="1 1" stroke-dashoffset="0" transform={`rotate(140 ${SUN.x} ${SUN.y})`} data-hero-arc />
      </svg>

      {layers.map((layer) => (
        <svg class={`hero__svg hero__layer hero__layer--${layer.name}`} viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMax slice" focusable="false" data-hero-layer data-rise={layer.rise} data-para={layer.speed}>
          {layer.shapes.map((s) => (
            <g>
              <path d={s.body} fill={layer.fill} />
              <path d={s.shade} fill={layer.shade} />
              {s.snow && (
                <g opacity={layer.snowOpacity}>
                  <path d={s.snow} fill="#F2F0EB" />
                  <path d={s.snowShade} fill="#C9C5BC" />
                </g>
              )}
            </g>
          ))}
        </svg>
      ))}

      <div class="hero__trail">
        {trailDots.map(([x, y]) => <i class="hero__dot" style={`left:${pctX(x)};top:${pctY(y)}`} data-hero-dot></i>)}
      </div>

      <svg class="hero__camp" viewBox={`0 0 ${CAMP_BOX.w} ${CAMP_BOX.h}`} style={`left:${pctX(CAMP_BOX.x)};top:${pctY(CAMP_BOX.y)};width:${pctX(CAMP_BOX.w)}`} focusable="false">
        <g data-hero-tent>
          <path d="M4,41 L15,24 L26,41 Z" fill="#F2F0EB" />
          <path d="M15,24 L19,41 L26,41 Z" fill="#C9C5BC" />
        </g>
        <line x1="34" y1="41" x2="34" y2="6" stroke="#F2F0EB" stroke-width="2.5" stroke-linecap="round" data-hero-pole />
        <path d="M35,6 L58,13 L35,20 Z" fill="#F8D541" data-hero-pennant />
      </svg>

      <div class="hero__tags">
        <span class="hero__pin hero__pin--summit" style={`left:${pctX(SUN.x + SUN.arc + 14)};top:${pctY(SUN.y - 70)}`}>
          <span class="hero__tag" data-hero-tag><strong>Kanchenjunga</strong> 8’586&nbsp;m</span>
        </span>
        <span class="hero__pin hero__pin--camp" style={`right:${((1 - (CAMP.x - 34) / W) * 100).toFixed(3)}%;top:${pctY(CAMP.y - 30)}`}>
          <span class="hero__tag" data-hero-tag><strong>Camp de base</strong> 5’475&nbsp;m</span>
        </span>
      </div>
    </div>
  </div>

  <div class="container hero__content" data-hero-content>
    <span class="hero__pill" data-hero-fade>Nouveau programme de remobilisation</span>

    <div class="hero__lockup">
      <h1 class="hero__title" aria-label="ALTITUDE">
        <span class="hero__word" aria-hidden="true">
          {letters.map((l) => <span class="hero__letter" data-hero-letter>{l}</span>)}
        </span>
      </h1>
      <p class="hero__rule">
        <span class="hero__rule-line hero__rule-line--left" data-hero-line></span>
        <span class="hero__rule-text" data-hero-ruletext>Avant · Pendant · Après</span>
        <span class="hero__rule-line hero__rule-line--right" data-hero-line></span>
      </p>
    </div>

    <p class="hero__claim" data-hero-fade>Construire un projet, le marcher, <span>le faire tenir.</span></p>
    <p class="hero__lead" data-hero-fade>Cinq jeunes, plusieurs mois de préparation à Genève, soixante jours au Népal, six mois d’accompagnement au retour.</p>
    <ul class="hero__meta" aria-label="En un coup d’œil" data-hero-fade>
      <li>Népal</li>
      <li>Kanchenjunga</li>
      <li>Printemps 2027</li>
    </ul>
    <div class="hero__actions" data-hero-fade>
      <a href="#orienter" class="hero__btn hero__btn--accent">
        Orienter un jeune
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
      </a>
      <a href="#en-bref" class="hero__btn hero__btn--ghost">Découvrir le programme</a>
    </div>
  </div>
</section>

<script>
  const run = () => {
    const hero = document.querySelector<HTMLElement>('[data-hero]');
    const root = document.documentElement;
    if (!hero) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      root.classList.remove('hero-intro');
      return;
    }

    Promise.all([import('gsap'), import('gsap/ScrollTrigger')])
      .then(([{ gsap }, { ScrollTrigger }]) => {
        gsap.registerPlugin(ScrollTrigger);

        const q = (sel: string) => Array.from(hero.querySelectorAll<Element>(sel));
        const art = hero.querySelector<HTMLElement>('[data-hero-art]')!;
        const sun = q('[data-hero-sun]');
        const arc = q('[data-hero-arc]');
        const layers = q('[data-hero-layer]');
        const letters = q('[data-hero-letter]');
        const lines = q('[data-hero-line]');
        const ruleText = q('[data-hero-ruletext]');
        const fades = q('[data-hero-fade]');
        const dots = q('[data-hero-dot]');
        const tent = q('[data-hero-tent]');
        const pole = q('[data-hero-pole]');
        const pennant = q('[data-hero-pennant]');
        const tags = q('[data-hero-tag]');

        // Si le délai de secours a déjà révélé le hero (chargement lent), on saute l'intro.
        const intro = root.classList.contains('hero-intro');

        // États de départ posés par le JS seulement : sans JS, tout reste visible.
        // Plans, points et libellés bougent en transform/opacité : le navigateur les compose sans repeindre.
        if (intro) {
          gsap.set(sun, { yPercent: 24, opacity: 0 });
          gsap.set(arc, { strokeDashoffset: 1 });
          // Les plans montent opaques depuis sous le cadre : le soleil ne transparaît jamais à travers.
          gsap.set(layers, { yPercent: (i: number, el: Element) => (Number(el.getAttribute('data-rise') ?? 200) / 480) * 100 });
          gsap.set(letters, { yPercent: 160 });
          gsap.set(lines, { scaleX: 0 });
          gsap.set(ruleText, { opacity: 0, y: 8 });
          gsap.set(fades, { opacity: 0, y: 22 });
          gsap.set(dots, { scale: 0 });
          gsap.set(tent, { scale: 0, transformOrigin: '50% 100%' });
          gsap.set(pole, { scaleY: 0, transformOrigin: '50% 100%' });
          gsap.set(pennant, { scaleX: 0, transformOrigin: '0% 50%' });
          gsap.set(tags, { opacity: 0, scale: 0.6, y: 10 });
          root.classList.remove('hero-intro');

          // Léger délai : l'intro démarre après l'initialisation des autres visuels de la page,
          // qui occupe les premières images après le chargement.
          const tl = gsap.timeline({ delay: 0.4, defaults: { ease: 'power3.out' } });
          tl.to(fades[0], { opacity: 1, y: 0, duration: 0.6 }, 0)
            .to(sun, { yPercent: 0, opacity: 1, duration: 1.6, ease: 'expo.out' }, 0)
            .to(arc, { strokeDashoffset: 0, duration: 1.4, ease: 'power2.inOut' }, 0.25)
            .to(layers, { yPercent: 0, duration: 1.5, stagger: 0.14, ease: 'power4.out' }, 0.1)
            .to(letters, { yPercent: 0, duration: 0.9, stagger: 0.045, ease: 'expo.out' }, 0.15)
            .to(lines, { scaleX: 1, duration: 0.8, ease: 'expo.out' }, 0.6)
            .to(ruleText, { opacity: 1, y: 0, duration: 0.6 }, 0.7)
            .to(fades.slice(1), { opacity: 1, y: 0, duration: 0.8, stagger: 0.08 }, 0.8)
            // Le sentier : les points rebondissent l'un après l'autre jusqu'au camp.
            .to(dots, { scale: 1, duration: 0.55, ease: 'back.out(4)', stagger: 0.02 }, 1.05)
            // Puis la tente surgit, le mât se plante et le fanion se déroule.
            .to(tent, { scale: 1, duration: 0.6, ease: 'back.out(3)' }, '-=0.25')
            .to(pole, { scaleY: 1, duration: 0.5, ease: 'back.out(2.4)' }, '-=0.35')
            .to(pennant, { scaleX: 1, duration: 1.1, ease: 'elastic.out(1.1, 0.4)' }, '-=0.2')
            .to(tags, { opacity: 1, scale: 1, y: 0, duration: 0.7, ease: 'back.out(2.2)', stagger: 0.12 }, '-=1');
        }

        // Parallaxe : le soleil se couche derrière le sommet, la chaîne du fond descend un peu, le texte remonte.
        // Le paysage qui porte le sentier, le camp et les libellés reste d'un seul bloc : aucun décalage entre eux.
        // Décalage en px recalculé au redimensionnement (unités du dessin × échelle) ; l'intro, elle, joue sur yPercent.
        const scrub = { trigger: hero, start: 'top top', end: 'bottom top', scrub: 0.6, invalidateOnRefresh: true };
        q('[data-para]').forEach((el) => {
          const speed = Number(el.getAttribute('data-para'));
          if (speed) gsap.to(el, { y: () => (speed / 480) * art.clientHeight, ease: 'none', scrollTrigger: scrub });
        });
        gsap.to(hero.querySelector('[data-hero-content]'), { y: -90, ease: 'none', scrollTrigger: scrub });
      })
      .catch(() => root.classList.remove('hero-intro'));
  };

  if (document.readyState === 'complete') run();
  else window.addEventListener('load', run, { once: true });
</script>

<style lang="scss">
  $ease: cubic-bezier(0.16, 1, 0.3, 1);

  .hero {
    // Hauteur du paysage : un tiers de la largeur sur grand écran, plafonnée.
    --land-h: min(33.333vw, 640px);
    position: relative;
    overflow: hidden;
    min-height: min(100svh, 1000px);
    padding: 150px 0 calc(var(--land-h) * 0.44);
    background: #111111;
    color: #F2F0EB;

    @media (max-width: 1024px) {
      padding-top: 132px;
    }

    // Sous 960 px, le dessin garde 960 × 320 px : on lui laisse 60 px de ciel pour le libellé du sommet.
    @media (max-width: 960px) {
      --land-h: 380px;
      padding-bottom: calc(var(--land-h) * 0.5);
    }

    // Le texte s'arrête au-dessus du ciel réservé : rien ne chevauche le libellé du sommet.
    @media (max-width: 640px) {
      padding: 120px 0 calc(var(--land-h) + 16px);
    }
  }

  // Masquage avant l'intro (classe posée par le script inline, retirée par le JS ou après 4 s).
  :global(html.hero-intro) .hero [data-hero-fade],
  :global(html.hero-intro) .hero [data-hero-letter],
  :global(html.hero-intro) .hero [data-hero-line],
  :global(html.hero-intro) .hero [data-hero-ruletext],
  :global(html.hero-intro) .hero [data-hero-layer],
  :global(html.hero-intro) .hero [data-hero-sun],
  :global(html.hero-intro) .hero [data-hero-dot],
  :global(html.hero-intro) .hero .hero__camp,
  :global(html.hero-intro) .hero [data-hero-tag] {
    opacity: 0;
  }

  // ---------- Paysage ----------
  .hero__land {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: var(--land-h);
    overflow: hidden;
    pointer-events: none;
  }

  .hero__art {
    position: absolute;
    bottom: 0;
    left: 50%;
    width: max(100%, 960px);
    aspect-ratio: 3 / 1;
    transform: translateX(-50%);

    // Sur mobile, on cadre le Kanchenjunga et le camp de base.
    @media (max-width: 640px) {
      width: 960px;
      transform: translateX(calc(-50% - 150px));
    }
  }

  .hero__svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  // Sentier : points de 6 unités du dessin, positionnés en % du dessin (même repère que le viewBox).
  .hero__trail {
    position: absolute;
    inset: 0;
  }

  .hero__dot {
    position: absolute;
    width: calc(6 / 1440 * 100%);
    aspect-ratio: 1;
    // marges en % de la largeur dans les deux sens : le point reste centré sur sa position
    margin: calc(-3 / 1440 * 100%) 0 0 calc(-3 / 1440 * 100%);
    border-radius: 50%;
    background: #F8D541;
  }

  .hero__camp {
    position: absolute;
    height: auto;
    aspect-ratio: 64 / 44;
    overflow: visible;
  }

  .hero__tags {
    position: absolute;
    inset: 0;
  }

  // Le conteneur porte la position (jamais animé), la pastille à l'intérieur porte l'animation.
  .hero__pin {
    position: absolute;
    display: flex;
  }

  // Pastille sombre : le libellé reste lisible sur la neige comme sur la roche.
  .hero__tag {
    white-space: nowrap;
    display: flex;
    flex-direction: column;
    gap: 1px;
    padding: 7px 12px 6px;
    border-radius: 12px;
    line-height: 1.2;
    background: rgba(17, 17, 17, 0.78);
    border: 1px solid rgba(248, 213, 65, 0.35);
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: rgba(242, 240, 235, 0.72);
    font-variant-numeric: tabular-nums;

    strong {
      font-family: var(--font-headline);
      font-weight: 700;
      font-size: 16px;
      color: #F2F0EB;
    }

    @media (max-width: 640px) {
      font-size: 14px;

      strong { font-size: 15px; }
    }
  }

  // Dès que le paysage est rogné (fenêtre < 960 px), le libellé du sommet se centre au-dessus de l'arc,
  // dans le ciel réservé : il reste dans l'écran sans masquer l'arc.
  .hero__pin--summit {
    @media (max-width: 960px) {
      left: 70.14% !important; // SUN.x / W
      top: -16% !important;
      transform: translateX(-50%);

      .hero__tag { align-items: center; }
    }
  }

  .hero__pin--camp .hero__tag {
    text-align: right;

    strong { color: #F8D541; }
  }

  // ---------- Texte ----------
  .hero__content {
    position: relative;
    z-index: 1;
  }

  .hero__pill {
    display: inline-block;
    padding: 8px 16px;
