---
// Schéma illustratif « Ni rupture, ni parenthèse » (dossier ALTITUDE, p. 3).
// Il ne représente pas des données mesurées : intention du programme uniquement.
// Dessin dans le style du logo : arêtes droites, sommet pointu, facettes et calotte de neige crénelée.
const W = 300;
const H = 160;

type Pt = [number, number];

// ALTITUDE : montée par paliers pendant la préparation, sommet au Népal, col au retour, puis l'arête se maintient haut.
const altitudePts: Pt[] = [
  [0, 138], [28, 122], [40, 122], [66, 100], [78, 100], [100, 82],
  [150, 22],
  [200, 58], [230, 40], [244, 47], [268, 36], [300, 36],
];
// Séjour classique : plat avant, pic pendant le séjour, chute au retour jusqu'au point de départ.
const classicPts: Pt[] = [[0, 138], [95, 136], [148, 56], [204, 134], [300, 136]];

const toPath = (pts: Pt[]) => 'M' + pts.map(([x, y]) => `${x},${y}`).join(' L');
const fmt = (pts: Pt[]) => pts.map(([x, y]) => `${x.toFixed(2)},${y.toFixed(2)}`).join(' ');
const altitudeLine = toPath(altitudePts);
const altitudeArea = `${altitudeLine} L${W},${H} L0,${H} Z`;
const classicLine = toPath(classicPts);

// Ordonnée de l'arête ALTITUDE pour une abscisse donnée (interpolation linéaire).
const yAt = (x: number) => {
  for (let i = 1; i < altitudePts.length; i++) {
    const [x0, y0] = altitudePts[i - 1];
    const [x1, y1] = altitudePts[i];
    if (x <= x1) return y0 + ((y1 - y0) * (x - x0)) / (x1 - x0);
  }
  return altitudePts[altitudePts.length - 1][1];
};

// Calotte de neige : l'arête depuis la ligne de neige jusqu'au sommet, le bas en dents de scie.
const snowCap = (peakIndex: number, level: number, teeth: number[]) => {
  const pts = altitudePts;
  const cross = (a: Pt, b: Pt) => a[0] + ((level - a[1]) * (b[0] - a[0])) / (b[1] - a[1]);
  let l = peakIndex;
  while (l > 0 && pts[l - 1][1] < level) l--;
  let r = peakIndex;
  while (r < pts.length - 1 && pts[r + 1][1] < level) r++;
  const xL = cross(pts[l - 1], pts[l]);
  const xR = cross(pts[r], pts[r + 1]);
  const ridge: Pt[] = [[xL, level], ...pts.slice(l, r + 1), [xR, level]];
  const bottom: Pt[] = teeth.map((d, k) => {
    const x = xR - ((k + 1) / (teeth.length + 1)) * (xR - xL);
    return [x, Math.max(level + d, yAt(x) + 2.5)];
  });
  const [px] = pts[peakIndex];
  // Versant à l'ombre de la calotte : tout ce qui est à droite du sommet.
  const shade: Pt[] = [pts[peakIndex], ...ridge.filter(([x]) => x > px), ...bottom.filter(([x]) => x > px + 1)];
  return { at: px, snow: fmt([...ridge, ...bottom]), shade: fmt(shade) };
};
const caps = [
  { ...snowCap(6, 44, [5, -3, 6, -2, 5, -3, 4]), opacity: 0.94 },
  { ...snowCap(8, 45, [4, -1, 4]), opacity: 0.8 },
];

// Facettes (clipées par l'aire) : une arête descend de chaque sommet ; versant éclairé à gauche, à l'ombre à droite.
const litFaces = [
  { points: '150,22 58,160 156,160', opacity: 0.08 },
  { points: '100,82 52,160 104,160', opacity: 0.04 },
];
const shadeFaces = [
  { points: '150,22 156,160 214,160 200,58', opacity: 0.32 },
  { points: '230,40 236,160 256,160 244,47', opacity: 0.24 },
  { points: '268,36 276,160 300,160 300,36', opacity: 0.2 },
];

const endY = altitudePts[altitudePts.length - 1][1];
const classicEndY = classicPts[classicPts.length - 1][1];
const pct = (v: number, max: number) => `${((v / max) * 100).toFixed(3)}%`;
const zones = [
  { name: 'Avant', sub: 'Préparation à Genève' },
  { name: 'Pendant', sub: '60 jours au Népal' },
  { name: 'Après', sub: '6 mois au minimum' },
];
---

<figure class="curve" data-curve data-curve-points={JSON.stringify(altitudePts)} style={`--end-y:${pct(endY, H)}`}>
  <div class="curve__frame">
    <span class="curve__axis-title" aria-hidden="true"><span>Mobilisation du jeune</span></span>

    <div class="curve__plot" data-curve-plot role="img" aria-label="Schéma illustratif : la mobilisation d’un jeune dans un séjour classique monte pendant le séjour puis retombe au retour ; avec ALTITUDE, elle monte par paliers dès la préparation, culmine pendant le séjour et se maintient après le retour.">
      <div class="curve__zones" aria-hidden="true">
        {zones.map((_, i) => <span class:list={['curve__zone', { 'is-peak': i === 1 }]} data-curve-zone></span>)}
      </div>

      <div class="curve__layer" data-curve-classic aria-hidden="true">
        <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none">
          <path d={classicLine} class="curve__classic" vector-effect="non-scaling-stroke" />
        </svg>
      </div>

      <div class="curve__layer curve__layer--altitude" data-curve-altitude aria-hidden="true">
        <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none">
          <defs>
            <clipPath id="curveSlope">
              <path d={altitudeArea} />
            </clipPath>
            <linearGradient id="curveFill" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#FFDF5C" stop-opacity="0.26" />
              <stop offset="70%" stop-color="#FFDF5C" stop-opacity="0.04" />
              <stop offset="100%" stop-color="#FFDF5C" stop-opacity="0" />
            </linearGradient>
          </defs>
          <g clip-path="url(#curveSlope)">
            <rect x="0" y="0" width={W} height={H} fill="url(#curveFill)" />
            {litFaces.map((f) => <polygon points={f.points} fill="#FFDF5C" fill-opacity={f.opacity} />)}
            {shadeFaces.map((f) => <polygon points={f.points} fill="#000" fill-opacity={f.opacity} />)}
          </g>
          {caps.map((c) => (
            <g data-curve-snow data-at={c.at} opacity={c.opacity}>
              <polygon points={c.snow} fill="#F2F0EB" />
              <polygon points={c.shade} fill="#C9C5BC" />
            </g>
          ))}
          <path d={altitudeLine} class="curve__altitude" vector-effect="non-scaling-stroke" />
        </svg>
      </div>

      <span class="curve__dot" data-curve-dot aria-hidden="true"></span>

      <span class="curve__end curve__end--altitude" style={`top:${pct(endY, H)}`} aria-hidden="true">
        <span data-curve-label>ALTITUDE : l’élan se garde</span>
      </span>
      <span class="curve__end curve__end--classic" style={`top:${pct(classicEndY, H)}`} aria-hidden="true">
        <span data-curve-label-classic>Séjour classique : <span class="curve__nowrap">retour au point de départ</span></span>
      </span>
    </div>

    <ol class="curve__names">
      {zones.map((z) => (
        <li data-curve-name>
          <strong>{z.name}</strong>
          <span>{z.sub}</span>
        </li>
      ))}
    </ol>
  </div>

  <figcaption class="curve__caption" data-curve-caption>
    <ul class="curve__legend">
      <li class="is-altitude">Programme ALTITUDE</li>
      <li class="is-classic">Séjour « de rupture » classique</li>
    </ul>
    <p>Schéma illustratif de l’intention du programme. Il ne représente pas des données mesurées.</p>
  </figcaption>
</figure>

<script>
  const initCurve = () => {
    const fig = document.querySelector<HTMLElement>('[data-curve]');
    if (!fig || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    import('gsap').then(({ gsap }) => {
      import('gsap/ScrollTrigger').then(({ ScrollTrigger }) => {
        gsap.registerPlugin(ScrollTrigger);

        const plot = fig.querySelector<HTMLElement>('[data-curve-plot]')!;
        const classic = fig.querySelector<HTMLElement>('[data-curve-classic]')!;
        const altitude = fig.querySelector<HTMLElement>('[data-curve-altitude]')!;
        const dot = fig.querySelector<HTMLElement>('[data-curve-dot]')!;
        const snows = Array.from(fig.querySelectorAll<SVGGElement>('[data-curve-snow]'));
        const zones = fig.querySelectorAll('[data-curve-zone]');
        const names = fig.querySelectorAll('[data-curve-name]');
        const label = fig.querySelector('[data-curve-label]');
        const labelClassic = fig.querySelector('[data-curve-label-classic]');
        const caption = fig.querySelector('[data-curve-caption]');

        // Arête ALTITUDE en unités du viewBox 300 x 160 : la polyligne permet un calcul exact.
        const pts: [number, number][] = JSON.parse(fig.dataset.curvePoints || '[]');
        const endY = pts[pts.length - 1][1];
        const yAt = (x: number) => {
          for (let i = 1; i < pts.length; i++) {
            const [x0, y0] = pts[i - 1];
            const [x1, y1] = pts[i];
            if (x <= x1) return y0 + ((y1 - y0) * (x - x0)) / (x1 - x0);
          }
          return endY;
        };

        const reveal = (el: HTMLElement, p: number) => {
          el.style.clipPath = `inset(-20% ${(100 - p * 100).toFixed(3)}% -20% -2%)`;
        };
        // Le point est posé en CSS au bout de l'arête ; pendant la montée on le décale depuis cette position.
        // Les dimensions sont relues à chaque image : un redimensionnement en cours d'animation ne crée aucun décalage.
        const placeDot = (x: number) => {
          const w = plot.clientWidth;
          const h = plot.clientHeight;
          gsap.set(dot, { x: (x / 300) * w - w, y: ((yAt(x) - endY) / 160) * h });
        };

        const cls = { p: 0 };
        const alt = { p: 0 };
        const snowShown = new Set<Element>();

        reveal(classic, 0);
        reveal(altitude, 0);
        gsap.set(zones, { opacity: 0 });
        gsap.set(names, { opacity: 0, y: 16 });
        gsap.set([label, labelClassic], { opacity: 0, y: 10 });
        gsap.set(dot, { opacity: 0, scale: 0.4 });
        placeDot(0);
        gsap.set(snows, { opacity: 0, y: 4 });
        gsap.set(caption, { opacity: 0 });

        gsap.timeline({
          scrollTrigger: { trigger: fig, start: 'top 75%', once: true },
          onComplete: () => {
            classic.style.clipPath = '';
            altitude.style.clipPath = '';
            gsap.set(dot, { clearProps: 'transform' });
          },
        })
          .to(zones, { opacity: 1, duration: 0.7, stagger: 0.12, ease: 'power2.out' })
          .to(names, { opacity: 1, y: 0, duration: 0.7, stagger: 0.12, ease: 'power3.out' }, 0.1)
          .to(cls, { p: 1, duration: 1.4, ease: 'power2.inOut', onUpdate: () => reveal(classic, cls.p) }, 0.45)
          .to(labelClassic, { opacity: 1, y: 0, duration: 0.6, ease: 'power3.out' }, 1.7)
          .to(dot, { opacity: 1, scale: 1, duration: 0.3, ease: 'power2.out' }, 1.5)
          .to(alt, {
            p: 1,
            duration: 2.6,
            ease: 'power1.inOut',
            onUpdate: () => {
              const x = alt.p * 300;
              reveal(altitude, alt.p);
              placeDot(x);
              snows.forEach((s) => {
                if (!snowShown.has(s) && x >= Number(s.dataset.at)) {
                  snowShown.add(s);
                  gsap.to(s, { opacity: Number(s.getAttribute('opacity') ?? 1), y: 0, duration: 0.7, ease: 'power3.out' });
                }
              });
            },
          }, 1.55)
          .to(label, { opacity: 1, y: 0, duration: 0.7, ease: 'power3.out' }, 4)
          .to(caption, { opacity: 1, duration: 0.8, ease: 'power2.out' }, 4.1);
      });
    });
  };
  if (document.readyState === 'complete') initCurve();
  else window.addEventListener('load', initCurve, { once: true });
</script>

<style lang="scss">
  .curve {
    margin: 0;
    color: var(--color-white);
  }

  .curve__frame {
    position: relative;
    padding-left: 44px;

    @media (max-width: 560px) {
      padding-left: 32px;
      padding-top: 40px;
    }
  }

  .curve__axis-title {
    position: absolute;
    left: 0;
    top: 0;
    height: clamp(280px, 32vw, 460px);
    width: 20px;
    display: flex;
    align-items: center;
    justify-content: center;

    > span {
      position: absolute;
      white-space: nowrap;
      transform: rotate(-90deg);
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: rgba(255, 255, 255, 0.5);
    }

    &::after {
      content: '';
      position: absolute;
      top: 0;
      left: 50%;
      width: 8px;
      height: 8px;
      margin-left: -4px;
      border-top: 2px solid rgba(255, 255, 255, 0.5);
      border-left: 2px solid rgba(255, 255, 255, 0.5);
      transform: rotate(45deg);
    }

    @media (max-width: 560px) {
      top: 40px;
      height: 300px;
      width: 16px;

      > span { font-size: 11px; }
    }
  }

  .curve__plot {
    position: relative;
    height: clamp(280px, 32vw, 460px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.22);

    @media (max-width: 560px) {
      height: 300px;
    }
  }

  .curve__zones {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }

  .curve__zone {
    border-left: 1px dashed rgba(255, 255, 255, 0.12);

    &:first-child { border-left: 0; }

    &.is-peak {
      background: linear-gradient(180deg, rgba(255, 255, 255, 0.045), rgba(255, 255, 255, 0.01));
    }
  }

  .curve__layer {
    position: absolute;
    inset: 0;

    svg {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      overflow: visible;
    }

    &--altitude {
      filter: drop-shadow(0 0 14px rgba(255, 223, 92, 0.22));
    }
  }

  .curve__classic {
    fill: none;
    stroke: rgba(255, 255, 255, 0.5);
    stroke-width: 2.5;
    stroke-dasharray: 7 7;
    stroke-linecap: round;
    stroke-linejoin: miter;
  }

  .curve__altitude {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 4;
    stroke-linecap: round;
    // arêtes vives : le sommet reste pointu
    stroke-linejoin: miter;
    stroke-miterlimit: 10;
  }

  .curve__dot {
    position: absolute;
    left: 100%;
    // bout de l'arête ALTITUDE (posé par le composant)
    top: var(--end-y, 22.5%);
    width: 18px;
    height: 18px;
    margin: -9px 0 0 -9px;
    border-radius: 50%;
    background: var(--color-accent);
    border: 3px solid #111;
    box-shadow: 0 0 0 6px rgba(255, 223, 92, 0.22), 0 0 28px 6px rgba(255, 223, 92, 0.45);
    pointer-events: none;
    z-index: 2;
  }

  .curve__end {
    position: absolute;
    right: 0;
    max-width: 62%;
    transform: translateY(calc(-100% - 16px));
    text-align: right;
    font-size: var(--fs-base);
    line-height: 1.3;
    z-index: 1;

    > span { display: inline-block; }

    &--altitude {
      font-family: var(--font-headline);
      font-weight: 700;
      font-size: var(--fs-md);
      color: var(--color-accent);
      transform: translateY(calc(-100% - 20px));
    }

    // Sous sa ligne : le libellé ne croise jamais la chute en pointillés.
    &--classic {
      color: rgba(255, 255, 255, 0.72);
      font-weight: 500;
      transform: translateY(12px);
    }

    // Mobile : l'étiquette ALTITUDE passe au-dessus du graphique pour ne pas toucher le sommet.
    @media (max-width: 560px) {
      max-width: 72%;

      &--altitude {
        top: 0 !important;
        font-size: 17px;
        transform: translateY(calc(-100% - 8px));
      }

      &--classic {
        font-size: 13px;
        line-height: 1.25;
        transform: translateY(7px);
      }
    }
  }

  .curve__nowrap { white-space: nowrap; }

  .curve__names {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: 0;
    padding: 20px 0 0;

    li {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 4px;
      text-align: center;
      padding: 0 8px;
    }

    strong {
      font-family: var(--font-headline);
      font-weight: 700;
      font-size: var(--fs-md);
      line-height: 1.1;
      color: var(--color-white);
    }

    span {
      font-size: 14px;
      color: rgba(255, 255, 255, 0.6);
      line-height: 1.35;
    }

    @media (max-width: 560px) {
      span { font-size: 12px; }
    }
  }

  .curve__caption {
    margin-top: 40px;
    padding-left: 44px;

    @media (max-width: 560px) {
      padding-left: 0;
      margin-top: 32px;
    }

    p {
      margin-top: 16px;
      font-size: var(--fs-xs);
      color: rgba(255, 255, 255, 0.5);
    }
  }

  .curve__legend {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 12px 32px;
    font-size: var(--fs-base);
    color: rgba(255, 255, 255, 0.88);

    li {
      display: inline-flex;
      align-items: center;
      gap: 12px;

      &::before {
        content: '';
        width: 32px;
        height: 4px;
        background: var(--color-accent);
        border-radius: 2px;
      }

      &.is-classic::before {
        height: 3px;
        background: repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.65) 0 7px, transparent 7px 12px);
      }
    }
  }
</style>
