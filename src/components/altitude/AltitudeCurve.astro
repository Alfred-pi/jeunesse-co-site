---
// Schéma illustratif « Ni rupture, ni parenthèse » (dossier ALTITUDE, p. 3).
// Il ne représente pas des données mesurées : intention du programme uniquement.
const W = 300;
const H = 160;

type Pt = [number, number];
type Seg = [number, number, number, number, number, number];

const start: Pt = [0, 138];
// ALTITUDE : monte pendant la préparation, culmine au Népal, fléchit au retour puis se maintient.
const altitudeSegs: Seg[] = [
  [30, 134, 66, 112, 100, 88],
  [122, 72, 134, 30, 158, 26],
  [182, 22, 190, 58, 210, 60],
  [232, 62, 248, 42, 270, 38],
  [282, 36, 292, 36, 300, 36],
];
const toPath = (s: Pt, segs: Seg[]) => `M${s[0]},${s[1]} ` + segs.map((c) => `C${c.join(',')}`).join(' ');
const altitudeLine = toPath(start, altitudeSegs);
const altitudeArea = `${altitudeLine} L${W},${H} L0,${H} Z`;

// Séjour classique : plat avant, pic pendant, chute au retour.
const classicLine = 'M0,138 L92,137 C112,136 124,40 150,38 C176,36 184,120 208,132 L300,136';

// Échantillonne la courbe pour poser la crête enneigée au plus près du sommet.
const bez = (p0: number, p1: number, p2: number, p3: number, t: number) =>
  (1 - t) ** 3 * p0 + 3 * (1 - t) ** 2 * t * p1 + 3 * (1 - t) * t ** 2 * p2 + t ** 3 * p3;
const samples: Pt[] = [];
let prev = start;
for (const c of altitudeSegs) {
  for (let i = 1; i <= 40; i++) {
    const t = i / 40;
    samples.push([bez(prev[0], c[0], c[2], c[4], t), bez(prev[1], c[1], c[3], c[5], t)]);
  }
  prev = [c[4], c[5]];
}
const ridge = samples.filter(([x]) => x >= 141 && x <= 178);
const teeth = [9, 4, 11, 5, 8, 3, 10];
const snowBottom = teeth.map((d, i) => {
  const x = 178 - (i / (teeth.length - 1)) * 37;
  const near = ridge.reduce((a, b) => (Math.abs(b[0] - x) < Math.abs(a[0] - x) ? b : a));
  return [x, near[1] + d] as Pt;
});
const snow = [...ridge, ...snowBottom].map(([x, y]) => `${x.toFixed(2)},${y.toFixed(2)}`).join(' ');

const pct = (v: number, max: number) => `${((v / max) * 100).toFixed(3)}%`;
const zones = [
  { name: 'Avant', sub: 'Préparation à Genève' },
  { name: 'Pendant', sub: '60 jours au Népal' },
  { name: 'Après', sub: '6 mois au minimum' },
];
---

<figure class="curve" data-curve>
  <div class="curve__frame">
    <span class="curve__axis-title" aria-hidden="true"><span>Mobilisation du jeune</span></span>

    <div class="curve__plot" data-curve-plot role="img" aria-label="Schéma illustratif : la mobilisation d’un jeune dans un séjour classique monte pendant le séjour puis retombe au retour ; avec ALTITUDE, elle monte dès la préparation, culmine pendant le séjour et se maintient après le retour.">
      <div class="curve__zones" aria-hidden="true">
        {zones.map((z, i) => <span class:list={['curve__zone', { 'is-peak': i === 1 }]} data-curve-zone></span>)}
      </div>

      <div class="curve__layer" data-curve-classic aria-hidden="true">
        <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none">
          <path d={classicLine} class="curve__classic" vector-effect="non-scaling-stroke" />
        </svg>
      </div>

      <div class="curve__layer curve__layer--altitude" data-curve-altitude aria-hidden="true">
        <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none">
          <defs>
            <clipPath id="curveSlope">
              <path d={altitudeArea} />
            </clipPath>
            <linearGradient id="curveFill" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#FFDF5C" stop-opacity="0.26" />
              <stop offset="70%" stop-color="#FFDF5C" stop-opacity="0.04" />
              <stop offset="100%" stop-color="#FFDF5C" stop-opacity="0" />
            </linearGradient>
          </defs>
          <g clip-path="url(#curveSlope)">
            <rect x="0" y="0" width={W} height={H} fill="url(#curveFill)" />
            <!-- facettes : versant éclairé à gauche du sommet, versant à l'ombre à droite -->
            <polygon points="158,26 104,160 158,160" fill="#FFDF5C" fill-opacity="0.07" />
            <polygon points="158,26 158,160 214,160" fill="#000" fill-opacity="0.28" />
            <polygon points="100,88 62,160 100,160" fill="#FFDF5C" fill-opacity="0.04" />
            <polygon points="270,38 238,160 270,160" fill="#FFDF5C" fill-opacity="0.06" />
            <polygon points="270,38 270,160 300,160 300,36" fill="#000" fill-opacity="0.2" />
          </g>
          <g data-curve-snow>
            <polygon points={snow} fill="#F2F0EB" fill-opacity="0.92" />
          </g>
          <path d={altitudeLine} class="curve__altitude" vector-effect="non-scaling-stroke" data-curve-path />
        </svg>
      </div>

      <span class="curve__dot" data-curve-dot aria-hidden="true"></span>

      <span class="curve__end curve__end--altitude" style={`top:${pct(36, H)}`} aria-hidden="true">
        <span data-curve-label>ALTITUDE : l’élan se garde</span>
      </span>
      <span class="curve__end curve__end--classic" style={`top:${pct(136, H)}`} aria-hidden="true">
        <span data-curve-label-classic>Séjour classique : retour au point de départ</span>
      </span>
    </div>

    <ol class="curve__names">
      {zones.map((z) => (
        <li data-curve-name>
          <strong>{z.name}</strong>
          <span>{z.sub}</span>
        </li>
      ))}
    </ol>
  </div>

  <figcaption class="curve__caption" data-curve-caption>
    <ul class="curve__legend">
      <li class="is-altitude">Programme ALTITUDE</li>
      <li class="is-classic">Séjour « de rupture » classique</li>
    </ul>
    <p>Schéma illustratif de l’intention du programme. Il ne représente pas des données mesurées.</p>
  </figcaption>
</figure>

<script>
  const initCurve = () => {
    const fig = document.querySelector<HTMLElement>('[data-curve]');
    if (!fig || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    import('gsap').then(({ gsap }) => {
      import('gsap/ScrollTrigger').then(({ ScrollTrigger }) => {
        gsap.registerPlugin(ScrollTrigger);

        const plot = fig.querySelector<HTMLElement>('[data-curve-plot]')!;
        const classic = fig.querySelector<HTMLElement>('[data-curve-classic]')!;
        const altitude = fig.querySelector<HTMLElement>('[data-curve-altitude]')!;
        const path = fig.querySelector<SVGPathElement>('[data-curve-path]')!;
        const dot = fig.querySelector<HTMLElement>('[data-curve-dot]')!;
        const snow = fig.querySelector('[data-curve-snow]');
        const zones = fig.querySelectorAll('[data-curve-zone]');
        const names = fig.querySelectorAll('[data-curve-name]');
        const label = fig.querySelector('[data-curve-label]');
        const labelClassic = fig.querySelector('[data-curve-label-classic]');
        const caption = fig.querySelector('[data-curve-caption]');

        // Table x -> y de la courbe ALTITUDE (unités du viewBox 300 x 160).
        const len = path.getTotalLength();
        const table: [number, number][] = [];
        for (let i = 0; i <= 240; i++) {
          const p = path.getPointAtLength((i / 240) * len);
          table.push([p.x, p.y]);
        }
        const yAt = (x: number) => {
          for (let i = 1; i < table.length; i++) {
            if (table[i][0] >= x) {
              const [x0, y0] = table[i - 1];
              const [x1, y1] = table[i];
              return y0 + ((y1 - y0) * (x - x0)) / Math.max(x1 - x0, 0.0001);
            }
          }
          return table[table.length - 1][1];
        };

        const reveal = (el: HTMLElement, p: number) => {
          el.style.clipPath = `inset(-20% ${(100 - p * 100).toFixed(2)}% -20% -2%)`;
        };
        const placeDot = (x: number) => {
          const w = plot.clientWidth;
          const h = plot.clientHeight;
          // Position finale CSS : bout de courbe (x = 300, y = 36).
          gsap.set(dot, { x: (x / 300) * w - w, y: (yAt(x) / 160) * h - (36 / 160) * h });
        };

        const cls = { p: 0 };
        const alt = { p: 0 };
        let snowShown = false;

        reveal(classic, 0);
        reveal(altitude, 0);
        gsap.set(zones, { opacity: 0 });
        gsap.set(names, { opacity: 0, y: 16 });
        gsap.set([label, labelClassic], { opacity: 0, y: 10 });
        gsap.set(dot, { opacity: 0, scale: 0.4 });
        gsap.set(snow, { opacity: 0 });
        gsap.set(caption, { opacity: 0 });

        gsap.timeline({
          scrollTrigger: { trigger: fig, start: 'top 75%', once: true },
          onComplete: () => {
            classic.style.clipPath = '';
            altitude.style.clipPath = '';
            gsap.set(dot, { clearProps: 'transform' });
          },
        })
          .to(zones, { opacity: 1, duration: 0.7, stagger: 0.12, ease: 'power2.out' })
          .to(names, { opacity: 1, y: 0, duration: 0.7, stagger: 0.12, ease: 'power3.out' }, 0.1)
          .to(cls, { p: 1, duration: 1.4, ease: 'power2.inOut', onUpdate: () => reveal(classic, cls.p) }, 0.45)
          .to(labelClassic, { opacity: 1, y: 0, duration: 0.6, ease: 'power3.out' }, 1.7)
          .to(dot, { opacity: 1, scale: 1, duration: 0.3, ease: 'power2.out' }, 1.5)
          .to(alt, {
            p: 1,
            duration: 2.4,
            ease: 'power1.inOut',
            onStart: () => placeDot(0),
            onUpdate: () => {
              const x = alt.p * 300;
              reveal(altitude, alt.p);
              placeDot(x);
              if (!snowShown && x > 150) {
                snowShown = true;
                gsap.to(snow, { opacity: 1, duration: 0.8, ease: 'power2.out' });
              }
            },
          }, 1.55)
          .to(label, { opacity: 1, y: 0, duration: 0.7, ease: 'power3.out' }, 3.8)
          .to(caption, { opacity: 1, duration: 0.8, ease: 'power2.out' }, 3.9);
      });
    });
  };
  if (document.readyState === 'complete') initCurve();
  else window.addEventListener('load', initCurve, { once: true });
</script>

<style lang="scss">
  .curve {
    margin: 0;
    color: var(--color-white);
  }

  .curve__frame {
    position: relative;
    padding-left: 44px;

    @media (max-width: 560px) {
      padding-left: 32px;
      padding-top: 40px;
    }
  }

  .curve__axis-title {
    position: absolute;
    left: 0;
    top: 0;
    height: clamp(280px, 32vw, 460px);
    width: 20px;
    display: flex;
    align-items: center;
    justify-content: center;

    > span {
      position: absolute;
      white-space: nowrap;
      transform: rotate(-90deg);
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: rgba(255, 255, 255, 0.5);
    }

    &::after {
      content: '';
      position: absolute;
      top: 0;
      left: 50%;
      width: 8px;
      height: 8px;
      margin-left: -4px;
      border-top: 2px solid rgba(255, 255, 255, 0.5);
      border-left: 2px solid rgba(255, 255, 255, 0.5);
      transform: rotate(45deg);
    }

    @media (max-width: 560px) {
      top: 40px;
      height: 300px;
      width: 16px;

      > span { font-size: 11px; }
    }
  }

  .curve__plot {
    position: relative;
    height: clamp(280px, 32vw, 460px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.22);

    @media (max-width: 560px) {
      height: 300px;
    }
  }

  .curve__zones {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }

  .curve__zone {
    border-left: 1px dashed rgba(255, 255, 255, 0.12);

    &:first-child { border-left: 0; }

    &.is-peak {
      background: linear-gradient(180deg, rgba(255, 255, 255, 0.045), rgba(255, 255, 255, 0.01));
    }
  }

  .curve__layer {
    position: absolute;
    inset: 0;

    svg {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      overflow: visible;
    }

    &--altitude {
      filter: drop-shadow(0 0 14px rgba(255, 223, 92, 0.22));
    }
  }

  .curve__classic {
    fill: none;
    stroke: rgba(255, 255, 255, 0.5);
    stroke-width: 2.5;
    stroke-dasharray: 7 7;
    stroke-linecap: round;
  }

  .curve__altitude {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .curve__dot {
    position: absolute;
    left: 100%;
    top: 22.5%;
    width: 18px;
    height: 18px;
    margin: -9px 0 0 -9px;
    border-radius: 50%;
    background: var(--color-accent);
    border: 3px solid #111;
    box-shadow: 0 0 0 6px rgba(255, 223, 92, 0.22), 0 0 28px 6px rgba(255, 223, 92, 0.45);
    pointer-events: none;
    z-index: 2;
  }

  .curve__end {
    position: absolute;
    right: 0;
    max-width: 62%;
    transform: translateY(calc(-100% - 16px));
    text-align: right;
    font-size: var(--fs-base);
    line-height: 1.3;
    z-index: 1;

    > span { display: inline-block; }

    &--altitude {
      font-family: var(--font-headline);
      font-weight: 700;
      font-size: var(--fs-md);
      color: var(--color-accent);
      transform: translateY(calc(-100% - 20px));
    }

    &--classic {
      color: rgba(255, 255, 255, 0.72);
      font-weight: 500;
    }

    // Mobile : l'étiquette ALTITUDE passe au-dessus du graphique pour ne pas toucher le sommet.
    @media (max-width: 560px) {
      max-width: 72%;

      &--altitude {
        top: 0 !important;
        font-size: 17px;
        transform: translateY(calc(-100% - 8px));
      }

      &--classic { font-size: 14px; }
    }
  }

  .curve__names {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: 0;
    padding: 20px 0 0;

    li {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 4px;
      text-align: center;
      padding: 0 8px;
    }

    strong {
      font-family: var(--font-headline);
      font-weight: 700;
      font-size: var(--fs-md);
      line-height: 1.1;
      color: var(--color-white);
    }

    span {
      font-size: 14px;
      color: rgba(255, 255, 255, 0.6);
      line-height: 1.35;
    }

    @media (max-width: 560px) {
      span { font-size: 12px; }
    }
  }

  .curve__caption {
    margin-top: 40px;
    padding-left: 44px;

    @media (max-width: 560px) {
      padding-left: 0;
      margin-top: 32px;
    }

    p {
      margin-top: 16px;
      font-size: var(--fs-xs);
      color: rgba(255, 255, 255, 0.5);
    }
  }

  .curve__legend {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 12px 32px;
    font-size: var(--fs-base);
    color: rgba(255, 255, 255, 0.88);

    li {
      display: inline-flex;
      align-items: center;
      gap: 12px;

      &::before {
        content: '';
        width: 32px;
        height: 4px;
        background: var(--color-accent);
        border-radius: 2px;
      }

      &.is-classic::before {
        height: 3px;
        background: repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.65) 0 7px, transparent 7px 12px);
      }
    }
  }
</style>
