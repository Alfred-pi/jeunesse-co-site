---
// Profil d'altitude du séjour : altitude de nuit, jour par jour.
// Source : annexe 1 du dossier ALTITUDE (itinéraire Dream Peak Adventure).
const MAX_ALT = 6000;
const DAYS = 60;

const nights: [number, number][] = [
  [1, 1350], [2, 1350], [3, 1350], [4, 1200], [5, 1500], [6, 1900], [7, 2070],
  [8, 2995], [9, 3870], [10, 3870], [11, 4580], [12, 4580], [13, 5170], [14, 5475],
  [55, 5475], [56, 4580], [57, 2995], [58, 2070], [59, 1350], [60, 1350],
];

const W = 600;
const H = 300;
const sx = (day: number) => ((day - 1) / (DAYS - 1)) * W;
const sy = (alt: number) => H - (alt / MAX_ALT) * H;
const line = nights.map(([d, a], i) => `${i ? 'L' : 'M'}${sx(d).toFixed(2)},${sy(a).toFixed(2)}`).join(' ');
const area = `${line} L${W},${H} L0,${H} Z`;

const pctX = (day: number) => `${(((day - 1) / (DAYS - 1)) * 100).toFixed(3)}%`;
const pctY = (alt: number) => `${((1 - alt / MAX_ALT) * 100).toFixed(3)}%`;

const grid = [1000, 2000, 3000, 4000, 5000];
const ticks = [1, 10, 20, 30, 40, 50, 60];

const stops = [
  { day: 1, alt: 1350, name: 'Katmandou', place: 'right' },
  { day: 8, alt: 2995, name: 'Tortong', place: 'left' },
  { day: 9, alt: 3870, name: 'Tseram', place: 'left', minor: true },
  { day: 11, alt: 4580, name: 'Ramche', place: 'left' },
];

const phases = [
  { n: 1, from: 1, to: 3, title: 'Katmandou', days: 'J1 à J3', text: 'Accueil, récupération, contrôle du matériel, briefing de sécurité, découverte de la ville.' },
  { n: 2, from: 4, to: 8, title: 'Approche', days: 'J4 à J8', text: 'Vol vers Bhadrapur, route vers Ilam, premières journées de marche par Khebang et Yamphudin jusqu’à Tortong.' },
  { n: 3, from: 9, to: 14, title: 'Montée par paliers', days: 'J9 à J14', text: 'Tseram, Ramche, randonnée vers Oktang face au Kanchenjunga, camp glaciaire, puis le camp de base. Deux jours d’acclimatation en route.' },
  { n: 4, from: 15, to: 55, title: 'Vie au camp de base', days: 'J15 à J55', text: 'Environ six semaines à 5’475 m, au cœur d’une expédition himalayenne.' },
  { n: 5, from: 56, to: 60, title: 'Retour', days: 'J56 à J60', text: 'Redescente par Ramche, Tortong et Yamphudin, transfert vers Katmandou, vol retour.' },
];
const fmt = (n: number) => n.toLocaleString('fr-CH').replace(/ |\s|'/g, '’');
---

<figure class="profile" data-profile>
  <figcaption class="sr-only">
    Altitude de nuit du séjour, jour par jour : trois nuits à Katmandou (1’350 m), approche jusqu’à Tortong (2’995 m) au jour 8,
    montée par Tseram (3’870 m) et Ramche (4’580 m), arrivée au camp de base (5’475 m) au jour 14, vie au camp de base du jour 15 au jour 55,
    puis redescente jusqu’à Katmandou et vol retour au jour 60.
  </figcaption>

  <div class="profile__frame" aria-hidden="true">
   <div class="profile__inner">
    <div class="profile__grid">
      {grid.map((alt) => (
        <div class="profile__gridline" style={`top:${pctY(alt)}`}>
          <span>{fmt(alt)} m</span>
        </div>
      ))}
    </div>

    {phases.slice(1).map((p) => (
      <div class="profile__phase-sep" style={`left:${pctX(p.from - 0.5)}`}></div>
    ))}
    {phases.map((p) => (
      <span class="profile__phase-num" style={`left:${pctX((p.from + p.to) / 2)}`}>{p.n}</span>
    ))}

    <div class="profile__plot" data-profile-plot>
      <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" class="profile__svg">
        <defs>
          <linearGradient id="profileFill" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#FFDF5C" stop-opacity="0.32" />
            <stop offset="100%" stop-color="#FFDF5C" stop-opacity="0" />
          </linearGradient>
        </defs>
        <path d={area} fill="url(#profileFill)" />
        <path d={line} fill="none" stroke="#FFDF5C" stroke-width="2.5" stroke-linejoin="round" vector-effect="non-scaling-stroke" />
      </svg>

      {stops.map((s) => (
        <span class:list={['profile__stop', `profile__stop--${s.place}`, { 'profile__stop--minor': s.minor }]} style={`left:${pctX(s.day)};top:${pctY(s.alt)}`}>
          <span class="profile__label"><strong>{s.name}</strong> {fmt(s.alt)} m</span>
        </span>
      ))}

      <div class="profile__base" style={`left:${pctX(15)};right:${(100 - ((55 - 1) / (DAYS - 1)) * 100).toFixed(3)}%;top:${pctY(5475)}`}>
        <span class="profile__base-label">
          <strong>Camp de base · 5’475 m</strong>
          <span>J15 à J55, environ six semaines</span>
        </span>
      </div>

      <span class="profile__stop profile__stop--end" style={`left:${pctX(60)};top:${pctY(1350)}`}>
        <span class="profile__label"><strong>Vol retour</strong> J60</span>
      </span>
    </div>

    <div class="profile__ticks">
      {ticks.map((d) => <span style={`left:${pctX(d)}`}>J{d}</span>)}
    </div>
   </div>
  </div>

  <ol class="profile__phases">
    {phases.map((p) => (
      <li class="profile__phase reveal">
        <span class="profile__phase-badge" aria-hidden="true">{p.n}</span>
        <div>
          <p class="profile__phase-days">{p.days}</p>
          <h4>{p.title}</h4>
          <p>{p.text}</p>
        </div>
      </li>
    ))}
  </ol>
  <p class="profile__note">Altitude de nuit, jour par jour. Altitudes et étapes indicatives, ajustées sur place selon la météo et l’état du groupe.</p>
</figure>

<script>
  const init = () => {
    const profile = document.querySelector<HTMLElement>('[data-profile]');
    if (!profile) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    import('gsap').then(({ gsap }) => {
      import('gsap/ScrollTrigger').then(({ ScrollTrigger }) => {
        gsap.registerPlugin(ScrollTrigger);
        const plot = profile.querySelector('[data-profile-plot]');
        const labels = profile.querySelectorAll('.profile__stop, .profile__base');
        gsap.set(plot, { clipPath: 'inset(-40% 100% -10% -4%)' });
        gsap.set(labels, { opacity: 0, y: 8 });
        gsap.timeline({ scrollTrigger: { trigger: profile, start: 'top 75%', once: true } })
          .to(plot, { clipPath: 'inset(-40% -4% -10% -4%)', duration: 2.4, ease: 'power3.out', onComplete: () => gsap.set(plot, { clearProps: 'clipPath' }) })
          .to(labels, { opacity: 1, y: 0, duration: 0.6, stagger: 0.12, ease: 'power3.out' }, 0.5);
      });
    });
  };
  if (document.readyState === 'complete') init();
  else window.addEventListener('load', init, { once: true });
</script>

<style lang="scss">
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .profile {
    margin: 0;
  }

  .profile__frame {
    height: clamp(300px, 34vw, 460px);
    margin: 0 0 56px;
    padding-left: 72px;

    @media (max-width: 768px) {
      height: 300px;
      margin-bottom: 40px;
      padding-left: 52px;
    }
  }

  .profile__inner {
    position: relative;
    height: 100%;
  }

  .profile__grid,
  .profile__plot {
    position: absolute;
    inset: 40px 0 0 0;
  }

  .profile__gridline {
    position: absolute;
    left: 0;
    right: 0;
    border-top: 1px dashed rgba(255, 255, 255, 0.12);

    span {
      position: absolute;
      right: calc(100% + 12px);
      top: -9px;
      white-space: nowrap;
      font-size: var(--fs-xs);
      color: rgba(255, 255, 255, 0.4);
      font-variant-numeric: tabular-nums;
    }
  }

  .profile__phase-sep {
    position: absolute;
    top: 40px;
    bottom: 0;
    border-left: 1px solid rgba(255, 255, 255, 0.08);
  }

  .profile__phase-num {
    position: absolute;
    top: 0;
    transform: translateX(-50%);
    width: 24px;
    height: 24px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 1px solid rgba(255, 223, 92, 0.6);
    color: var(--color-accent);
    font-size: var(--fs-xs);
    font-weight: 700;

    @media (max-width: 768px) {
      display: none;
    }
  }

  .profile__svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .profile__stop {
    position: absolute;
    width: 0;
    height: 0;

    &::before {
      content: '';
      position: absolute;
      left: -6px;
      top: -6px;
      width: 12px;
      height: 12px;
      border-radius: 50%;
      background: #111;
      border: 2.5px solid var(--color-accent);
    }
  }

  .profile__label {
    position: absolute;
    bottom: 12px;
    white-space: nowrap;
    font-size: var(--fs-xs);
    color: rgba(255, 255, 255, 0.65);
    font-variant-numeric: tabular-nums;
    line-height: 1.3;

    strong {
      display: block;
      color: var(--color-white);
      font-size: var(--fs-base);
      font-family: var(--font-headline);
      font-weight: 700;
    }
  }

  .profile__stop--right .profile__label { left: 4px; }
  .profile__stop--left .profile__label { right: 10px; text-align: right; }
  .profile__stop--end .profile__label { right: 0; bottom: auto; top: 14px; text-align: right; }

  // Sur mobile, les étapes intermédiaires gardent leur point ; leurs noms sont dans la liste des phases.
  @media (max-width: 768px) {
    .profile__stop--left .profile__label { display: none; }
    .profile__stop--right .profile__label { bottom: auto; top: 12px; }
    .profile__label strong { font-size: var(--fs-xs); }
    .profile__ticks span:nth-child(2n) { display: none; }
  }

  .profile__base {
    position: absolute;
    height: 0;

    .profile__base-label {
      position: absolute;
      left: 50%;
      top: 24px;
      transform: translateX(-50%);
      white-space: nowrap;
      text-align: center;
      line-height: 1.35;

      strong {
        display: block;
        font-family: var(--font-headline);
        font-size: var(--fs-md);
        color: var(--color-accent);
      }

      span {
        font-size: var(--fs-xs);
        color: rgba(255, 255, 255, 0.65);
        letter-spacing: 0.02em;
      }
    }
  }

  .profile__ticks {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -28px;

    span {
      position: absolute;
      transform: translateX(-50%);
      font-size: var(--fs-xs);
      color: rgba(255, 255, 255, 0.45);
      font-variant-numeric: tabular-nums;

      &:first-child { transform: none; }
      &:last-child { transform: translateX(-100%); }
    }
  }

  .profile__phases {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 32px;
    padding-top: 40px;
    border-top: 1px solid rgba(255, 255, 255, 0.12);

    @media (max-width: 1024px) {
      grid-template-columns: repeat(2, 1fr);
    }

    @media (max-width: 560px) {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }

  .profile__phase {
    display: flex;
    gap: 16px;

    h4 {
      font-family: var(--font-headline);
      font-size: var(--fs-md);
      color: var(--color-white);
      margin-bottom: 8px;
      line-height: 1.15;
    }

    p {
      color: rgba(255, 255, 255, 0.7);
      font-size: var(--fs-base);
      line-height: 1.55;
    }
  }

  .profile__phase-badge {
    flex: 0 0 auto;
    width: 32px;
    height: 32px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--color-accent);
    color: var(--color-primary);
    font-weight: 700;
    font-size: var(--fs-xs);
  }

  .profile__phase-days {
    font-size: var(--fs-xs) !important;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 700;
    color: var(--color-accent) !important;
    margin-bottom: 6px !important;
  }

  .profile__note {
    margin-top: 40px;
    font-size: var(--fs-xs);
    color: rgba(255, 255, 255, 0.45);
  }
</style>
