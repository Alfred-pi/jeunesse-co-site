---
// Profil du séjour en paysage de montagne : altitude de nuit, jour par jour,
// au pied du Kanchenjunga. Source : annexe 1 du dossier ALTITUDE (itinéraire Dream Peak Adventure).
type Pt = [number, number];

const VB_W = 1200;
const VB_H = 600;
const ALT_MAX = 9000;
const DAYS = 60;
const X0 = 24;
const XW = VB_W - 2 * X0;

const xOf = (d: number) => X0 + ((d - 1) / (DAYS - 1)) * XW;
const yOf = (a: number) => VB_H - (a / ALT_MAX) * VB_H;
const px = (d: number) => `${((xOf(d) / VB_W) * 100).toFixed(3)}%`;
const py = (a: number) => `${((yOf(a) / VB_H) * 100).toFixed(3)}%`;
const fmt = (n: number) => String(n).replace(/\B(?=(\d{3})+(?!\d))/g, '’');

// Altitude de nuit de chaque jour (J1 à J60) et lieu correspondant.
const days: { a: number; place: string }[] = [];
const fill = (from: number, to: number, a: number, place: string) => {
  for (let d = from; d <= to; d++) days[d] = { a, place };
};
fill(1, 3, 1350, 'Katmandou');
fill(4, 4, 1200, 'Ilam');
fill(5, 5, 1500, 'Jorpul');
fill(6, 6, 1900, 'Khebang');
fill(7, 7, 2070, 'Yamphudin');
fill(8, 8, 2995, 'Tortong');
fill(9, 10, 3870, 'Tseram');
fill(11, 12, 4580, 'Ramche');
fill(13, 13, 5170, 'Camp glaciaire');
fill(14, 55, 5475, 'Camp de base');
fill(56, 56, 4580, 'Ramche');
fill(57, 57, 2995, 'Tortong');
fill(58, 58, 2070, 'Yamphudin');
fill(59, 59, 1350, 'Katmandou');
fill(60, 60, 1350, 'Vol retour');

const trailPts: Pt[] = [];
for (let d = 1; d <= DAYS; d++) trailPts.push([xOf(d), yOf(days[d].a)]);
const toD = (pts: Pt[]) => pts.map(([x, y], i) => `${i ? 'L' : 'M'}${x.toFixed(1)},${y.toFixed(1)}`).join(' ');
const trailD = toD(trailPts);
const groundD = `M0,${yOf(1350).toFixed(1)} L${trailD.slice(1)} L${VB_W},${yOf(1350).toFixed(1)} L${VB_W},${VB_H} L0,${VB_H} Z`;

// Montagnes en facettes, façon logo : chaque sommet est un triangle (face éclairée, face d'ombre)
// posé sur la ligne de base ; les triangles se recouvrent pour former la chaîne.
const toPts = (pts: Pt[]) => pts.map(([x, y]) => `${x.toFixed(1)},${y.toFixed(1)}`).join(' ');

type Peak = [number, number, number, number?]; // x, altitude, pente gauche, pente droite (dx par dy)

function peaks(list: Peak[], snowAlt: number, capK: number) {
  return list.map(([x, a, sl, sr = sl]) => {
    const p: Pt = [x, yOf(a)];
    const h = VB_H - p[1];
    const lf: Pt = [x - h * sl, VB_H];
    const rf: Pt = [x + h * sr, VB_H];
    const split: Pt = [x + h * sr * 0.18, VB_H];
    let cap: string | null = null;
    if (a > snowAlt) {
      const depth = Math.min(yOf(snowAlt) - p[1], capK * h);
      const L: Pt = [x - depth * sl, p[1] + depth];
      const R: Pt = [x + depth * sr, p[1] + depth];
      const n = Math.max(4, Math.round((R[0] - L[0]) / 18));
      const zig: Pt[] = [];
      for (let j = 1; j < n; j++) {
        const t = j / n;
        zig.push([L[0] + (R[0] - L[0]) * t, L[1] + depth * (j % 2 ? 0.34 : -0.05)]);
      }
      cap = toPts([p, L, ...zig, R]);
    }
    return { light: toPts([lf, p, split]), shadow: toPts([p, rf, split]), cap };
  });
}

const far = peaks(
  [[70, 5900, 0.95], [240, 6600, 0.9], [400, 7100, 0.85], [540, 6700, 0.9], [720, 6400, 0.9], [860, 6900, 0.85], [1000, 7400, 0.85], [1140, 6800, 0.9], [1240, 6200, 0.9]],
  5600, 0.13,
);
// Massif du Kanchenjunga : le sommet principal (8’586 m) se détache seul au centre, ses voisins
// sont assez écartés pour que les calottes de neige ne se chevauchent pas.
const mid = peaks(
  [[300, 5600, 0.8], [450, 7100, 0.75], [900, 7300, 0.72], [1060, 6700, 0.78], [1190, 6100, 0.8], [700, 8586, 0.6, 0.7]],
  6000, 0.15,
);
const summit = { x: 700, a: 8586 };
// Collines de premier plan, sous le plateau : du relief au sol, sans toucher au sentier.
const hills = peaks(
  [[340, 2300, 1.6], [470, 1700, 1.7], [600, 2800, 1.5], [800, 2400, 1.6], [990, 2100, 1.6], [700, 1500, 1.8]],
  99999, 0,
);

const stops = [
  { day: 1, name: 'Katmandou', alt: '1’350 m', place: 'below-left', tier: 'key' },
  { day: 8, name: 'Tortong', alt: '2’995 m', place: 'left', tier: 'minor' },
  { day: 9, name: 'Tseram', alt: '3’870 m', place: 'left', tier: 'minor' },
  { day: 11, name: 'Ramche', alt: '4’580 m', place: 'left', tier: 'mid' },
  { day: 14, name: '', alt: '', place: 'none', tier: 'key' },
  { day: 60, name: 'Vol retour', alt: 'Katmandou, J60', place: 'below-right', tier: 'key' },
];
const tents = [18, 23, 28, 33, 38, 43, 48, 52];
const rulerTicks = [1000, 2000, 3000, 4000, 5000, 6000, 7000, 8000];
const xTicks = [
  { d: 1, label: 'J1' },
  { d: 14, label: 'J14' },
  { d: 55, label: 'J55', minor: true },
  { d: 60, label: 'J60' },
];

const phases = [
  { n: 1, from: 1, to: 3, title: 'Katmandou', days: 'J1 à J3', text: 'Accueil, contrôle du matériel, briefing de sécurité.' },
  { n: 2, from: 4, to: 8, title: 'Approche', days: 'J4 à J8', text: 'Vol vers Bhadrapur, puis premières marches jusqu’à Tortong.' },
  { n: 3, from: 9, to: 14, title: 'Montée par paliers', days: 'J9 à J14', text: 'Tseram, Ramche, face au Kanchenjunga, avec deux jours d’acclimatation.' },
  { n: 4, from: 15, to: 55, title: 'Camp de base', days: 'J15 à J55', text: 'Six semaines à 5’475 m, au cœur d’une expédition himalayenne.' },
  { n: 5, from: 56, to: 60, title: 'Retour', days: 'J56 à J60', text: 'Redescente, transfert vers Katmandou, vol retour.' },
];
const segLeft = (from: number) => ((xOf(from - 0.5) / VB_W) * 100).toFixed(3);
const segWidth = (from: number, to: number) => (((xOf(to + 0.5) - xOf(from - 0.5)) / VB_W) * 100).toFixed(3);

const walkData = {
  days: days.slice(1).map((d) => d.a),
  places: days.slice(1).map((d) => d.place),
  vbW: VB_W,
  vbH: VB_H,
  altMax: ALT_MAX,
  x0: X0,
  xw: XW,
};
---

<figure class="pf" data-pf>
  <figcaption class="pf-sr">
    Profil du séjour, altitude de nuit jour par jour, sur fond du massif du Kanchenjunga (8’586 m, non gravi).
    Trois nuits à Katmandou (1’350 m), approche jusqu’à Tortong (2’995 m) au jour 8, montée par Tseram (3’870 m)
    et Ramche (4’580 m), arrivée au camp de base (5’475 m) au jour 14, vie au camp de base du jour 15 au jour 55,
    puis redescente jusqu’à Katmandou et vol retour au jour 60.
  </figcaption>

  <div class="pf__hud" aria-hidden="true" data-pf-hud>
    <span class="pf__hud-day" data-pf-day>60 jours</span>
    <span class="pf__hud-sep">·</span>
    <span class="pf__hud-alt" data-pf-alt>jusqu’à 5’475 m</span>
    <span class="pf__hud-sep">·</span>
    <span class="pf__hud-place" data-pf-place>au pied du Kanchenjunga</span>
  </div>

  <div class="pf__stage" aria-hidden="true">
    <div class="pf__plot" data-pf-plot>
      <div class="pf__land">
        <div class="pf__sun" data-pf-sun></div>

        <svg class="pf__layer" data-pf-layer viewBox={`0 0 ${VB_W} ${VB_H}`} preserveAspectRatio="none">
          <defs>
            {far.map((p, i) => (
              <clipPath id={`pf-far-sh-${i}`}><polygon points={p.shadow} /></clipPath>
            ))}
          </defs>
          {far.map((p) => (
            <g>
              <polygon points={p.light} fill="#2F2D27" />
              <polygon points={p.shadow} fill="#242320" />
            </g>
          ))}
          <g data-pf-snow>
            {far.map((p, i) => p.cap && (
              <g>
                <polygon points={p.cap} fill="#F2F0EB" fill-opacity="0.32" />
                <polygon points={p.cap} fill="#A4A4A2" fill-opacity="0.34" clip-path={`url(#pf-far-sh-${i})`} />
              </g>
            ))}
          </g>
        </svg>

        <svg class="pf__layer" data-pf-layer viewBox={`0 0 ${VB_W} ${VB_H}`} preserveAspectRatio="none">
          <defs>
            {mid.map((p, i) => (
              <clipPath id={`pf-mid-sh-${i}`}><polygon points={p.shadow} /></clipPath>
            ))}
          </defs>
          {mid.map((p) => (
            <g>
              <polygon points={p.light} fill="#52514E" />
              <polygon points={p.shadow} fill="#3B3934" />
            </g>
          ))}
          <g data-pf-snow>
            {mid.map((p, i) => p.cap && (
              <g>
                <polygon points={p.cap} fill="#F2F0EB" />
                <polygon points={p.cap} fill="#A4A4A2" clip-path={`url(#pf-mid-sh-${i})`} />
              </g>
            ))}
          </g>
        </svg>

        <svg class="pf__layer pf__layer--ground" data-pf-layer viewBox={`0 0 ${VB_W} ${VB_H}`} preserveAspectRatio="none">
          <defs>
            <linearGradient id="pf-ground" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#242320" />
              <stop offset="45%" stop-color="#1B1B1A" />
              <stop offset="100%" stop-color="#111111" />
            </linearGradient>
          </defs>
          <path d={groundD} fill="url(#pf-ground)" />
          {hills.map((p) => (
            <g>
              <polygon points={p.light} fill="#1E1D1B" />
              <polygon points={p.shadow} fill="#161615" />
            </g>
          ))}
          <path d={trailD} fill="none" stroke="#3B3934" stroke-width="1.5" vector-effect="non-scaling-stroke" />
        </svg>
      </div>

      <div class="pf__trail" data-pf-trail>
        <svg viewBox={`0 0 ${VB_W} ${VB_H}`} preserveAspectRatio="none">
          <path d={trailD} fill="none" stroke="#FFDF5C" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="1 9" vector-effect="non-scaling-stroke" />
        </svg>
      </div>

      <span class="pf__summit" style={`left:${((summit.x / VB_W) * 100).toFixed(3)}%;top:${py(summit.a)}`} data-pf-fade>
        <span class="pf__summit-label">
          <strong>Kanchenjunga</strong>
          <span>8’586 m</span><span class="pf__summit-note">non gravi</span>
        </span>
      </span>

      {tents.map((d) => (
        <span class="pf__tent" style={`left:${px(d)};top:${py(5475)}`} data-pf-tent data-day={d}>
          <svg viewBox="0 0 26 20"><path d="M13 1 25 19H1Z" fill="#F2F0EB" /><path d="M13 9.5 17.6 19H8.4Z" fill="#FFDF5C" /></svg>
        </span>
      ))}

      <div class="pf__base" style={`left:${px(34.5)};top:${py(5475)}`} data-pf-base>
        <strong>Camp de base · 5’475 m</strong>
        <span>J15 à J55<span class="pf__base-long">, environ six semaines</span></span>
      </div>

      {stops.map((s) => (
        <span class:list={['pf__stop', `pf__stop--${s.place}`, `pf__stop--${s.tier}`]} style={`left:${px(s.day)};top:${py(days[s.day].a)}`} data-pf-stop data-day={s.day}>
          {s.name && (
            <span class="pf__label"><strong>{s.name}</strong> <span>{s.alt}</span></span>
          )}
        </span>
      ))}

      <span class="pf__walker" data-pf-walker></span>
    </div>

    <div class="pf__ruler" data-pf-ruler>
      {rulerTicks.map((a) => (
        <span class:list={['pf__tick', { 'pf__tick--label': a % 2000 === 0, 'pf__tick--top': a === 8000 }]} style={`top:${py(a)}`}>
          {a % 2000 === 0 && <span>{fmt(a)} m</span>}
        </span>
      ))}
      <span class="pf__marker" data-pf-marker></span>
    </div>

    <div class="pf__axis">
      <div class="pf__phasebar">
        {phases.map((p) => (
          <span class="pf__seg" style={`left:${segLeft(p.from)}%;width:${segWidth(p.from, p.to)}%`}>
            <span class="pf__seg-fill" data-pf-seg data-from={p.from} data-to={p.to}></span>
            <span class="pf__seg-n">{p.n}</span>
          </span>
        ))}
      </div>
      <div class="pf__days">
        {xTicks.map((t) => (
          <span class:list={[{ 'pf__day--minor': t.minor }]} style={`left:${px(t.d)}`}>{t.label}</span>
        ))}
      </div>
    </div>
  </div>

  <div class="pf__replay-row">
    <button type="button" class="pf__replay" data-pf-replay hidden>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 4v5h5"/></svg>
      Revoir le parcours
    </button>
  </div>

  <ol class="pf__phases">
    {phases.map((p) => (
      <li class="pf__phase reveal">
        <span class="pf__phase-n" aria-hidden="true">{p.n}</span>
        <div>
          <p class="pf__phase-days">{p.days}</p>
          <h4>{p.title}</h4>
          <p>{p.text}</p>
        </div>
      </li>
    ))}
  </ol>
  <p class="pf__note">Altitude de nuit, jour par jour. Étapes et altitudes indicatives, ajustées sur place selon la météo et l’état du groupe.</p>
</figure>

<script define:vars={{ walkData }}>
  window.__pfData = walkData;
</script>

<script>
  import { seenStart } from '../../scripts/altitude-motion';
  type WalkData = { days: number[]; places: string[]; vbW: number; vbH: number; altMax: number; x0: number; xw: number };

  const init = () => {
    const root = document.querySelector<HTMLElement>('[data-pf]');
    const data = (window as unknown as { __pfData?: WalkData }).__pfData;
    if (!root || !data) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const $ = <T extends Element = HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const $$ = <T extends Element = HTMLElement>(s: string) => Array.from(root.querySelectorAll<T>(s));

    const plot = $('[data-pf-plot]');
    const ruler = $('[data-pf-ruler]');
    const walker = $('[data-pf-walker]');
    const marker = $('[data-pf-marker]');
    const trail = $('[data-pf-trail]');
    const hud = $('[data-pf-hud]');
    const hudDay = $('[data-pf-day]');
    const hudAlt = $('[data-pf-alt]');
    const hudPlace = $('[data-pf-place]');
    const replay = $<HTMLButtonElement>('[data-pf-replay]');
    const layers = $$('[data-pf-layer]');
    const snow = $$('[data-pf-snow]');
    const sun = $('[data-pf-sun]');
    const fades = $$('[data-pf-fade]');
    const stops = $$('[data-pf-stop]');
    const tents = $$('[data-pf-tent]');
    const base = $('[data-pf-base]');
    const segs = $$('[data-pf-seg]');

    const fmt = (n: number) => String(n).replace(/\B(?=(\d{3})+(?!\d))/g, '’');
    const altAt = (d: number) => {
      const i = Math.min(Math.floor(d), 60);
      const j = Math.min(i + 1, 60);
      const t = d - i;
      return data.days[i - 1] * (1 - t) + data.days[j - 1] * t;
    };

    let size = { w: plot.clientWidth, h: plot.clientHeight, rh: ruler.clientHeight };
    let current = 60;

    const place = (d: number) => {
      const x = ((data.x0 + ((d - 1) / 59) * data.xw) / data.vbW) * size.w;
      const y = (1 - altAt(d) / data.altMax) * size.h;
      walker.style.transform = `translate(${x}px, ${y}px)`;
      marker.style.transform = `translateY(${(1 - altAt(d) / data.altMax) * size.rh}px)`;
      const pct = ((data.x0 + ((d - 1) / 59) * data.xw) / data.vbW) * 100;
      trail.style.clipPath = `inset(-6% ${(100 - pct).toFixed(2)}% -6% -2%)`;
    };

    const setHud = (d: number) => {
      const day = Math.min(60, Math.max(1, Math.floor(d + 0.0001)));
      hudDay.textContent = `J${day}`;
      hudAlt.textContent = day === 60 ? 'vol retour' : `${fmt(data.days[day - 1])} m`;
      hudPlace.textContent = day === 60 ? 'Katmandou, Genève' : data.places[day - 1];
    };

    new ResizeObserver(() => {
      size = { w: plot.clientWidth, h: plot.clientHeight, rh: ruler.clientHeight };
      place(current);
    }).observe(plot);

    import('gsap').then(({ gsap }) => {
      import('gsap/ScrollTrigger').then(({ ScrollTrigger }) => {
        gsap.registerPlugin(ScrollTrigger);

        const hideWalk = () => {
          gsap.set(stops, { opacity: 0, scale: 0.4 });
          gsap.set(tents, { opacity: 0, y: 10 });
          gsap.set(base, { opacity: 0, y: 12 });
          gsap.set(segs, { scaleX: 0 });
          gsap.set([walker, marker], { opacity: 0 });
          trail.style.clipPath = 'inset(-6% 100% -6% -2%)';
        };

        // Couches opaques qui montent depuis sous le cadre : le soleil ne transparaît pas à travers la roche.
        gsap.set(layers, { yPercent: 100 });
        gsap.set(snow, { opacity: 0 });
        gsap.set(sun, { yPercent: 90, opacity: 0 });
        gsap.set(fades, { opacity: 0 });
        gsap.set(hud, { opacity: 0, y: 10 });
        hideWalk();

        const walk = () => {
          const shown = new Set<Element>();
          const reveal = (d: number) => {
            for (const el of stops) {
              if (!shown.has(el) && d >= Number(el.dataset.day)) {
                shown.add(el);
                gsap.to(el, { opacity: 1, scale: 1, duration: 0.5, ease: 'back.out(2.2)' });
              }
            }
            for (const el of tents) {
              if (!shown.has(el) && d >= Number(el.dataset.day)) {
                shown.add(el);
                gsap.to(el, { opacity: 1, y: 0, duration: 0.45, ease: 'power3.out' });
              }
            }
            if (!shown.has(base) && d >= 16) {
              shown.add(base);
              gsap.to(base, { opacity: 1, y: 0, duration: 0.8, ease: 'power3.out' });
            }
            for (const el of segs) {
              const from = Number(el.dataset.from) - 0.5;
              const to = Number(el.dataset.to) + 0.5;
              el.style.transform = `scaleX(${Math.min(1, Math.max(0, (d - from) / (to - from)))})`;
            }
          };

          const state = { d: 1 };
          const tick = () => {
            current = state.d;
            place(state.d);
            setHud(state.d);
            reveal(state.d);
          };
          return gsap.timeline({ onStart: tick })
            .to([walker, marker], { opacity: 1, duration: 0.3 })
            .to(state, { d: 14, duration: 1.8, ease: 'power1.inOut', onUpdate: tick })
            .to(state, { d: 55, duration: 1.4, ease: 'none', onUpdate: tick })
            .to(state, { d: 60, duration: 1.0, ease: 'power2.out', onUpdate: tick })
            .add(() => {
              replay.setAttribute('aria-disabled', 'false');
              if (replay.hidden) {
                replay.hidden = false;
                gsap.fromTo(replay, { opacity: 0, y: 6 }, { opacity: 1, y: 0, duration: 0.5 });
              }
            });
        };

        const intro = gsap.timeline({ paused: true })
          .to(sun, { yPercent: 0, opacity: 1, duration: 1.6, ease: 'expo.out' }, 0)
          .to(layers, { yPercent: 0, duration: 1.4, ease: 'power4.out', stagger: 0.14 }, 0.05)
          .to(snow, { opacity: 1, duration: 0.9, ease: 'power2.out', stagger: 0.12 }, 0.7)
          .to(fades, { opacity: 1, duration: 0.7 }, 1.1)
          .to(hud, { opacity: 1, y: 0, duration: 0.6, ease: 'power3.out' }, 1.0)
          .add(() => { walk(); }, 1.3);

        // Démarre quand le paysage est entièrement à l'écran : la marche se voit de Katmandou au retour.
        ScrollTrigger.create({ trigger: plot, start: seenStart(plot), once: true, onEnter: () => intro.play() });

        // aria-disabled plutôt que disabled : le bouton garde le focus clavier pendant la relecture.
        replay.addEventListener('click', () => {
          if (replay.getAttribute('aria-disabled') === 'true') return;
          replay.setAttribute('aria-disabled', 'true');
          hideWalk();
          walk();
        });
      });
    });
  };

  if (document.readyState === 'complete') init();
  else window.addEventListener('load', init, { once: true });
</script>

<style lang="scss">
  $night: #111111;
  $snow: #F2F0EB;

  .pf-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .pf {
    margin: 0;
    position: relative;
  }

  // ---------- Compteur ----------
  .pf__hud {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 12px;
    margin-bottom: 24px;
    font-variant-numeric: tabular-nums;
    color: $snow;
  }

  .pf__hud-day {
    font-family: var(--font-headline);
    font-weight: 700;
    font-size: clamp(30px, 3.4vw, 48px);
    line-height: 1;
    letter-spacing: -0.01em;
    color: $snow;
    // « J60 » : trois signes réservés, la suite du compteur ne glisse pas quand on passe de J9 à J10.
    min-width: 3ch;
  }

  .pf__hud-alt {
    font-family: var(--font-headline);
    font-weight: 700;
    font-size: var(--fs-md);
    color: var(--color-accent);
  }

