---
// Pied de page propre à la page Altitude : il remplace celui du site (slot « footer » du Layout)
// et en reprend tout le contenu (logo, navigation, contact, mentions).
// Bandeau de mots qui défile, colonnes nettes, sentier en pointillés jusqu'au retour en haut,
// puis le mot ALTITUDE géant dont les lettres se remplissent de jaune, comme une altitude qu'on gagne.
const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();

const words = ['Préparer', 'Marcher', 'Concrétiser', 'Népal', 'Printemps 2027', 'Kanchenjunga', '60 jours', 'Cinq jeunes'];

const programme = [
  { href: '#en-bref', label: 'En bref' },
  { href: '#sejour', label: 'Le séjour au Népal' },
  { href: '#equipe', label: 'L’équipe sur le terrain' },
  { href: '#orienter', label: 'Orienter un jeune' },
];

const site = [
  { href: `${base}#about`, label: 'Notre vision' },
  { href: `${base}#method`, label: 'Méthode' },
  { href: `${base}#team`, label: 'L’équipe' },
  { href: `${base}galerie`, label: 'Galerie' },
  { href: `${base}temoignages`, label: 'Témoignages' },
  { href: `${base}impulsion`, label: 'Impulsion' },
  { href: `${base}altitude`, label: 'Altitude', current: true },
];

const letters = 'ALTITUDE'.split('');
const DOTS = 64;
---

<footer class="af" data-af>
  <!-- Bandeau : deux copies identiques, la piste glisse d'une copie pour boucler sans couture. -->
  <div class="af__marquee" aria-hidden="true" data-af-marquee>
    <div class="af__track" data-af-track>
      {[0, 1].map(() => (
        <div class="af__group">
          {words.map((w, i) => (
            <>
              <span class:list={['af__word', { 'is-outline': i % 2 === 1 }]}>{w}</span>
              <i class="af__sep"></i>
            </>
          ))}
        </div>
      ))}
    </div>
  </div>

  <div class="container">
    <div class="af__grid" data-af-grid>
      <div class="af__brand" data-af-col>
        <a href={base} class="af__logo-link" aria-label="Accueil Jeunesse & Co">
          <img src={`${base}assets/Logo1-Blanc.svg`} alt="" class="af__logo" width="160" height="36" />
        </a>
        <p class="af__tagline">L’accompagnement éducatif sur mesure au cœur de Genève.</p>
        <p class="af__program">Programme ALTITUDE · Népal, printemps 2027</p>
      </div>

      <nav class="af__col" aria-label="Programme Altitude" data-af-col>
        <p class="af__label">Le programme</p>
        <ul class="af__links" role="list">
          {programme.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </nav>

      <nav class="af__col" aria-label="Jeunesse & Co" data-af-col>
        <p class="af__label">Navigation</p>
        <ul class="af__links" role="list">
          {site.map((l) => <li><a href={l.href} aria-current={l.current ? 'page' : undefined}>{l.label}</a></li>)}
        </ul>
      </nav>

      <div class="af__col af__contact" data-af-col>
        <p class="af__label">Contact</p>
        <a class="af__big" href="mailto:info@jeunesseandco.ch">info@jeunesseandco.ch</a>
        <a class="af__big" href="tel:+41227311947">+41 (0)22 731 19 47</a>
        <address class="af__address">Quai du Seujet 14<br />1201 Genève</address>
      </div>
    </div>

    <!-- Sentier en pointillés jusqu'au retour en haut de page (lien « # » : fonctionne sans JS). -->
    <div class="af__trailrow" data-af-trailrow>
      <div class="af__trail" aria-hidden="true">
        {Array.from({ length: DOTS }, () => <i class="af__dot" data-af-dot></i>)}
      </div>
      <a class="af__top" href="#" data-af-top>
        <span class="af__top-label">Retour en haut</span>
        <span class="af__top-btn" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M12 19V5M6 11l6-6 6 6" /></svg>
        </span>
      </a>
    </div>
  </div>

  <!-- Mot géant décoratif : contour pâle, remplissage jaune qui monte lettre par lettre. -->
  <div class="container af__giant-box">
    <p class="af__giant" aria-hidden="true" data-af-giant>
      {letters.map((l) => (
        <span class="af__glyph" data-af-glyph>
          <span class="af__ghost">{l}</span>
          <span class="af__win" data-af-win><span class="af__fill" data-af-fill>{l}</span></span>
        </span>
      ))}
    </p>
  </div>

  <div class="container">
    <div class="af__bottom" data-af-bottom>
      <p>© {year} Jeunesse & Co. Tous droits réservés.</p>
      <p>Construire un projet, le marcher, le faire tenir.</p>
    </div>
  </div>
</footer>

<script>
  import { reducedMotion, seenStart } from '../../scripts/altitude-motion';

  const initFooter = async () => {
    const root = document.querySelector<HTMLElement>('[data-af]');
    if (!root || reducedMotion()) return;
    const [{ gsap }, { ScrollTrigger }] = await Promise.all([import('gsap'), import('gsap/ScrollTrigger')]);
    gsap.registerPlugin(ScrollTrigger);

    const q = (sel: string) => Array.from(root.querySelectorAll<HTMLElement>(sel));
    const seen = (el: Element | null, play: () => void) => {
      if (el) ScrollTrigger.create({ trigger: el, start: seenStart(el), once: true, onEnter: play });
    };

    // ---------- Bandeau : défile seulement à l'écran, s'emballe avec le défilement, change de sens en remontant ----------
    const marquee = root.querySelector<HTMLElement>('[data-af-marquee]');
    const track = root.querySelector<HTMLElement>('[data-af-track]');
    if (marquee && track) {
      const LOOP = 36;
      const loop = gsap.to(track, { xPercent: -50, ease: 'none', duration: LOOP, repeat: -1, paused: true });
      // Départ au milieu d'un grand nombre de tours : la marche arrière a toujours de la place.
      loop.totalTime(LOOP * 200);
      ScrollTrigger.create({
        trigger: marquee,
        start: 'top bottom',
        end: 'bottom top',
        onToggle: (self) => (self.isActive ? loop.play() : loop.pause()),
        onUpdate: (self) => {
          const v = Math.abs(self.getVelocity());
          if (v < 40) return;
          loop.timeScale(self.direction * Math.min(1 + v / 450, 6));
          gsap.to(loop, { timeScale: 1, duration: 1.6, ease: 'power3.out', overwrite: true });
        },
      });
    }

    // ---------- Colonnes : elles montent en rebond, l'une après l'autre ----------
    const cols = q('[data-af-col]');
    gsap.set(cols, { opacity: 0, y: 36 });
    seen(root.querySelector('[data-af-grid]'), () => {
      gsap.to(cols, { opacity: 1, y: 0, duration: 0.9, ease: 'back.out(1.5)', stagger: 0.1 });
    });

    // ---------- Sentier : les points rebondissent jusqu'au bouton de retour en haut ----------
    const dots = q('[data-af-dot]');
    const top = q('[data-af-top]');
    gsap.set(dots, { scale: 0 });
    gsap.set(top, { opacity: 0, scale: 0.6, y: 12 });
    seen(root.querySelector('[data-af-trailrow]'), () => {
      gsap.timeline()
        .to(dots, { scale: 1, duration: 0.45, ease: 'back.out(4)', stagger: 0.016 })
        .to(top, { opacity: 1, scale: 1, y: 0, duration: 0.7, ease: 'back.out(2.6)', clearProps: 'transform' }, '-=0.3');
    });

    // ---------- Mot géant : chaque lettre se remplit de jaune de bas en haut, puis sautille ----------
    // Fenêtre et contenu glissent en sens opposés (transform seulement) : la lettre jaune reste
    // immobile pendant que la fenêtre qui la découvre monte.
    const glyphs = q('[data-af-glyph]');
    const wins = q('[data-af-win]');
    const fills = q('[data-af-fill]');
    const bottom = q('[data-af-bottom]');
    const hop = (glyph: HTMLElement) => gsap.timeline()
      .to(glyph, { yPercent: -12, duration: 0.18, ease: 'power2.out' })
      .to(glyph, { yPercent: 0, duration: 0.75, ease: 'bounce.out' });
    gsap.set(wins, { yPercent: 100 });
    gsap.set(fills, { yPercent: -100 });
    gsap.set(bottom, { opacity: 0, y: 16 });
    let ready = false;
    seen(root.querySelector('[data-af-giant]'), () => {
      const tl = gsap.timeline({ onComplete: () => { ready = true; } });
      glyphs.forEach((glyph, i) => {
        const t = i * 0.11;
        tl.to(wins[i], { yPercent: 0, duration: 1.1, ease: 'power3.inOut' }, t)
          .to(fills[i], { yPercent: 0, duration: 1.1, ease: 'power3.inOut' }, t)
          .add(hop(glyph), t + 0.95);
      });
      tl.to(bottom, { opacity: 1, y: 0, duration: 0.8, ease: 'power3.out' }, 0.6);
    });

    // Au survol, une lettre pleine sautille.
    glyphs.forEach((glyph) => {
      glyph.addEventListener('mouseenter', () => {
        if (ready && !gsap.isTweening(glyph)) hop(glyph);
      });
    });
  };

  if (document.readyState === 'complete') initFooter();
  else window.addEventListener('load', initFooter, { once: true });
</script>

<style lang="scss">
  $ease: cubic-bezier(0.16, 1, 0.3, 1);
  $snow: #F2F0EB;

  .af {
    position: relative;
    overflow: hidden;
    background: var(--color-primary);
    color: $snow;
  }

  // ---------- Bandeau ----------
  .af__marquee {
    overflow: hidden;
    padding: 28px 0 30px;
    border-bottom: 1px solid rgba(242, 240, 235, 0.1);

    @media (max-width: 768px) { padding: 20px 0 22px; }
  }

  .af__track {
    display: flex;
    width: max-content;
    will-change: transform;
  }

  .af__group {
    flex: none;
    display: flex;
    align-items: center;
    gap: 0.42em;
    padding-right: 0.42em;
    font-family: var(--font-headline);
    font-weight: 700;
    font-size: clamp(40px, 6vw, 92px);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .af__word {
    white-space: nowrap;
    color: $snow;

    // Un mot sur deux en contour : le bandeau respire.
    &.is-outline {
      color: transparent;
      -webkit-text-stroke: 1.5px rgba(242, 240, 235, 0.75);
    }
  }

  .af__sep {
    flex: none;
    width: 0.2em;
    height: 0.2em;
    border-radius: 50%;
    background: var(--color-accent);
  }

  // ---------- Colonnes ----------
  .af__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1.35fr);
    gap: 48px 40px;
    padding-top: 96px;

    @media (max-width: 1024px) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      padding-top: 72px;

      .af__brand,
      .af__contact { grid-column: 1 / -1; }
    }

    @media (max-width: 768px) {
      gap: 40px 24px;
      padding-top: 56px;
    }
  }

  .af__logo-link {
    display: inline-block;
    border-radius: 6px;
  }

  .af__logo {
    display: block;
    height: 56px;
    width: auto;

    @media (max-width: 768px) { height: 44px; }
  }

  .af__tagline {
    max-width: 22em;
    margin: 24px 0 0;
    font-size: var(--fs-base);
    line-height: 1.6;
    color: rgba(242, 240, 235, 0.68);
  }

  .af__program {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 20px 0 0;
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);

    &::before {
      content: '';
      width: 18px;
      height: 2px;
      background: var(--color-accent);
    }
  }

  .af__label {
    margin: 0 0 20px;
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .af__links {
    list-style: none;
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;

    a {
      position: relative;
      display: inline-block;
      font-size: var(--fs-base);
      color: rgba(242, 240, 235, 0.8);
      transition: color 0.3s ease, transform 0.45s $ease;

      // Soulignement qui se déroule au survol.
      &::after {
        content: '';
        position: absolute;
        left: 0;
        right: 0;
        bottom: -3px;
        height: 2px;
        background: var(--color-accent);
        transform: scaleX(0);
        transform-origin: right center;
        transition: transform 0.45s $ease;
      }

      &:hover {
        color: $snow;
        transform: translateX(4px);

        &::after {
          transform: scaleX(1);
          transform-origin: left center;
        }
      }

      &[aria-current='page'] { color: var(--color-accent); }
    }
  }

  .af__big {
    display: block;
    width: fit-content;
    max-width: 100%;
    margin-bottom: 10px;
    font-family: var(--font-headline);
    font-weight: 700;
    font-size: var(--fs-md);
    line-height: 1.25;
    color: $snow;
    overflow-wrap: anywhere;
    // Trait jaune qui se remplit au survol, de gauche à droite.
    background: linear-gradient(var(--color-accent), var(--color-accent)) 0 100% / 0% 2px no-repeat;
    transition: background-size 0.5s $ease, color 0.3s ease;

    &:hover {
      color: var(--color-accent);
      background-size: 100% 2px;
    }
  }

  .af__address {
    margin-top: 14px;
    font-style: normal;
    font-size: var(--fs-base);
    line-height: 1.6;
    color: rgba(242, 240, 235, 0.68);
  }

  // ---------- Sentier et retour en haut ----------
  .af__trailrow {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-top: 88px;

    @media (max-width: 768px) {
      gap: 16px;
      margin-top: 64px;
    }
  }

  .af__trail {
    flex: 1 1 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-width: 0;
  }

  .af__dot {
    flex: none;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent);

    // Petit écran : un point sur deux, l'écart reste celui du sentier du hero.
    @media (max-width: 768px) {
      &:nth-child(2n) { display: none; }
    }
  }

  .af__top {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 14px;
    border-radius: 100px;
    font-size: var(--fs-base);
    font-weight: 600;
    color: $snow;
  }

  .af__top-label {
    @media (max-width: 420px) {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
  }

  .af__top-btn {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    border: 2px solid var(--color-accent);
    color: var(--color-accent);
    transition: background-color 0.3s ease, color 0.3s ease, transform 0.45s $ease;

    svg {
      width: 22px;
      height: 22px;
      transition: transform 0.45s $ease;
    }

    .af__top:hover & {
      background: var(--color-accent);
      color: var(--color-primary);
      transform: translateY(-4px);

      svg { transform: translateY(-2px); }
    }
  }

  // ---------- Mot géant ----------
  // Taille en unités du conteneur : le mot occupe toute la largeur utile sans jamais déborder
  // (ALTITUDE = 3,99 em de large ; 24,5 % de la largeur ≈ 98 % de la ligne).
  .af__giant-box {
    container-type: inline-size;
    margin-top: 56px;

    @media (max-width: 768px) { margin-top: 40px; }
  }

  .af__giant {
    display: flex;
    justify-content: space-between;
    // Les capitales n'occupent pas toute la hauteur de ligne : on resserre au-dessus et en dessous
    // (les boîtes des lettres, qui servent de fenêtre au remplissage, restent entières).
    margin: -0.13em 0 -0.16em;
    font-family: var(--font-headline);
    font-weight: 700;
    font-size: 24.5cqi;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-accent);
    user-select: none;
  }

  .af__glyph {
    position: relative;
    display: inline-block;
    cursor: default;
  }

  // Contour pâle : la lettre « vide » avant de se remplir.
  .af__ghost {
    display: block;
    color: transparent;
    -webkit-text-stroke: 1.5px rgba(242, 240, 235, 0.3);
  }

  .af__win {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .af__fill {
    display: block;
    color: var(--color-accent);
  }

  // ---------- Mentions ----------
  .af__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 32px;
    padding: 28px 0 40px;
    border-top: 1px solid rgba(242, 240, 235, 0.12);

    p {
      margin: 0;
      font-size: var(--fs-base);
      line-height: 1.5;
      color: rgba(242, 240, 235, 0.68);
    }

    p + p { color: var(--color-accent); }

    @media (max-width: 768px) {
      flex-direction: column;
      padding-bottom: 32px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .af__links a,
    .af__links a::after,
    .af__big,
    .af__top-btn,
    .af__top-btn svg { transition: none; }
  }
</style>
