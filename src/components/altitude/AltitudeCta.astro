---
// Appel à orienter un jeune : contacts de la direction.
// Titre dont les lettres d'ALTITUDE rebondissent, cartes de contact aux icônes dessinées.
// Chaque bloc s'anime quand il est à l'écran (titre d'un côté, contacts de l'autre).
const letters = 'ALTITUDE'.split('');

const contacts = [
  {
    href: 'mailto:info@jeunesseandco.ch?subject=Programme%20ALTITUDE',
    label: 'Écrire',
    value: 'info@jeunesseandco.ch',
    icon: '<rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="m3.6 7.2 8.4 6.1 8.4-6.1"/>',
  },
  {
    href: 'tel:+41227311947',
    label: 'Appeler',
    value: '+41 (0)22 731 19 47',
    icon: '<rect x="6.5" y="2.5" width="11" height="19" rx="2.6"/><path d="M10.4 18.4h3.2"/>',
  },
];
---

<section class="alt-section cta" id="orienter" aria-labelledby="cta-title" data-cta>
  <div class="container cta__grid">
    <div class="cta__main" data-cta-main>
      <p class="cta__kicker" data-cta-fade>Contact</p>
      <h2 class="cta__title" id="cta-title" aria-label="Orienter un jeune vers ALTITUDE">
        <span class="cta__clip" aria-hidden="true"><span class="cta__line" data-cta-line>Orienter un jeune vers</span></span>
        <span class="cta__word" aria-hidden="true">
          {letters.map((l) => <span class="cta__letter" data-cta-letter>{l}</span>)}
        </span>
      </h2>
      <p class="cta__lead" data-cta-fade>Autorités, services, familles&nbsp;: la direction de Jeunesse&amp;Co répond à vos questions, vous rencontre et présente le programme au jeune et à sa famille.</p>
    </div>

    <div class="cta__side" data-cta-side>
      <ul class="cta__contact" role="list">
        {contacts.map((c) => (
          <li data-cta-card>
            <a class="cta__link" href={c.href}>
              <span class="cta__icon" data-cta-icon>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={c.icon} />
              </span>
              <span class="cta__text">
                <span class="cta__label">{c.label}</span>
                <span class="cta__value">{c.value}</span>
              </span>
              <span class="cta__go" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
              </span>
            </a>
          </li>
        ))}
      </ul>
      <p class="cta__sign" data-cta-sign>Hacene Debbah, directeur et fondateur · Quai du Seujet 14, 1201 Genève</p>
    </div>
  </div>
</section>

<script>
  import { reducedMotion, prepareIcon, popDrawIcon, seenStart } from '../../scripts/altitude-motion';

  const initCta = async () => {
    const root = document.querySelector<HTMLElement>('[data-cta]');
    if (!root || reducedMotion()) return;
    const [{ gsap }, { ScrollTrigger }] = await Promise.all([import('gsap'), import('gsap/ScrollTrigger')]);
    gsap.registerPlugin(ScrollTrigger);

    const q = (sel: string) => Array.from(root.querySelectorAll<HTMLElement>(sel));
    const main = root.querySelector<HTMLElement>('[data-cta-main]');
    const side = root.querySelector<HTMLElement>('[data-cta-side]');

    // ---------- Titre : la ligne monte, puis les lettres d'ALTITUDE rebondissent l'une après l'autre ----------
    if (main) {
      const fades = q('[data-cta-fade]');
      const line = q('[data-cta-line]');
      const letters = q('[data-cta-letter]');
      // États de départ posés par le JS seulement : sans JS ou en mouvement réduit, tout reste visible.
      gsap.set(fades, { opacity: 0, y: 24 });
      gsap.set(line, { yPercent: 110 });
      gsap.set(letters, { yPercent: 125, rotate: 14, transformOrigin: '0% 100%' });

      const tl = gsap.timeline({ paused: true, defaults: { ease: 'power3.out' } })
        .to(fades[0], { opacity: 1, y: 0, duration: 0.6 }, 0)
        .to(line, { yPercent: 0, duration: 0.9, ease: 'expo.out' }, 0.05)
        .to(letters, { yPercent: 0, rotate: 0, duration: 0.95, ease: 'back.out(2.2)', stagger: 0.055 }, 0.2)
        .to(fades[1], { opacity: 1, y: 0, duration: 0.8 }, 0.6);
      ScrollTrigger.create({ trigger: main, start: seenStart(main), once: true, onEnter: () => tl.play() });
    }

    // ---------- Contacts : les cartes glissent en rebond, leur icône se dessine ----------
    if (side) {
      const cards = q('[data-cta-card]');
      const icons = q('[data-cta-icon]');
      const sign = q('[data-cta-sign]');
      gsap.set(cards, { opacity: 0, x: 48 });
      gsap.set(sign, { opacity: 0, y: 16 });
      const strokes = icons.map((icon) => prepareIcon(gsap, icon));

      const tl = gsap.timeline({ paused: true })
        .to(cards, { opacity: 1, x: 0, duration: 0.8, ease: 'back.out(1.6)', stagger: 0.12 }, 0)
        .to(sign, { opacity: 1, y: 0, duration: 0.7, ease: 'power3.out' }, 0.5);
      icons.forEach((icon, i) => tl.add(popDrawIcon(gsap, icon, strokes[i]), 0.25 + i * 0.12));
      ScrollTrigger.create({ trigger: side, start: seenStart(side), once: true, onEnter: () => tl.play() });
    }
  };

  if (document.readyState === 'complete') initCta();
  else window.addEventListener('load', initCta, { once: true });
</script>

<style lang="scss">
  $ease: cubic-bezier(0.16, 1, 0.3, 1);

  .cta {
    position: relative;
    overflow: hidden;
    background: var(--color-accent);
    color: var(--color-primary);
  }

  // Titre à gauche, contacts à droite, calés sur la même ligne de pied.
  .cta__grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 48px 80px;
    align-items: end;

    @media (max-width: 1024px) {
      grid-template-columns: 1fr;
      row-gap: 40px;
    }
  }

  // ---------- Titre ----------
  .cta__kicker {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 24px;
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-primary);

    &::before {
      content: '';
      width: 18px;
      height: 2px;
      background: var(--color-primary);
    }
  }

  // Le titre global colore les span des h2 en jaune : ici tout reste noir.
  .cta__title {
    margin: 0 0 32px;
    color: var(--color-primary);

    span { color: var(--color-primary); }
  }

  .cta__clip {
    display: block;
    overflow: hidden;
    padding-bottom: 0.06em;
  }

  .cta__line {
    display: block;
    font-size: var(--fs-lg);
    line-height: 1.05;
    letter-spacing: -0.01em;
  }

  // ALTITUDE en grand, mais sous le mot géant du pied de page qui clôt la page.
  .cta__word {
    display: flex;
    overflow: hidden;
    // place pour le rebond des lettres sans les rogner
    padding: 0.1em 0 0.02em;
    margin: -0.06em 0 0 -0.02em;
    font-size: clamp(64px, 15vw, 124px);
    line-height: 0.82;
    letter-spacing: -0.02em;
  }

  .cta__letter {
    display: inline-block;
    will-change: transform;
  }

  .cta__lead {
    max-width: 34em;
    margin: 0;
    font-size: var(--fs-md);
    line-height: 1.5;
    color: rgba(17, 17, 17, 0.86);
  }

  // ---------- Contacts ----------
  .cta__side {
    display: grid;
    gap: 16px;
  }

  .cta__contact {
    list-style: none;
    display: grid;
    gap: 12px;
    width: 100%;
    margin: 0;
    padding: 0;

    // Deux cartes côte à côte seulement quand l'adresse tient sur une ligne.
    @media (min-width: 901px) and (max-width: 1024px) { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  .cta__link {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 18px;
    padding: 18px 20px 18px 18px;
    border-radius: 22px;
    background: var(--color-primary);
    color: #F2F0EB;
    text-decoration: none;
    transition: transform 0.45s $ease, box-shadow 0.45s $ease;

    &:hover {
      transform: translateY(-4px);
      box-shadow: 0 18px 40px rgba(17, 17, 17, 0.28);
    }

    // Le contour de focus du site est jaune : invisible sur ce fond, il passe au noir.
    &:focus-visible {
      outline: 3px solid var(--color-primary);
      outline-offset: 4px;
    }

    @media (max-width: 420px) {
      gap: 14px;
      padding: 16px;
    }
  }

  .cta__icon {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--color-accent);
    color: var(--color-primary);
    transition: transform 0.5s $ease;

    svg { width: 26px; height: 26px; }

    .cta__link:hover & { transform: rotate(-10deg) scale(1.06); }

    @media (max-width: 420px) {
      width: 44px;
      height: 44px;

      svg { width: 22px; height: 22px; }
    }
  }

  .cta__text {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .cta__label {
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .cta__value {
    font-family: var(--font-headline);
    font-weight: 700;
    font-size: var(--fs-md);
    line-height: 1.15;
    overflow-wrap: anywhere;
  }

  .cta__go {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1.5px solid rgba(242, 240, 235, 0.3);
    color: #F2F0EB;
    transition: background-color 0.3s ease, border-color 0.3s ease, color 0.3s ease;

    svg {
      width: 18px;
      height: 18px;
      transition: transform 0.45s $ease;
    }

    .cta__link:hover & {
      background: var(--color-accent);
      border-color: var(--color-accent);
      color: var(--color-primary);

      svg { transform: translateX(3px); }
    }

    @media (max-width: 420px) { display: none; }
  }

  .cta__sign {
    margin: 4px 0 0;
    font-size: var(--fs-xs);
    line-height: 1.5;
    color: rgba(17, 17, 17, 0.75);
  }

  @media (prefers-reduced-motion: reduce) {
    .cta__link,
    .cta__icon,
    .cta__go,
    .cta__go svg { transition: none; }
  }
</style>
