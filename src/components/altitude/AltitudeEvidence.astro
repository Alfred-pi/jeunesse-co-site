---
// Ce que dit la recherche : quatre études, chacune avec un visuel qui fait lire son chiffre,
// puis les quatre conditions de réussite et la réponse d'ALTITUDE. Source : dossier, page 15.
const squares = Array.from({ length: 96 });
const pictos = Array.from({ length: 25 }, (_, i) => i < 14);
const peaks = Array.from({ length: 11 });

const conditions = [
  { c: 'L’adhésion du jeune', r: 'Entretien d’admission, démarche active, contrat d’engagement.' },
  { c: 'La durée et l’intensité', r: 'Plusieurs mois à 40 h par semaine, puis 60 jours au Népal.' },
  { c: 'Une relation de confiance avec un adulte fiable', r: 'Les mêmes adultes du premier jour de préparation à la fin de l’accompagnement.' },
  { c: 'La continuité au retour', r: 'Projet post-séjour engagé avant le départ, six mois d’accompagnement au minimum.' },
];
---

<div class="evi" data-evidence>
  <div class="evi__studies">
    <!-- Seuil : l'anneau, pièce maîtresse -->
    <article class="evi__lead" data-evi="ring">
      <div class="evi__ring">
        <svg viewBox="0 0 200 200" aria-hidden="true">
          <circle cx="100" cy="100" r="86" class="evi__ring-track" />
          <circle cx="100" cy="100" r="86" class="evi__ring-fill" pathLength="100" data-ring />
        </svg>
        <p class="evi__ring-value" aria-hidden="true"><span class="evi__ring-num"><span data-count="76">76</span><span class="evi__ring-unit">%</span></span></p>
      </div>
      <div class="evi__lead-text">
        <p class="evi__kicker">Marches éducatives de l’association Seuil</p>
        <p class="evi__statement">Parmi les jeunes qui ont marché <strong>plus de 60 jours</strong>, <strong>76 %</strong> présentent une évolution positive un à deux ans après.</p>
        <a class="evi__source" href="https://oip.org/analyse/marcher-pour-se-remettre-sur-les-rails/" target="_blank" rel="noopener">Évaluation Pro-Éthique, cohortes 2015-2016<span class="sr-only"> (nouvel onglet)</span></a>
      </div>
    </article>

    <div class="evi__stack">
      <!-- Hattie : 96 études -->
      <article class="evi__row" data-evi="squares">
        <div class="evi__visual evi__squares" aria-hidden="true">
          {squares.map(() => <span class="evi__sq"></span>)}
        </div>
        <div class="evi__text">
          <p class="evi__figure">96 <span>études</span></p>
          <p class="evi__meta">1’728 mesures d’effet · éducation par l’aventure</p>
          <p>Effets positifs sur le concept de soi, le sentiment de contrôle sur sa vie et le leadership. Plus forts quand le programme est plus long, ils se maintiennent au suivi.</p>
          <a class="evi__source" href="https://eric.ed.gov/?id=EJ548328" target="_blank" rel="noopener">Hattie, Marsh, Neill & Richards, 1997, Review of Educational Research<span class="sr-only"> (nouvel onglet)</span></a>
        </div>
      </article>

      <!-- Moreau : 14 sur 25 -->
      <article class="evi__row" data-evi="pictos">
        <div class="evi__visual evi__pictos" aria-hidden="true">
          {pictos.map((on) => (
            <span class:list={['evi__picto', { 'is-on': on }]}>
              <svg viewBox="0 0 24 24"><circle cx="12" cy="7" r="4.2" /><path d="M3.5 22.5c0-4.9 3.8-8.6 8.5-8.6s8.5 3.7 8.5 8.6z" /></svg>
              {on && <svg viewBox="0 0 24 24" class="evi__picto-lit"><circle cx="12" cy="7" r="4.2" /><path d="M3.5 22.5c0-4.9 3.8-8.6 8.5-8.6s8.5 3.7 8.5 8.6z" /></svg>}
            </span>
          ))}
        </div>
        <div class="evi__text">
          <p class="evi__figure">14 <span>sur 25</span></p>
          <p class="evi__meta">Séjours de rupture et cheminement des adolescents</p>
          <p>Situations aboutissant à une insertion scolaire ou professionnelle. Le retour et la continuité du suivi sont déterminants.</p>
          <a class="evi__source" href="https://onpe.france-enfance-protegee.fr/wp-content/uploads/2024/01/aot2012.moreau_synthese.pdf" target="_blank" rel="noopener">Moreau, 2014, étude pour l’ONPE<span class="sr-only"> (nouvel onglet)</span></a>
        </div>
      </article>

      <!-- Beck & Wong : 11 études -->
      <article class="evi__row" data-evi="peaks">
        <div class="evi__visual evi__peaks" aria-hidden="true">
          {[peaks.slice(0, 6), peaks.slice(6)].map((row) => (
            <div class="evi__peaks-row">
              {row.map(() => (
                <svg viewBox="0 0 24 22" class="evi__peak">
                  <path d="M12 1 23.5 21H.5z" class="evi__peak-light" />
                  <path d="M12 1 23.5 21H12z" class="evi__peak-shade" />
                  <path d="M12 1 15.6 7.3 13.4 6.4 12 8.2 10.4 6.3 8.4 7.3z" class="evi__peak-snow" />
                </svg>
              ))}
            </div>
          ))}
        </div>
        <div class="evi__text">
          <p class="evi__figure">11 <span>études</span></p>
          <p class="evi__meta">Thérapie par la nature et délinquance juvénile</p>
          <p>Effets importants et significatifs sur les comportements délinquants, rapportés par les jeunes et par leurs proches.</p>
          <a class="evi__source" href="https://journals.sagepub.com/doi/10.1177/00938548221078002" target="_blank" rel="noopener">Beck & Wong, 2022, Criminal Justice and Behavior<span class="sr-only"> (nouvel onglet)</span></a>
        </div>
      </article>
    </div>
  </div>

  <div class="evi__conditions" data-evi="links">
    <h3 class="evi__conditions-title">Quatre conditions de réussite, <span>quatre réponses</span></h3>
    <ol>
      {conditions.map((x, i) => (
        <li class="evi__link">
          <span class="evi__link-n" aria-hidden="true">0{i + 1}</span>
          <p class="evi__link-c">{x.c}</p>
          <span class="evi__link-line" aria-hidden="true"><span></span><i></i></span>
          <p class="evi__link-r"><span class="sr-only">Réponse d’ALTITUDE : </span>{x.r}</p>
        </li>
      ))}
    </ol>
  </div>
</div>

<script>
  const init = () => {
    const root = document.querySelector<HTMLElement>('[data-evidence]');
    if (!root) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    import('gsap').then(({ gsap }) => {
      import('gsap/ScrollTrigger').then(({ ScrollTrigger }) => {
        gsap.registerPlugin(ScrollTrigger);
        const ease = 'power3.out';
        const on = (el: Element, tl: gsap.core.Timeline) =>
          ScrollTrigger.create({ trigger: el, start: 'top 75%', once: true, onEnter: () => tl.play() });

        // Anneau 76 % + compteur
        const ring = root.querySelector('[data-evi="ring"]');
        if (ring) {
          const fill = ring.querySelector('[data-ring]');
          const count = ring.querySelector<HTMLElement>('[data-count]');
          const text = ring.querySelectorAll('.evi__lead-text > *');
          const state = { v: 0 };
          gsap.set(fill, { strokeDashoffset: 100 });
          gsap.set(text, { opacity: 0, y: 16 });
          if (count) count.textContent = '0';
          const tl = gsap.timeline({ paused: true })
            .to(fill, { strokeDashoffset: 24, duration: 2, ease: 'power2.inOut' })
            .to(state, { v: 76, duration: 2, ease: 'power2.inOut', onUpdate: () => { if (count) count.textContent = String(Math.round(state.v)); } }, 0)
            .to(text, { opacity: 1, y: 0, duration: 0.8, stagger: 0.12, ease }, 0.6);
          on(ring, tl);
        }

        // 96 carrés en vague diagonale
        const sqRow = root.querySelector('[data-evi="squares"]');
        if (sqRow) {
          const sq = sqRow.querySelectorAll('.evi__sq');
          gsap.set(sq, { opacity: 0, scale: 0.2 });
          const tl = gsap.timeline({ paused: true })
            .to(sq, { opacity: 1, scale: 1, duration: 0.5, ease, stagger: { grid: [8, 12], from: 'start', axis: null, amount: 1.1 } });
          on(sqRow, tl);
        }

        // 14 pictogrammes allumés un par un sur 25
        const pRow = root.querySelector('[data-evi="pictos"]');
        if (pRow) {
          const all = pRow.querySelectorAll('.evi__picto');
          const lit = pRow.querySelectorAll('.evi__picto-lit');
          gsap.set(all, { opacity: 0, y: 6 });
          gsap.set(lit, { opacity: 0 });
          const tl = gsap.timeline({ paused: true })
            .to(all, { opacity: 1, y: 0, duration: 0.4, ease, stagger: 0.025 })
            .to(lit, { opacity: 1, duration: 0.3, ease: 'power2.out', stagger: 0.11 }, '+=0.1');
          on(pRow, tl);
        }

        // 11 sommets qui se lèvent
        const kRow = root.querySelector('[data-evi="peaks"]');
        if (kRow) {
          const pk = kRow.querySelectorAll('.evi__peak');
          gsap.set(pk, { opacity: 0, yPercent: 60 });
          const tl = gsap.timeline({ paused: true })
            .to(pk, { opacity: 1, yPercent: 0, duration: 0.7, ease, stagger: 0.08 });
          on(kRow, tl);
        }

        // Conditions → réponses : le trait se dessine, puis la réponse apparaît
        const links = root.querySelector('[data-evi="links"]');
        if (links) {
          links.querySelectorAll('.evi__link').forEach((li) => {
            const line = li.querySelector('.evi__link-line > span');
            const head = li.querySelector('.evi__link-line > i');
            const c = li.querySelectorAll('.evi__link-n, .evi__link-c');
            const r = li.querySelector('.evi__link-r');
            gsap.set(c, { opacity: 0, x: -16 });
            gsap.set(line, { scaleX: 0, scaleY: 0 });
            gsap.set(r, { opacity: 0, x: 16 });
            gsap.set(head, { opacity: 0 });
            const tl = gsap.timeline({ paused: true })
              .to(c, { opacity: 1, x: 0, duration: 0.6, ease })
              .to(line, { scaleX: 1, scaleY: 1, duration: 0.7, ease: 'power2.inOut' }, 0.25)
              .to(head, { opacity: 1, duration: 0.2 }, 0.85)
              .to(r, { opacity: 1, x: 0, duration: 0.6, ease }, 0.75);
            on(li, tl);
          });
        }
      });
    });
  };
  if (document.readyState === 'complete') init();
  else window.addEventListener('load', init, { once: true });
</script>

<style lang="scss">
  $ink: #111111;
  $layer: #1B1B1A;
  $rock-dark: #2F2D27;
  $rock: #3B3934;
  $rock-light: #52514E;
  $grey: #A4A4A2;
  $snow: #F2F0EB;

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .evi {
    color: $snow;

    p { color: rgba(242, 240, 235, 0.72); }
  }

  // ---------- Composition des études ----------
  .evi__studies {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 96px;
    align-items: start;

    @media (max-width: 1100px) {
      grid-template-columns: 1fr;
      gap: 72px;
    }
  }

  // Seuil
  .evi__lead {
    position: sticky;
    top: 140px;

    @media (max-width: 1100px) {
      position: static;
      display: grid;
      grid-template-columns: minmax(0, 300px) minmax(0, 1fr);
      gap: 48px;
      align-items: center;
    }

    @media (max-width: 640px) {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }

  .evi__ring {
    position: relative;
    width: 100%;
    max-width: 420px;
    aspect-ratio: 1;
    margin-bottom: 40px;

    @media (max-width: 1100px) { margin-bottom: 0; }
    @media (max-width: 640px) { max-width: 300px; }

    svg {
      width: 100%;
      height: 100%;
      transform: rotate(-90deg);
      overflow: visible;
    }
  }

  .evi__ring-track {
    fill: none;
    stroke: $rock-dark;
    stroke-width: 14;
  }

  .evi__ring-fill {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 14;
    stroke-linecap: round;
    stroke-dasharray: 100;
    stroke-dashoffset: 24;
  }

  .evi__ring-value {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    font-family: var(--font-headline);
    font-weight: 700;
    font-size: clamp(64px, 8vw, 120px);
    line-height: 1;
    letter-spacing: -0.03em;
    color: $snow !important;
    font-variant-numeric: tabular-nums;
  }

  .evi__ring-num {
    display: inline-flex;
    align-items: flex-start;
    gap: 0.06em;
    font-variant-numeric: tabular-nums;

    // Deux chiffres réservés : le « % » ne glisse pas pendant le comptage.
    > span:first-child {
      min-width: 2ch;
      text-align: right;
    }
  }

  .evi__ring-unit {
    font-size: 0.4em;
    line-height: 1;
    color: var(--color-accent);
    margin-top: 0.12em;
  }

  .evi__kicker {
    font-size: var(--fs-xs) !important;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-accent) !important;
    margin-bottom: 16px !important;
  }

  .evi__statement {
    font-family: var(--font-headline);
    font-weight: 500;
    font-size: var(--fs-md) !important;
    line-height: 1.3 !important;
    color: $snow !important;
    margin-bottom: 20px !important;
    max-width: 26ch;

    strong { color: var(--color-accent); font-weight: 700; }
  }

  .evi__source {
    display: inline-block;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.5;
    color: $snow;
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
    transition: color 0.3s ease;

    &:hover { color: var(--color-accent); }
  }

  // ---------- Pile de droite ----------
  .evi__stack {
    display: flex;
    flex-direction: column;
  }

  .evi__row {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    gap: 48px;
    align-items: center;
    padding: 48px 0;
    border-top: 1px solid $rock-dark;

    &:first-child { padding-top: 0; border-top: 0; }
    &:last-child { padding-bottom: 0; }

    @media (max-width: 640px) {
      grid-template-columns: 1fr;
      gap: 28px;
      padding: 40px 0;
    }
  }

  .evi__text p:not(.evi__figure):not(.evi__meta) {
    font-size: var(--fs-base);
    line-height: 1.6;
    margin-bottom: 16px;
    max-width: 52ch;
  }

  .evi__figure {
    font-family: var(--font-headline);
    font-weight: 700;
    font-size: var(--fs-lg) !important;
    line-height: 1 !important;
    letter-spacing: -0.02em;
    color: $snow !important;
    margin-bottom: 10px !important;

    @media (max-width: 640px) { font-size: var(--fs-xl) !important; }

    span {
      font-size: 0.5em;
      letter-spacing: 0;
      color: var(--color-accent);

      @media (max-width: 640px) { font-size: 0.42em; }
    }
  }

  .evi__meta {
    font-size: 14px !important;
    font-weight: 600;
    color: $grey !important;
    margin-bottom: 14px !important;
  }

  .evi__visual {
    justify-self: start;
  }

  // 96 carrés, 12 × 8
  .evi__squares {
    display: grid;
    grid-template-columns: repeat(12, 13px);
    gap: 5px;

    @media (max-width: 640px) { grid-template-columns: repeat(12, 12px); gap: 5px; }
  }

  .evi__sq {
    width: 100%;
    aspect-ratio: 1;
    border-radius: 3px;
    background: var(--color-accent);
  }

  // 25 pictogrammes, 5 × 5
  .evi__pictos {
    display: grid;
    grid-template-columns: repeat(5, 32px);
    gap: 10px 12px;
  }

  .evi__picto {
    position: relative;
    display: block;
    width: 32px;
    height: 32px;

    svg {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      fill: $rock;
    }

    .evi__picto-lit { fill: var(--color-accent); }
  }

  // 11 sommets en chaîne
  // 6 + 5 sommets en quinconce, comme une chaîne
  .evi__peaks {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .evi__peaks-row {
    display: flex;
    gap: 5px;

    & + & { padding-left: 20px; }
  }

  .evi__peak {
    width: 36px;
    height: auto;
    overflow: visible;
  }

  .evi__peak-light { fill: $rock-light; }
  .evi__peak-shade { fill: $rock; }
  .evi__peak-snow { fill: $snow; }

  // ---------- Conditions → réponses ----------
  .evi__conditions {
    margin-top: 128px;
    padding-top: 56px;
    border-top: 1px solid $rock-dark;

    @media (max-width: 768px) { margin-top: 88px; }

    ol { list-style: none; }
  }

  .evi__conditions-title {
    font-size: var(--fs-lg);
    line-height: 1.1;
    hyphens: manual;
    text-wrap: balance;
    color: $snow;
    margin-bottom: 48px;

    span { color: var(--color-accent); }
  }

  .evi__link {
    display: grid;
    grid-template-columns: 48px minmax(0, 4fr) minmax(64px, 2fr) minmax(0, 5fr);
    gap: 24px;
    align-items: center;
    padding: 28px 0;
    border-bottom: 1px solid $rock-dark;

    &:first-child { border-top: 1px solid $rock-dark; }

    @media (max-width: 900px) {
      grid-template-columns: 40px minmax(0, 1fr);
      gap: 12px 16px;
      align-items: start;
      padding: 24px 0;
    }
  }

  .evi__link-n {
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: $grey;
    font-variant-numeric: tabular-nums;

    @media (max-width: 900px) { grid-row: span 3; padding-top: 6px; }
  }

  .evi__link-c {
    font-family: var(--font-headline);
    font-weight: 700;
    font-size: var(--fs-md) !important;
    line-height: 1.2 !important;
    color: $snow !important;
    margin: 0 !important;
  }

  .evi__link-line {
    position: relative;
    display: block;
    height: 12px;

    span {
      position: absolute;
      left: 0;
      right: 10px;
      top: 50%;
      border-top: 2px dashed var(--color-accent);
      transform-origin: left center;
    }

    i {
      position: absolute;
      right: 1px;
      top: 50%;
      width: 10px;
      height: 10px;
      margin-top: -5px;
      border-top: 2px solid var(--color-accent);
      border-right: 2px solid var(--color-accent);
      rotate: 45deg;
    }

    @media (max-width: 900px) {
      width: 12px;
      height: 28px;
      margin-left: 4px;

      span {
        left: 50%;
        right: auto;
        top: 0;
        bottom: 8px;
        border-top: 0;
        border-left: 2px dashed var(--color-accent);
        transform-origin: center top;
      }

      i {
        top: auto;
        bottom: 3px;
        right: auto;
        left: 50%;
        margin: 0 0 0 -5px;
        rotate: 135deg;
      }
    }
  }

  .evi__link-r {
    font-size: var(--fs-base) !important;
    line-height: 1.55 !important;
    color: rgba(242, 240, 235, 0.78) !important;
    margin: 0 !important;
  }
</style>
