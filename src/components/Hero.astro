---
import { Image } from 'astro:assets';
import heroMain from '../assets/gallery/cuisine/cuisine-avec-ziaad-29.webp';
import hero2 from '../assets/gallery/locaux/deco-j-co-4.webp';
import hero3 from '../assets/gallery/cuisine/cuisine-avec-ziaad-21.webp';
import hero4 from '../assets/gallery/locaux/deco-j-co-11.webp';
const base = import.meta.env.BASE_URL;
---
<section class="hero">
  <div class="container">
    <div class="hero__grid">
      <div class="hero__content">
        <div class="hero__badge animate-in">
          <span class="dot"></span> Expertise Sociale & Éducative
        </div>
        
        <h1 class="hero__title animate-in">
          <span>L'accompagnement</span><br />
          <span class="serif">éducatif sur mesure.</span>
        </h1>
        
        <p class="hero__description text-large animate-in">
          Nous intervenons à Genève en complément des dispositifs existants, pour co-construire avec les jeunes un avenir qui a du sens.
        </p>
        
        <div class="hero__actions animate-in">
          <a href="#about" class="btn btn--filled">Notre vision</a>
          <a href="#video" class="btn btn--outline">Programme Impulsion</a>
        </div>
        
        <div class="hero__trust animate-in">
          <div class="trust-item">
            <span class="trust-num">10+</span>
            <span class="trust-text">ans d'expérience</span>
          </div>
          <div class="trust-divider"></div>
          <div class="trust-item">
            <span class="trust-num">HES</span>
            <span class="trust-text">Diplômés certifiés</span>
          </div>
        </div>
      </div>
      
      <div class="hero__mosaic">
        <div class="mosaic__grid">
          <div class="mosaic__col mosaic__col--a">
            <div class="mosaic__item mosaic__item--tall">
              <div class="mosaic__image-wrap">
                <Image src={hero2} alt="Espace d'accueil de Jeunesse & Co, baigné de lumière" class="mosaic__img" width={440} height={620} loading="lazy" />
              </div>
            </div>

            <div class="mosaic__item mosaic__item--wide">
              <div class="mosaic__image-wrap">
                <Image src={hero3} alt="Atelier cuisine : préparation d'un repas" class="mosaic__img" width={440} height={330} loading="lazy" />
              </div>
            </div>
          </div>

          <div class="mosaic__col mosaic__col--b">
            <div class="mosaic__item mosaic__item--main">
              <div class="mosaic__image-wrap">
                <Image src={heroMain} alt="Atelier cuisine dans les locaux de Jeunesse & Co" class="mosaic__img" width={620} height={780} loading="eager" fetchpriority="high" />
              </div>
            </div>

            <div class="mosaic__item mosaic__item--small">
              <div class="mosaic__image-wrap">
                <Image src={hero4} alt="Détail de nos espaces : affiches et lampe" class="mosaic__img" width={340} height={380} loading="lazy" />
              </div>
            </div>
          </div>
        </div>

        <div class="mosaic__shapes">
          <div class="mosaic__shape mosaic__shape--1"></div>
        </div>
      </div>
    </div>
  </div>
  
  <div class="hero__gradient"></div>
</section>

<style lang="scss">
  .hero {
    position: relative;
    padding-top: 140px;
    padding-bottom: 80px;
    min-height: 100vh;
    display: flex;
    align-items: center;
    background-color: var(--color-primary);
    overflow: hidden;

    @media (max-width: 1024px) {
      padding-top: 120px;
      padding-bottom: 60px;
      min-height: auto;
    }

    @media (max-width: 768px) {
      padding-top: 100px;
      padding-bottom: 80px;
      min-height: 100svh;

      .container {
        padding-left: 0;
        padding-right: 0;
      }
    }

    &__gradient {
      position: absolute;
      top: 0;
      right: 0;
      width: 60%;
      height: 100%;
      background: radial-gradient(ellipse at 70% 30%, rgba(255, 223, 92, 0.08) 0%, transparent 60%);
      pointer-events: none;
      z-index: 0;
    }

    &__grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 80px;
      align-items: center;
      position: relative;
      z-index: 1;

      @media (max-width: 1200px) {
        gap: 60px;
      }

      @media (max-width: 1024px) {
        grid-template-columns: 1fr;
        gap: 50px;
      }
    }

    &__content {
      @media (max-width: 768px) {
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 0 24px;
      }

      @media (max-width: 1024px) {
        text-align: center;
      }
    }

    &__badge {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 6px 14px;
      background: rgba(255, 223, 92, 0.1);
      border: 1px solid var(--color-accent);
      border-radius: 100px;
      font-size: 12px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 24px;
      color: var(--color-accent);
      opacity: 0;
      transform: translateY(20px);

      .dot {
        width: 6px;
        height: 6px;
        background: var(--color-accent);
        border-radius: 50%;
        animation: pulse 2s ease-in-out infinite;
      }
    }

    &__title {
      font-family: var(--font-headline);
      font-size: clamp(36px, 5vw, 64px);
      line-height: 1.15;
      letter-spacing: -0.025em;
      margin-bottom: 24px;
      font-weight: 700;
      color: var(--color-white);
      opacity: 0;
      transform: translateY(30px);

      // Masques de mots injectés par le script d'animation
      :global(.w-mask) {
        display: inline-block;
        overflow: hidden;
        vertical-align: bottom;
        padding-bottom: 0.08em;
        margin-bottom: -0.08em;
      }

      :global(.w) {
        display: inline-block;
        will-change: transform;
      }
    }

    &__description {
      max-width: 500px;
      margin-bottom: 32px;
      line-height: 1.6;
      color: rgba(255, 255, 255, 0.8);
      opacity: 0;
      transform: translateY(20px);

      @media (max-width: 1024px) {
        margin-left: auto;
        margin-right: auto;
      }
    }

    &__actions {
      display: flex;
      gap: 16px;
      margin-bottom: 48px;
      opacity: 0;
      transform: translateY(20px);

      .btn--outline {
        border: 1px solid rgba(255, 255, 255, 0.3);
        color: var(--color-white);
        &:hover { border-color: var(--color-white); }
      }

      @media (max-width: 1024px) {
        justify-content: center;
      }

      @media (max-width: 480px) {
        flex-direction: column;
        align-items: center;
      }
    }

    &__trust {
      display: flex;
      align-items: center;
      gap: 24px;
      opacity: 0;
      transform: translateY(20px);

      @media (max-width: 1024px) {
        justify-content: center;
      }

      .trust-item { display: flex; flex-direction: column; }
      .trust-num { font-family: var(--font-headline); font-size: 28px; font-weight: 700; color: var(--color-white); }
      .trust-text { font-size: 12px; font-weight: 700; text-transform: uppercase; color: rgba(255, 255, 255, 0.6); letter-spacing: 0.02em; }
      .trust-divider { width: 1px; height: 32px; background: rgba(255, 255, 255, 0.2); }
    }
  }

  // MOSAIC GRID
  .hero__mosaic {
    position: relative;
    height: 560px;

    @media (max-width: 1200px) {
      height: 480px;
    }

    @media (max-width: 1024px) {
      height: 420px;
      width: 100%;
      max-width: 550px;
      margin: 0 auto;
    }

    // Mobile : on garde la photo principale (vraie photo client)
    @media (max-width: 768px) {
      height: 260px;
      max-width: 100%;
      margin-top: 8px;
      padding: 0 24px;
    }
  }

  // Grille éditoriale : deux colonnes décalées, gouttières régulières, zéro chevauchement
  .mosaic__grid {
    position: relative;
    z-index: 2;
    width: 100%;
    height: 100%;
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: 16px;

    @media (max-width: 768px) {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }

  .mosaic__col {
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-height: 0;

    // Décalage vertical : c'est lui qui donne le rythme, pas la superposition
    &--a { padding-top: 48px; }
    &--b { padding-bottom: 48px; }

    @media (max-width: 1024px) {
      &--a { padding-top: 32px; }
      &--b { padding-bottom: 32px; }
    }

    @media (max-width: 768px) {
      &--a { display: none; }
      &--b { padding-bottom: 0; gap: 0; }
    }
  }

  .mosaic__item {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    min-height: 0;
    opacity: 0;
    will-change: transform;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.18);

    @media (max-width: 480px) {
      border-radius: 14px;
    }
  }

  .mosaic__image-wrap {
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: inherit;
  }

  .mosaic__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .mosaic__item:hover .mosaic__img {
    transform: scale(1.08);
  }

  .mosaic__label {
    position: absolute;
    bottom: 16px;
    left: 16px;
    background: var(--color-white);
    padding: 8px 14px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    border-radius: 6px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
    z-index: 2;

    @media (max-width: 480px) {
      padding: 6px 10px;
      font-size: 9px;
      bottom: 12px;
      left: 12px;
    }
  }

  // Proportions des tuiles (flex-grow au sein de leur colonne)
  .mosaic__item--tall { flex: 1.45; }
  .mosaic__item--wide { flex: 1; }

  .mosaic__item--main {
    flex: 1.85;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.22);

    @media (max-width: 768px) {
      flex: 1;
      border-radius: 16px;
    }
  }

  .mosaic__item--small {
    flex: 1;

    @media (max-width: 768px) {
      display: none;
    }
  }

  // Decorative shapes
  .mosaic__shapes {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
  }

  .mosaic__shape {
    position: absolute;
    border-radius: 24px;
    opacity: 0;
    will-change: transform;

    // Carré d'accent jaune, discret, derrière la grille
    &--1 {
      width: 96px;
      height: 96px;
      background: var(--color-accent);
      border-radius: 20px;
      top: 8px;
      right: -28px;

      @media (max-width: 1024px) {
        width: 72px;
        height: 72px;
        right: -12px;
      }

      @media (max-width: 768px) {
        display: none;
      }
    }
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.6; transform: scale(1.2); }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  
  gsap.registerPlugin(ScrollTrigger);
  
  // Safari-compatible initialization
  const initHeroAnimations = () => {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    
    if (prefersReducedMotion) {
      gsap.set(".animate-in, .mosaic__item, .mosaic__shape", { opacity: 1, y: 0, x: 0, scale: 1, rotation: 0 });
      return;
    }

    // Découpe le titre en mots masqués (texte inchangé, wrappers seulement)
    const splitTitleWords = () => {
      document.querySelectorAll('.hero__title > span').forEach((line) => {
        const words = (line.textContent || '').trim().split(/\s+/);
        line.innerHTML = words
          .map((w) => `<span class="w-mask"><span class="w">${w}</span></span>`)
          .join(' ');
      });
    };
    splitTitleWords();

    // Set initial states explicitly for Safari
    gsap.set(".hero__badge", { opacity: 0, y: 20 });
    gsap.set(".hero__title", { opacity: 1, y: 0 });
    gsap.set(".hero__title .w", { yPercent: 115, rotate: 5 });
    gsap.set(".hero__description", { opacity: 0, y: 20 });
    gsap.set(".hero__actions", { opacity: 0, y: 20 });
    gsap.set(".hero__trust", { opacity: 0, y: 20 });
    gsap.set(".mosaic__item", { opacity: 1, clipPath: "inset(100% 0% 0% 0% round 20px)" });
    gsap.set(".mosaic__img", { scale: 1.18 });
    gsap.set(".mosaic__shape", { opacity: 0, scale: 0 });

    const masterTL = gsap.timeline({
      defaults: { ease: "power4.out" }
    });

    // Content animations
    masterTL
      .to(".hero__badge", {
        opacity: 1,
        y: 0,
        duration: 0.8
      })
      .to(".hero__title .w", {
        yPercent: 0,
        rotate: 0,
        duration: 1.1,
        stagger: 0.07
      }, "-=0.5")
      .to(".hero__description", {
        opacity: 1,
        y: 0,
        duration: 0.8
      }, "-=0.9")
      .to(".hero__actions", {
        opacity: 1,
        y: 0,
        duration: 0.8
      }, "-=0.5")
      .to(".hero__trust", {
        opacity: 1,
        y: 0,
        duration: 0.8
      }, "-=0.5");

    // Mosaic animations with stagger
    const mosaicTL = gsap.timeline({
      defaults: { ease: "power3.out" }
    });

    // Shape first
    mosaicTL
      .fromTo(".mosaic__shape--1",
        { scale: 0, rotation: -20, opacity: 0 },
        { scale: 1, rotation: 8, opacity: 0.7, duration: 1.1, ease: "elastic.out(1, 0.7)" }
      );

    // Images : rideau clip-path + settle du zoom (Ken Burns d'entrée)
    const revealItem = (sel: string, dur: number) => {
      const tl = gsap.timeline();
      tl.to(`${sel}`, { clipPath: "inset(0% 0% 0% 0% round 20px)", duration: dur, ease: "power4.inOut" })
        .to(`${sel} .mosaic__img`, { scale: 1, duration: dur + 0.4, ease: "power3.out" }, "<");
      return tl;
    };

    mosaicTL
      .add(revealItem(".mosaic__item--main", 1.1), "-=0.6")
      .add(revealItem(".mosaic__item--tall", 0.9), "-=0.9")
      .add(revealItem(".mosaic__item--wide", 0.9), "-=0.75")
      .add(revealItem(".mosaic__item--small", 0.8), "-=0.7");

    // Start mosaic animation slightly after content
    masterTL.add(mosaicTL, 0.3);

    // Scroll-based parallax (desktop only)
    if (window.innerWidth > 768) {
      // Parallax : les deux colonnes glissent à des vitesses différentes,
      // ce qui garde les gouttières intactes tout en créant de la profondeur.
      gsap.to(".mosaic__col--a", {
        y: -70,
        scrollTrigger: {
          trigger: ".hero",
          start: "top top",
          end: "bottom top",
          scrub: 1.2
        }
      });

      gsap.to(".mosaic__col--b", {
        y: -30,
        scrollTrigger: {
          trigger: ".hero",
          start: "top top",
          end: "bottom top",
          scrub: 0.9
        }
      });

      gsap.to(".mosaic__shape--1", {
        y: -110,
        rotation: 24,
        scrollTrigger: {
          trigger: ".hero",
          start: "top top",
          end: "bottom top",
          scrub: 1.5
        }
      });

      // Content fade out on scroll
      gsap.to(".hero__content", {
        opacity: 0.3,
        y: -30,
        scrollTrigger: {
          trigger: ".hero",
          start: "top top",
          end: "60% top",
          scrub: 1
        }
      });
    }
    
    // Refresh ScrollTrigger for Safari
    ScrollTrigger.refresh();
  };

  // Use DOMContentLoaded with Safari-safe fallback
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeroAnimations);
  } else {
    // DOM already loaded, run immediately
    initHeroAnimations();
  }
</script>
